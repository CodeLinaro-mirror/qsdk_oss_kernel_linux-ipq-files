/dts-v1/;

#include "ipq9679.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. IPQ9679-EMULATION";
	compatible = "qcom,ipq9679-emulation", "qcom,ipq9679";

	/* Timer freq for rumi = timer freq / 200 */
	clocks {
		/* sleep-clk freq for rumi = sleep-clk freq (32000) / 200 */
		sleep_clk: sleep-clk {
			clock-frequency = <160>;
		};

		/* xo freq for rumi = xo freq (24000000) / 200 */
		xo: xo {
			clock-frequency = <120000>;
		};

		cmn_pll_nss_clk_462m: cmn-pll-nss-clk-462m {
			clock-frequency = <462000000>;
		};

		cmn_pll_nss_clk_750m: cmn-pll-nss-clk-750m {
			clock-frequency = <750000000>;
		};

		gcc_gpll0_out_aux: gcc-gpll0-out-aux {
			clock-frequency = <800000000>;
		};
	};

	aliases {
		serial0 = &uart0;
	};

	chosen {
		linux,initrd-end = <0x97000000>;
		linux,initrd-start = <0x95000000>;
		bootargs = "root=/dev/ram0 rw init=/init clk_ignore_unused earlycon";
		stdout-path = "serial0";
	};

	cpus: cpus {
		CPU0: cpu@0 {
			enable-method = "qcom,arm-cortex-acc";
			qcom,acc = <&acc0>;
		};

		CPU1: cpu@100 {
			enable-method = "qcom,arm-cortex-acc";
			qcom,acc = <&acc1>;
		};

		CPU2: cpu@200 {
			enable-method = "qcom,arm-cortex-acc";
			qcom,acc = <&acc2>;
		};

		CPU3: cpu@300 {
			enable-method = "qcom,arm-cortex-acc";
			qcom,acc = <&acc3>;
		};

		CPU4: cpu@400 {
			enable-method = "qcom,arm-cortex-acc";
			qcom,acc = <&acc4>;
		};
	};

	memory@80000000 {
		reg = <0x0 0x80000000 0x0 0x80000000>;
	};

	psci {
		status = "disabled";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		tz@0x8a600000 {
			reg = <0x0 0x8a700000 0x0 0x400000>;
			no-map;
		};
	};

	soc@0 {
		acc0: clock-controller@f800000 {
			compatible = "qcom,arm-cortex-acc";
			reg = <0x0f800000 0x10000>;
		};

		acc1: clock-controller@f810000 {
			compatible = "qcom,arm-cortex-acc";
			reg = <0x0f810000 0x10000>;
		};

		acc2:clock-controller@f820000 {
			compatible = "qcom,arm-cortex-acc";
			reg = <0x0f820000 0x10000>;
		};

		acc3:clock-controller@f830000 {
			compatible = "qcom,arm-cortex-acc";
			reg = <0x0f830000 0x10000>;
		};

		acc4:clock-controller@f840000 {
			compatible = "qcom,arm-cortex-acc";
			reg = <0x0f840000 0x10000>;
		};

		qupv3: geniqup@1ac0000 {
			status = "okay";

			spi0: spi@1a80000 {
				status = "disabled";

				flash@0 {
					compatible = "spansion,s25fs128s1", "jedec,spi-nor";
					#address-cells = <1>;
					#size-cells = <1>;
					reg = <0>;
					spi-max-frequency = <50000000>;
				};
			};

			uart0: serial@1a84000 {
				status = "okay";
			};
		};

		/* Timer freq for rumi = timer freq (24000000) / 200 */
		timer@f420000 {
			clock-frequency = <120000>;
		};
	};

	/* Timer freq for rumi = timer freq (24000000) / 200 */
	timer {
		clock-frequency = <120000>;
	};
};

&gcc {
	gcc-use-dummy;
};

&apps_iommu {
	status = "okay";
};

&sdhc {
	qcom,emulation;
	/* override the frequency to 48Mhz for emulation platform */
	max-frequency = <48000000>;
	/* Force 3.3V, because only that will support on emulation platform */
	mmc-ddr-3_3v;
	/* quirk to disable SDR104, SDR50 modes */
	no-1-8-v;
	bus-width = <4>;
	non-removable;
	status = "okay";
};

&pcie2 {
	qcom,emulation;
	max-link-speed = <1>;
	link_retries_count = <400>;
	phys = <>;
	phy-names = "";

	pcie2_rp {
		reg = <0 0 0 0 0>;

		qcom,mhi@0 {
			reg = <0 0 0 0 0>;
		};
	};
};

&ess_switch {
	switch_mac_mode = <0x15>; /* mac mode for uniphy instance0*/
	switch_mac_mode1 = <0x18>; /* mac mode for uniphy instance1*/
	switch_mac_mode2 = <0x18>; /* mac mode for uniphy instance2*/

	qcom,port_phyinfo {
		port@1 {
			port_id = <1>;
			forced-speed = <2500>;
			forced-duplex = <1>;
		};
		port@2 {
			port_id = <2>;
			forced-speed = <2500>;
			forced-duplex = <1>;
		};
		port@3 {
			port_id = <3>;
			forced-speed = <2500>;
			forced-duplex = <1>;
		};
		port@4 {
			port_id = <4>;
			forced-speed = <2500>;
			forced-duplex = <1>;
		};
		port@5 {
			port_id = <5>;
			forced-speed = <25000>;
			forced-duplex = <1>;
		};
		port@6 {
			port_id = <6>;
			forced-speed = <25000>;
			forced-duplex = <1>;
		};
	};
};
