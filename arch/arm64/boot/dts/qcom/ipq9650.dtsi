					reserved {
						ucast_queue = <0 0>;
						mcast_queue = <0 0>;
						l0sp = <45 63>;
						l0cdrr = <0 0>;
						l0edrr = <0 0>;
						l1cdrr = <45 63>;
						l1edrr = <45 63>;
					};
				};

				port_scheduler_config {
					port@0 {
						port_id = <0>;

						l1scheduler {
							group@0 {
								/* L0 SP */
								sp = <26>;
								sp_loop_pri = <12>;
								sp_max_pri = <1>;
								/* cpri cdrr epri edrr */
								cfg = <0 26 0 26>;
							};

							group@1 {
								/* SSID groups with 4 priorities on L1 */
								sp = <38>;
								sp_loop_pri = <4>;
								sp_max_pri = <4>;
								/* cpri cdrr epri edrr */
								cfg = <0 26 0 26>;
							};

							group@2 {
								sp = <42>;
								sp_loop_pri = <3>;
								sp_max_pri = <1>;
								/* cpri cdrr epri edrr */
								cfg = <0 26 0 26>;
							};
						};

						l0scheduler {
							group@0 {
								/* (5 cores + 4 VPs) + 1 SMD host groups with 8 priorities */
								ucast_queue = <128>;
								ucast_loop_pri = <80>;
								ucast_max_pri = <8>;
								/* multicast queue */
								mcast_queue = <256>;
								mcast_loop_pri = <8>;
								/* sp cpri cdrr epri edrr */
								cfg = <26 0 128 0 128>;
							};

							group@1 {
								/* GRO group */
								ucast_queue = <208>;
								ucast_loop_pri = <8>;
								cfg = <36 0 208 0 208>;
							};

							group@2 {
								/* SMD DS group */
								ucast_queue = <216>;
								ucast_loop_pri = <8>;
								cfg = <37 0 216 0 216>;
							};

							group@3 {
								/* 4 SSID groups with 8 priorities. */
								ucast_queue = <224>;
								ucast_loop_pri = <32>;
								ucast_max_pri = <8>;
								cfg = <38 0 224 0 224>;
							};

							group@4 {
								/* IGSRAM for DDRQ LAN to WAN with 8 priorities. */
								ucast_queue = <216>;
								ucast_loop_pri = <8>;
								ucast_max_pri = <8>;
								cfg = <42 0 216 0 216>;
							};

							group@5 {
								/* IGSRAM for DDRQ WAN to LAN with 8 priorities. */
								ucast_queue = <224>;
								ucast_loop_pri = <8>;
								ucast_max_pri = <8>;
								cfg = <43 0 224 0 224>;
							};

							group@6 {
								/* IGSRAM for DDRQ DS to WAN with 1 priority. */
								ucast_queue = <232>;
								cfg = <44 0 232 0 232>;
							};
						};
					};

					port@1 {
						port_id = <1>;

						l1scheduler {
							group@0 {
								sp = <0>;
								cfg = <0 0 0 0>;
							};
						};

						l0scheduler {
							group@0 {
								ucast_queue = <0>;
								ucast_loop_pri = <8>;
								mcast_queue = <272>;
								mcast_loop_pri = <4>;
								cfg = <0 0 0 0 0>;
							};
						};
					};

					port@2 {
						port_id = <2>;

						l1scheduler {
							group@0 {
								sp = <2>;
								cfg = <0 2 0 2>;
							};
						};

						l0scheduler {
							group@0 {
								ucast_queue = <8>;
								ucast_loop_pri = <8>;
								mcast_queue = <276>;
								mcast_loop_pri = <4>;
								cfg = <2 0 8 0 8>;
							};
						};
					};

					port@3 {
						port_id = <3>;

						l1scheduler {
							group@0 {
								sp = <4>;
								cfg = <0 4 0 4>;
							};
						};

						l0scheduler {
							group@0 {
								ucast_queue = <16>;
								ucast_loop_pri = <8>;
								mcast_queue = <280>;
								mcast_loop_pri = <4>;
								cfg = <4 0 16 0 16>;
							};
						};
					};

					port@4 {
						port_id = <4>;

						l1scheduler {
							group@0 {
								sp = <6>;
								cfg = <0 6 0 6>;
							};
						};

						l0scheduler {
							group@0 {
								ucast_queue = <24>;
								ucast_loop_pri = <8>;
								mcast_queue = <284>;
								mcast_loop_pri = <4>;
								cfg = <6 0 24 0 24>;
							};
						};
					};

					port@5 {
						port_id = <5>;

						l1scheduler {
							group@0 {
								sp = <8>;
								cfg = <0 8 0 8>;
							};
						};

						l0scheduler {
							group@0 {
								ucast_queue = <32>;
								ucast_loop_pri = <8>;
								mcast_queue = <288>;
								mcast_loop_pri = <4>;
								cfg = <8 0 32 0 32>;
							};
						};
					};

					port@6 {
						port_id = <6>;

						l1scheduler {
							group@0 {
								sp = <10>;
								sp_loop_pri = <4>;
								sp_max_pri = <1>;
								cfg = <0 10 0 10>;
							};
						};

						l0scheduler {
							group@0 {
								ucast_queue = <40>;
								ucast_loop_pri = <32>;
								ucast_max_pri = <16>;
								mcast_queue = <292>;
								mcast_loop_pri = <4>;
								cfg = <10 0 40 0 40>;
							};
						};
					};

					port@7 {
						port_id = <7>;

						l1scheduler {
							group@0 {
								sp = <18>;
								cfg = <0 18 0 18>;
							};
						};

						l0scheduler {
							group@0 {
								ucast_queue = <72>;
								ucast_loop_pri = <8>;
								mcast_queue = <296>;
								mcast_loop_pri = <2>;
								cfg = <18 0 72 0 72>;
							};
						};
					};

					port@8 {
						port_id = <8>;

						l1scheduler {
							group@0 {
								sp = <20>;
								sp_loop_pri = <6>;
								sp_max_pri = <1>;
								cfg = <0 20 0 20>;
							};
						};

						l0scheduler {
							group@0 {
								ucast_queue = <80>;
								ucast_loop_pri = <48>;
								ucast_max_pri = <8>;
								mcast_queue = <298>;
								mcast_loop_pri = <2>;
								cfg = <20 0 80 0 80>;
							};
						};
					};
				};
			};
		};

		edma@2ad00000 {
			memory-region = <&ddrq_data_region>, <&ddrq_desc_region>;
			memory-region-names = "ddrq_data_region", "ddrq_desc_region";
			compatible = "qcom,edma";
			reg = <0x2ad00000 0x1c5000>;
			reg-names = "edma-reg-base";
			resets = <&nsscc NSS_CC_PPE_EDMA_CLK_ARES>,
			       <&nsscc NSS_CC_PPE_EDMA_CFG_CLK_ARES>;
			reset-names = "edma_rst",
				"edma_cfg_rst";

			clocks = <&nsscc NSS_CC_NSS_CSR_CLK>,
				<&nsscc NSS_CC_NSSNOC_NSS_CSR_CLK>,
				<&nsscc NSS_CC_PPE_EDMA_CLK>,
				<&gcc GCC_NSSNOC_ATB_CLK>,
				<&gcc GCC_NSS_TS_CLK>,
				<&gcc GCC_NSSNOC_QOSGEN_REF_CLK>,
				<&gcc GCC_NSSNOC_TIMEOUT_REF_CLK>,
				<&gcc GCC_NSSNOC_SNOC_CLK>,
				<&gcc GCC_NSSCFG_CLK>,
				<&gcc GCC_NSSNOC_NSSCC_CLK>,
				<&gcc GCC_NSSCC_CLK>,
				<&gcc GCC_NSSNOC_XO_DCD_CLK>,
				<&gcc GCC_NSSNOC_SNOC_1_CLK>,
				<&gcc GCC_NSSNOC_PCNOC_1_CLK>,
				<&gcc GCC_NSSNOC_MEMNOC_CLK>,
				<&gcc GCC_NSSNOC_MEMNOC_1_CLK>;
			clock-names = "nss-csr-clk", "nss-nssnoc-csr-clk",
				"nss-edma-clk", "nss-nssnoc-atb-clk", "nss-ts-clk",
				"nss-nssnoc-qosgen-ref-clk", "nss-nssnoc-timeout-ref-clk",
				"nss-nssnoc-snoc-clk", "nss-nsscfg-clk", "nss-nssnoc-nsscc-clk",
				"nss-nsscc-clk", "nss-nssnoc-xo-dcd-clk", "nss-nssnoc-snoc-1-clk",
				"nss-nssnoc-pcnoc-1-clk", "nss-nssnoc-memnoc-clk",
				"nss-nssnoc-mem-noc-1-clk";

			qcom,rxdesc-ring-max = <24>;
			qcom,rxfill-ring-max = <20>;
			qcom,txdesc-ring-max = <24>;
			qcom,txcomp-ring-max = <20>;
			qcom,rx-page-mode = <0>;
			qcom,tx-map-priority-level = <1>;
			qcom,rx-map-priority-level = <1>;
			qcom,txdesc-fc-grp-map = <1 2 3 4 5 6>;
			qcom,vp-id = <8>;

			interrupts = <0 294 4>, <0 295 4>, <0 296 4>, <0 297 4>,
				   <0 298 4>, <0 299 4>, <0 300 4>, <0 301 4>,
				   <0 302 4>, <0 303 4>, <0 304 4>, <0 305 4>,
				   <0 306 4>, <0 307 4>, <0 308 4>, <0 309 4>,
				   <0 310 4>, <0 311 4>, <0 312 4>, <0 313 4>,	/* TX Complete ring IRQ info (0 - 19) */

				   <0 250 4>, <0 251 4>, <0 252 4>, <0 253 4>,
				   <0 254 4>, <0 255 4>, <0 256 4>, <0 257 4>,
				   <0 258 4>, <0 259 4>, <0 260 4>, <0 261 4>,
				   <0 262 4>, <0 263 4>, <0 264 4>, <0 265 4>,
				   <0 266 4>, <0 267 4>, <0 268 4>, <0 269 4>,
				   <0 270 4>, <0 271 4>, <0 272 4>, <0 273 4>,	/* RX desc ring IRQ info (0 - 23) */

				   <0 274 4>, <0 275 4>, <0 276 4>, <0 277 4>,
				   <0 278 4>, <0 279 4>, <0 280 4>, <0 281 4>,
				   <0 282 4>, <0 283 4>, <0 284 4>, <0 285 4>,
				   <0 286 4>, <0 287 4>, <0 288 4>, <0 289 4>,
				   <0 290 4>, <0 291 4>, <0 292 4>, <0 293 4>,	/* RX fill ring IRQ info (0 - 19) */

				   <0 314 4>;					/* Misc interrupt */

			interrupt-names = "txcmpl_0", "txcmpl_1", "txcmpl_2", "txcmpl_3",
				   "txcmpl_4", "txcmpl_5", "txcmpl_6", "txcmpl_7",
				   "txcmpl_8", "txcmpl_9", "txcmpl_10", "txcmpl_11",
				   "txcmpl_12", "txcmpl_13", "txcmpl_14", "txcmpl_15",
				   "txcmpl_16", "txcmpl_17", "txcmpl_18", "txcmpl_19",

				   "rxdesc_0", "rxdesc_1", "rxdesc_2", "rxdesc_3",
				   "rxdesc_4", "rxdesc_5", "rxdesc_6", "rxdesc_7",
				   "rxdesc_8", "rxdesc_9", "rxdesc_10", "rxdesc_11",
				   "rxdesc_12", "rxdesc_13", "rxdesc_14", "rxdesc_15",
				   "rxdesc_16", "rxdesc_17", "rxdesc_18", "rxdesc_19",
				   "rxdesc_20", "rxdesc_21", "rxdesc_22", "rxdesc_23",

				   "rxfill_0", "rxfill_1", "rxfill_2", "rxfill_3",
				   "rxfill_4", "rxfill_5", "rxfill_6", "rxfill_7",
				   "rxfill_8", "rxfill_9", "rxfill_10", "rxfill_11",
				   "rxfill_12", "rxfill_13", "rxfill_14", "rxfill_15",
				   "rxfill_16", "rxfill_17", "rxfill_18", "rxfill_19",

				   "misc_err";

		};

		nss-ppe {
			compatible = "qcom,nss-ppe";
		};

		eip: eip197@29800000 {
			compatible = "qcom,eip";
			reg-names = "eip_pbase";
			reg = <0x29800000 0x7ffff>;
			reg-offset = <0x80000>;
			ranges;
			#address-cells = <1>;
			#size-cells = <1>;
			clocks = <&nsscc NSS_CC_EIP_CLK>,
			       <&nsscc NSS_CC_NSSNOC_EIP_CLK>,
			       <&nsscc NSS_CC_EIP_PPE_CLK>;
			clock-names = "crypto_clk","crypto_nocclk","crypto_ppeclk";
			clock-frequency = /bits/ 64 <800000000 800000000 462000000>;
			resets = <&nsscc NSS_CC_EIP_PPE_CLK_ARES>, <&nsscc NSS_CC_EIP_CLK_ARES>, <&nsscc NSS_CC_NSSNOC_EIP_CLK_ARES>;
			reset-names = "eip_ppe_clk", "eip_clk", "eip_host_clk";
			qcom,inline-enabled;
			qcom,outer-offload;
			qcom,inner-offload;
			interrupts = <GIC_SPI 229 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "global_irq";
			max-ring = /bits/ 8 <8>;
			status = "okay";

			dma0 {
				compatible = "qcom,eip-dma";
				ring-id = /bits/ 8 <0>;
				interrupts = <GIC_SPI 234 IRQ_TYPE_EDGE_RISING>,
					   <GIC_SPI 346 IRQ_TYPE_EDGE_RISING>;
				interrupt-names = "cdr_proc_irq","rdr_proc_irq";
			};

			dma1 {
				compatible = "qcom,eip-dma";
				ring-id = /bits/ 8 <1>;
				interrupts = <GIC_SPI 235 IRQ_TYPE_EDGE_RISING>,
					   <GIC_SPI 347 IRQ_TYPE_EDGE_RISING>;
				interrupt-names = "cdr_proc_irq","rdr_proc_irq";
			};

			dma2 {
				compatible = "qcom,eip-dma";
				ring-id = /bits/ 8 <2>;
				interrupts = <GIC_SPI 236 IRQ_TYPE_EDGE_RISING>,
					   <GIC_SPI 348 IRQ_TYPE_EDGE_RISING>;
				interrupt-names = "cdr_proc_irq","rdr_proc_irq";
			};

			dma3 {
				compatible = "qcom,eip-dma";
				ring-id = /bits/ 8 <3>;
				interrupts = <GIC_SPI 237 IRQ_TYPE_EDGE_RISING>,
					   <GIC_SPI 349 IRQ_TYPE_EDGE_RISING>;
				interrupt-names = "cdr_proc_irq","rdr_proc_irq";
			};

			dma4 {
				compatible = "qcom,eip-dma";
				ring-id = /bits/ 8 <4>;
				interrupts = <GIC_SPI 238 IRQ_TYPE_EDGE_RISING>,
					   <GIC_SPI 350 IRQ_TYPE_EDGE_RISING>;
				interrupt-names = "cdr_proc_irq","rdr_proc_irq";
			};

			dma5 {
				compatible = "qcom,eip-dma";
				ring-id = /bits/ 8 <5>;
				interrupts = <GIC_SPI 239 IRQ_TYPE_EDGE_RISING>,
					   <GIC_SPI 351 IRQ_TYPE_EDGE_RISING>;
				interrupt-names = "cdr_proc_irq","rdr_proc_irq";
			};

			dma6 {
				compatible = "qcom,eip-dma";
				ring-id = /bits/ 8 <6>;
				interrupts = <GIC_SPI 240 IRQ_TYPE_EDGE_RISING>,
					   <GIC_SPI 352 IRQ_TYPE_EDGE_RISING>;
				interrupt-names = "cdr_proc_irq","rdr_proc_irq";
			};

			dma7 {
				compatible = "qcom,eip-dma";
				ring-id = /bits/ 8 <7>;
				interrupts = <GIC_SPI 241 IRQ_TYPE_EDGE_RISING>,
					   <GIC_SPI 353 IRQ_TYPE_EDGE_RISING>;
				interrupt-names = "cdr_proc_irq","rdr_proc_irq";
			};
		};

		eip_crypto: eip_crypto {
			compatible = "qcom,eip_crypto";
			status = "okay";
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 12 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>;
	};

	qcom,test@0 {
		compatible = "qcom,testmhi";
		qcom,wlan-ramdump-dynamic = <0x600000>;
	};

	qcom,smp2p-cdsp {
		compatible = "qcom,smp2p";
		qcom,smem = <94>, <432>;
		interrupt-parent = <&ipcc>;
		interrupts = <IPCC_MPROC_NSP IPCC_MPROC_SIGNAL_SMP2P
			      IRQ_TYPE_EDGE_RISING>;
		mboxes = <&ipcc IPCC_MPROC_NSP IPCC_MPROC_SIGNAL_SMP2P>;
		qcom,local-pid = <0>;
		qcom,remote-pid = <5>;

		cdsp_smp2p_out: master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <1>;
		};

		cdsp_smp2p_in: slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <2>;
		};
	};

	thermal_zones: thermal-zones {
		cpu0-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&tsens 11>;

			trips {
				cpu-critical {
					temperature = <115000>;
					hysteresis = <9000>;
					type = "critical";
				};

				cpu0_thermal_alert: cpu-passive {
					temperature = <100000>;
					hysteresis = <9000>;
					type = "passive";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu0_thermal_alert>;
					cooling-device = <&CPU0 3 3>,
							 <&CPU1 3 3>,
							 <&CPU2 3 3>,
							 <&CPU3 3 3>,
							 <&CPU4 2 2>;
				};
			};
		};

		cpu1-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&tsens 12>;

			trips {
				cpu-critical {
					temperature = <115000>;
					hysteresis = <9000>;
					type = "critical";
				};

				cpu-passive {
					temperature = <100000>;
					hysteresis = <9000>;
					type = "passive";
				};
			};
		};

		cpu2-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&tsens 13>;

			trips {
				cpu-critical {
					temperature = <115000>;
					hysteresis = <9000>;
					type = "critical";
				};

				cpu-passive {
					temperature = <100000>;
					hysteresis = <9000>;
					type = "passive";
				};
			};
		};

		cpu3-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&tsens 14>;

			trips {
				cpu-critical {
					temperature = <115000>;
					hysteresis = <9000>;
					type = "critical";
				};

				cpu-passive {
					temperature = <100000>;
					hysteresis = <9000>;
					type = "passive";
				};
			};
		};

		cpu4-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&tsens 9>;

			trips {
				cpu-critical {
					temperature = <115000>;
					hysteresis = <9000>;
					type = "critical";
				};

				cpu-passive {
					temperature = <100000>;
					hysteresis = <9000>;
					type = "passive";
				};
			};
		};

		cpu4-1-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&tsens 10>;

			trips {
				cpu-critical {
					temperature = <115000>;
					hysteresis = <9000>;
					type = "critical";
				};

				cpu-passive {
					temperature = <100000>;
					hysteresis = <9000>;
					type = "passive";
				};
			};
		};

		turing-vxu-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&tsens 5>;

			trips {
				turing_vxu-critical {
					temperature = <120000>;
					hysteresis = <9000>;
					type = "critical";
				};
			};
		};

		turing-mxu-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&tsens 6>;

			trips {
				turing_mxu-critical {
					temperature = <120000>;
					hysteresis = <9000>;
					type = "critical";
				};
			};
		};

		noc-ss-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&tsens 7>;

			trips {
				noc_ss-critical {
					temperature = <120000>;
					hysteresis = <9000>;
					type = "critical";
				};
			};
		};

		nss-top-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&tsens 15>;

			trips {
