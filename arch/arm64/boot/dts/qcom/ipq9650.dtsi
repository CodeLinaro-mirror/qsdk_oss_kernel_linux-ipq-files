#include <dt-bindings/clock/qcom,ipq9650-cmn-pll.h>
#include <dt-bindings/clock/qcom,apss-ipq.h>
#include <dt-bindings/clock/qcom,ipq9650-gcc.h>
#include <dt-bindings/clock/qcom,ipq9650-nsscc.h>
#include <dt-bindings/reset/qcom,ipq9650-gcc.h>
#include <dt-bindings/reset/qcom,ipq9650-nsscc.h>
#include <dt-bindings/interconnect/qcom,ipq9650.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/mailbox/qcom-ipcc.h>
#include <dt-bindings/mailbox/qcom-ipcc-ipq9650.h>

/ {
	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&intc>;

	clocks {
		pcie30_phy0_pipe_clk: pcie30_phy0_pipe_clk {
			compatible = "fixed-clock";
			clock-frequency = <250000000>;
			#clock-cells = <0>;
		};

		pcie30_phy1_pipe_clk: pcie30_phy1_pipe_clk {
			compatible = "fixed-clock";
			clock-frequency = <250000000>;
			#clock-cells = <0>;
		};

		pcie30_phy2_pipe_clk: pcie30_phy2_pipe_clk {
			compatible = "fixed-clock";
			clock-frequency = <250000000>;
			#clock-cells = <0>;
		};

		pcie30_phy3_pipe_clk: pcie30_phy3_pipe_clk {
			compatible = "fixed-clock";
			clock-frequency = <250000000>;
			#clock-cells = <0>;
		};

		pcie30_phy4_pipe_clk: pcie30_phy4_pipe_clk {
			compatible = "fixed-clock";
			clock-frequency = <250000000>;
			#clock-cells = <0>;
		};

		sleep_clk: sleep-clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
		};

		usb_pcie_wrapper_pipe_clk: usb-pcie-wrapper-pipe-clk {
			compatible = "fixed-clock";
			clock-frequency = <125000000>;
			#clock-cells = <0>;
		};

		cmn_pll_nss_clk_462m: cmn-pll-nss-clk-462m {
			compatible = "fixed-clock";
			clock-frequency = <462000000>;
			#clock-cells = <0>;
		};

		xo: xo {
			compatible = "fixed-clock";
			#clock-cells = <0>;
		};

		gcc_gpll0_out_aux: gcc-gpll0-out-aux {
			compatible = "fixed-clock";
			clock-frequency = <800000000>;
			#clock-cells = <0>;
		};

		ref_48mhz_clk: ref-48mhz-clk {
			compatible = "fixed-factor-clock";
			clocks = <&xo_clk>;
			#clock-cells = <0>;
		};

		xo_clk: xo-clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
		};
	};

	cpus: cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		CPU0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x0>;
			enable-method = "psci";
			next-level-cache = <&L2_0>;
			cpu-idle-states = <&little_cpu_sleep_0>;
			clocks = <&apss_clk APSS_SILVER_CORE_CLK>;
			clock-names = "cpu";
			operating-points-v2 = <&cpu0_opp_table>;
			interconnects = <&apss_clk MASTER_CPU_SILVER &apss_clk SLAVE_L3>;
			#cooling-cells = <2>;
			L2_0: l2-cache {
				compatible = "cache";
				cache-level = <2>;
				cache-unified;
				next-level-cache = <&L3_0>;
				L3_0: l3-cache {
					compatible = "cache";
					cache-level = <3>;
					cache-unified;
				};
			};
		};

		CPU1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x100>;
			enable-method = "psci";
			next-level-cache = <&L2_100>;
			cpu-idle-states = <&little_cpu_sleep_0>;
			clocks = <&apss_clk APSS_SILVER_CORE_CLK>;
			clock-names = "cpu";
			operating-points-v2 = <&cpu0_opp_table>;
			interconnects = <&apss_clk MASTER_CPU_SILVER &apss_clk SLAVE_L3>;
			#cooling-cells = <2>;
			L2_100: l2-cache {
				compatible = "cache";
				cache-level = <2>;
				cache-unified;
				next-level-cache = <&L3_0>;
			};
		};

		CPU2: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x200>;
			enable-method = "psci";
			next-level-cache = <&L2_200>;
			cpu-idle-states = <&little_cpu_sleep_0>;
			clocks = <&apss_clk APSS_SILVER_CORE_CLK>;
			clock-names = "cpu";
			operating-points-v2 = <&cpu0_opp_table>;
			interconnects = <&apss_clk MASTER_CPU_SILVER &apss_clk SLAVE_L3>;
			#cooling-cells = <2>;
			L2_200: l2-cache {
				compatible = "cache";
				cache-level = <2>;
				cache-unified;
				next-level-cache = <&L3_0>;
			};
		};

		CPU3: cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x300>;
			enable-method = "psci";
			next-level-cache = <&L2_300>;
			cpu-idle-states = <&little_cpu_sleep_0>;
			clocks = <&apss_clk APSS_SILVER_CORE_CLK>;
			clock-names = "cpu";
			operating-points-v2 = <&cpu0_opp_table>;
			interconnects = <&apss_clk MASTER_CPU_SILVER &apss_clk SLAVE_L3>;
			#cooling-cells = <2>;
			L2_300: l2-cache {
				compatible = "cache";
				cache-level = <2>;
				cache-unified;
				next-level-cache = <&L3_0>;
			};
		};

		CPU4: cpu@400 {
			device_type = "cpu";
			compatible = "arm,cortex-a78";
			reg = <0x400>;
			enable-method = "psci";
			next-level-cache = <&L2_400>;
			cpu-idle-states = <&big_cpu_sleep_0>;
			clocks = <&apss_clk APSS_GOLD_CORE_CLK>;
			clock-names = "cpu";
			operating-points-v2 = <&cpu4_opp_table>;
			interconnects = <&apss_clk MASTER_CPU_GOLD &apss_clk SLAVE_L3>;
			#cooling-cells = <2>;
			L2_400: l2-cache {
				compatible = "cache";
				cache-level = <2>;
				cache-unified;
				next-level-cache = <&L3_0>;
			};
		};

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&CPU0>;
				};

				core1 {
					cpu = <&CPU1>;
				};

				core2 {
					cpu = <&CPU2>;
				};

				core3 {
					cpu = <&CPU3>;
				};

				core4 {
					cpu = <&CPU4>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			little_cpu_sleep_0: silver-c3 { /* C3 */
				compatible = "arm,idle-state";
				idle-state-name = "little-power-down";
				arm,psci-suspend-param = <0x40000003>;
				entry-latency-us = <549>;
				exit-latency-us = <901>;
				min-residency-us = <1774>;
				local-timer-stop;
				status = "disabled";
			};

			big_cpu_sleep_0: gold-c3 { /* C3 */
				compatible = "arm,idle-state";
				idle-state-name = "big-power-down";
				arm,psci-suspend-param = <0x40000003>;
				entry-latency-us = <523>;
				exit-latency-us = <1244>;
				min-residency-us = <2207>;
				local-timer-stop;
				status = "disabled";
			};

		};
	};

	cpu0_opp_table: opp-table-cpu0 {
		compatible = "operating-points-v2-kryo-cpu";
		opp-shared;
		nvmem-cells = <&apss_cpu0_freq>;
		nvmem-cell-names = "cpu0_freq";

		/* Listed all supported CPU frequencies and opp-supported-hw
		 * values to select CPU frequencies based on the PLL LValue.
		 * ------------------------------------------------------------
		 * Frequency     1.3GHz	   1.9GHz(no limit)	opp-supported-hw
		 * ------------------------------------------------------------
		 * 840000000	   1	      1			0x3
		 * 1368000000      1	      1			0x3
		 * 1944000000      0	      1			0x1
		 * -----------------------------------------------------------
		 */

		opp-840000000 {
			opp-hz = /bits/ 64 <840000000>;
			opp-supported-hw = <0x3>;
			/* <target min max> */
			opp-microvolt = <735000 735000 960000>;
			clock-latency-ns = <200000>;
			opp-peak-kBps = <720000>;
		};

		opp-1368000000 {
			opp-hz = /bits/ 64 <1368000000>;
			opp-supported-hw = <0x3>;
			/* <target min max> */
			opp-microvolt = <815000 735000 960000>;
			clock-latency-ns = <200000>;
			opp-peak-kBps = <1176000>;
		};

		opp-1800000000 {
			opp-hz = /bits/ 64 <1800000000>;
			opp-supported-hw = <0x3>;
			/* <target min max> */
			opp-microvolt = <960000 735000 960000>;
			clock-latency-ns = <200000>;
			opp-peak-kBps = <1488000>;
		};

		opp-1944000000 {
			opp-hz = /bits/ 64 <1944000000>;
			opp-supported-hw = <0x1>;
			/* <target min max> */
			opp-microvolt = <960000 735000 960000>;
			clock-latency-ns = <200000>;
			opp-peak-kBps = <1488000>;
		};
	};

	cpu4_opp_table: opp-table-cpu4 {
		compatible = "operating-points-v2-kryo-cpu";
		opp-shared;
		nvmem-cells = <&apss_cpu4_freq>;
		nvmem-cell-names = "cpu4_freq";

		/* Listed all supported CPU frequencies and opp-supported-hw
		 * values to select CPU frequencies based on the PLL LValue.
		 * ------------------------------------------------------------
		 * Frequency     0.720GHz    1.0GHz(no limit)	opp-supported-hw
		 * ------------------------------------------------------------
		 * 456000000	   1	      1			0x3
		 * 720000000       1	      1			0x3
		 * 1032000000      0	      1			0x1
		 * -----------------------------------------------------------
		 */

		opp-456000000 {
			opp-hz = /bits/ 64 <456000000>;
			opp-supported-hw = <0x3>;
			/* <target min max> */
			opp-microvolt = <735000 735000 960000>;
			clock-latency-ns = <200000>;
			opp-peak-kBps = <720000>;
		};

		opp-720000000 {
			opp-hz = /bits/ 64 <720000000>;
			opp-supported-hw = <0x3>;
			/* <target min max> */
			opp-microvolt = <815000 735000 960000>;
			clock-latency-ns = <200000>;
			opp-peak-kBps = <1176000>;
		};

		opp-1032000000 {
			opp-hz = /bits/ 64 <1032000000>;
			opp-supported-hw = <0x3>;
			/* <target min max> */
			opp-microvolt = <960000 735000 960000>;
			clock-latency-ns = <200000>;
			opp-peak-kBps = <1488000>;
		};
	};

	ctx-save {
		compatible = "qti,ctxt-save-ipq9650";
		memory-region = <&minidump_mem>;
		qcom,imem = <&imem>;
		minidump-level = <2>;
	};

	firmware {
		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
		};

		scm {
			compatible = "qcom,scm-ipq9650", "qcom,scm";
			qcom,dload-mode = <&tcsr 0x240fc>;
		};
	};

	tmel-log {
		compatible = "qcom,tmel-log-ipq9650";
	};

	qcom,ipq-debug {
		compatible = "qcom,ipq-debug-ipq9650";
		qcom,tcsr-reset-reasons = <&tcsr 0x2f00c>;
	};

	memory@80000000 {
		device_type = "memory";
		/* We expect the bootloader to fill in the size */
		reg = <0x0 0x80000000 0x0 0x0 >;
	};

	pmu-a55 {
		compatible = "arm,cortex-a55-pmu";
		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_LOW>;
	};

	pmu-a78 {
		compatible = "arm,cortex-a78-pmu";
		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_LOW>;
	};

	pmu-dsu {
		compatible = "arm,dsu-pmu";
		interrupts = <GIC_SPI 50 IRQ_TYPE_EDGE_RISING>;
		cpus = <&CPU0>, <&CPU1>, <&CPU2>, <&CPU3>, <&CPU4>;
		status = "disabled";
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
		reset-types {
			mode-edl = <0 0x1>;
		};
	};

	qti,tfa-optee-log {
		compatible = "qti,tfa-optee-log";
		interrupts = <GIC_SPI 56 IRQ_TYPE_EDGE_RISING>;
		tfa-diag-info =<&tfa_diag_buf>;
		optee-diag-info =<&optee_diag_buf>;
	};

	qseecom: qseecom {
		compatible = "ipq9650-qseecom";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		system_cma: linux,cma {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x0 0x00000000 0x0 0xffffffff>;
			reusable;
			alignment = <0x0 0x400000>;
			size = <0x0 0x4000000>;
			linux,cma-default;
		};

		bootloader@8a100000 {
			reg = <0x0 0x8a100000 0x0 0x400000>;
			no-map;
		};

		smem@8a500000 {
			compatible = "qcom,smem";
			reg = <0x0 0x8a500000 0x0 0x40000>;
			no-map;

			hwlocks = <&tcsr_mutex 3>;
		};

		tfa@8a600000 {
			reg = <0x0 0x8a600000 0x0 0x80000>;
			no-map;
		};

		optee@8a680000 {
			reg = <0x0 0x8a680000 0x0 0x280000>;
			no-map;
		};

		prime_mem: prime-region@8a900000  {
			reg = <0x0 0x8a900000  0x0 0x100000>;
			no-map;
		};

		q6_cdsp_dtb_mem: q6-cdsp-dtb-region@8aa00000 {
			reg = <0x0 0x8aa00000 0x0 0x80000>;
			no-map;
		};

		cdsp_mem: cdsp-region@8ab00000 {
			reg = <0x0 0x8ab00000 0x0 0x2000000>;
			no-map;
		};

		tmc_etr_region: tmc_etr_dump@0 {
			no-map;
			status = "disabled";
		};

		minidump_mem: minidump_mem@0 {
			no-map;
		};

		/*
		 * DDRQ data region details
		 */
		ddrq_data_region: ddrq_data_region@0 {
			compatible = "shared-dma-pool";
			no-map;
			size = <0x0 0x01000000>;	/* 16MB */
		};

		/*
		 * DDRQ descriptor memory details
		 */
		ddrq_desc_region: ddrq_desc_region@0 {
			compatible = "shared-dma-pool";
			no-map;
			size = <0x0 0x00100000>;	/* 1MB */
		};

		uio_firmware: uio_firmware@0 {
			compatible = "qcom,debug-uio-firmware";
			size = <0x0 0x2000>;
			no-map;
		};

		uio_host: uio_host@0 {
			compatible = "qcom,debug-uio-host";
			size = <0x0 0x2000>;
			no-map;
		};

		uio_nss: uio_nss@0 {
			compatible = "qcom,debug-uio-nss";
			size = <0x0 0x2000>;
			no-map;
		};
	};

	license_manager: license_manager {
		compatible = "qti,license-manager-service";
		tmel-bounded;
		ep-tmel-bounded;
		status="okay";
	};

	sysregister {
		compatible = "qcom,sysregister";
		reg-names = "bootcount", "force_inactive";
		reg-access-type = "syscon", "syscon";
		reg-phandle = <&imem>, <&imem>;
		reg-offset = <0xC8>, <0xCC>;
		reg-bit-position = <0xffffffff>, <0xffffffff>;
	};

	soc@0 {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0 0 0 0xffffffff>;
		dma-ranges;

		qfprom {
			compatible = "qcom,qfprom-ipq9650-sec";
			version-commit-enable = <0x1>;
		};

		eud@78000 {
			compatible = "qcom,sc7280-eud","qcom,eud";
			reg = <0x00078000 0x2000>,
			      <0x0007a000 0x1000>;
			interrupts = <GIC_SPI 415 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&gcc GCC_USB0_PHY_CFG_AHB_CLK>;
			clock-names = "eud_ahb2phy_clk";
			status = "disabled";
		};

		tsens: thermal-sensor@4a9000 {
			compatible = "qcom,ipq9650-tsens";
			reg = <0x4a9000 0x1000>,
			      <0x4a8000 0x1000>;
			nvmem-cells = <&tsens_mode>, <&tsens_base0>, <&tsens_base1>,
				      <&s5>, <&s6>, <&s7>, <&s8>, <&s9>, <&s10>, <&s11>,
				      <&s12>, <&s13>, <&s14>, <&s15>;
			nvmem-cell-names = "mode", "base0", "base1", "s5", "s6",
					   "s7", "s8", "s9", "s10", "s11",
					   "s12", "s13", "s14", "s15";
			interrupts = <GIC_SPI 105 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "combined";
			#thermal-sensor-cells = <1>;
			status = "okay";
		};

		cdsp_power: cdsp-power@4AE000 {
			compatible = "qcom,cdsp-power";
			reg = <0x004AE000 0x1000>,
			      <0x26018018 0x4>;
			reg-names = "mpm", "rscc";

			interrupts-extended = <&intc GIC_SPI 65 IRQ_TYPE_EDGE_RISING>,
					      <&ipcc IPCC_MPROC_NSP IPCC_MPROC_SIGNAL_PING
					      IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "lpm", "dcvs";

			mboxes = <&ipcc IPCC_MPROC_NSP IPCC_MPROC_SIGNAL_PING>;

			qcom,smem-item = <503>;

			regulators {
				cdsp_vdd_cx: cdsp-vdd-cx {
					regulator-name = "cdsp-vdd-cx";
				};

				cdsp_vdd_mx: cdsp-vdd-mx {
					regulator-name = "cdsp-vdd-mx";
				};
			};
		};

		efuse@a4000 {
			compatible = "qcom,qfprom";
			reg = <0xA4000 0x739>;
			#address-cells = <1>;
			#size-cells = <1>;

			s5: s5@426 {
				reg = <0x426 0x1>;
				bits = <4 4>;
			};

			s6: s6@428 {
				reg = <0x428 0x1>;
				bits = <0 4>;
			};

			s7: s7@428 {
				reg = <0x428 0x1>;
				bits = <4 4>;
			};

			s8: s8@3e4 {
				reg = <0x3e4 0x1>;
				bits = <0 4>;
			};

			s9: s9@3e4 {
				reg = <0x3e4 0x1>;
				bits = <4 4>;
			};

			s10: s10@3e5 {
				reg = <0x3e5 0x1>;
				bits = <0 4>;
			};

			s11: s11@3e5 {
				reg = <0x3e5 0x1>;
				bits = <4 4>;
			};

			s12: s12@3e6 {
				reg = <0x3e6 0x1>;
				bits = <0 4>;
			};

			s13: s13@3e6 {
				reg = <0x3e6 0x1>;
				bits = <4 4>;
			};

			s14: s14@3ed {
				reg = <0x3ed 0x2>;
				bits = <7 4>;
			};

			s15: s15@3ee {
				reg = <0x3ee 0x1>;
				bits = <3 4>;
			};

			tsens_mode: mode@421 {
				reg  = <0x421 0x1>;
				bits = <0 3>;
			};

			tsens_base0: base0@421 {
				reg  = <0x421 0x2>;
				bits = <3 10>;
			};

			tsens_base1: base1@422 {
				reg  = <0x422 0x2>;
				bits = <5 10>;
			};
		};

		softsku@a6000 {
			compatible = "qcom,qfprom";
			reg = <0xA6000 0x1000>;
			#address-cells = <1>;
			#size-cells = <1>;

			apss_cpu0_freq: apss_cpu0_freq@234 {
				reg = <0x234 0x1>;
				bits = <0 8>;
			};

			apss_cpu4_freq: apss_cpu4_freq@294 {
				reg = <0x294 0x1>;
				bits = <0 8>;
			};
		};

		pcie0_phy: phy@84000 {
			compatible = "qcom,ipq9650-qmp-gen3x1-pcie-phy";
			reg = <0x00084000 0x1c0>; /* Serdes PLL */
			#address-cells = <1>;
			#size-cells = <1>;
			ranges;

			clocks = <&gcc GCC_PCIE0_AUX_CLK>,
				 <&gcc GCC_PCIE0_AHB_CLK>,
				 <&gcc GCC_ANOC_PCIE0_1LANE_M_CLK>,
				 <&gcc GCC_ANOC_PCIE0_1LANE_S_CLK>;
			clock-names = "aux", "cfg_ahb", "anoc_lane", "snoc_lane";

			assigned-clocks = <&gcc GCC_PCIE0_AUX_CLK>,
					  <&gcc GCC_PCIE0_AHB_CLK>,
					  <&gcc GCC_ANOC_PCIE0_1LANE_M_CLK>,
					  <&gcc GCC_ANOC_PCIE0_1LANE_S_CLK>;
			assigned-clock-rates = <20000000>,
					       <100000000>,
					       <200000000>,
					       <200000000>;

			resets = <&gcc GCC_PCIE0_PHY_BCR>,
				 <&gcc GCC_PCIE0PHY_PHY_BCR>;
			reset-names = "phy", "common";

			status = "disabled";

			pcie0_lanes: phy@84200 {
				reg = <0x00084200 0x170>, /* Serdes Tx0 */
				      <0x00084400 0x200>, /* Serdes Rx0 */
				      <0x00084600 0x1f0>, /* PCS: Lane0, COM, PCIE */
				      <0x00084a00 0x0f4>; /* pcs_misc */

				#phy-cells = <0>;

				clocks = <&gcc GCC_PCIE0_PIPE_CLK>;
				clock-names = "pipe0";
				clock-output-names = "gcc_pcie0_pipe_clk_src";
				#clock-cells = <0>;
			};
		};

		pcie4_phy: phy@8c000 {
			compatible = "qcom,ipq9650-qmp-gen3x1-pcie-phy";
			reg = <0x0008c000 0x1c0>; /* Serdes PLL */
			#address-cells = <1>;
			#size-cells = <1>;
			ranges;

			clocks = <&gcc GCC_PCIE4_AUX_CLK>,
				 <&gcc GCC_PCIE4_AHB_CLK>,
				 <&gcc GCC_ANOC_PCIE4_1LANE_M_CLK>,
				 <&gcc GCC_ANOC_PCIE4_1LANE_S_CLK>;
			clock-names = "aux", "cfg_ahb", "anoc_lane", "snoc_lane";

			assigned-clocks = <&gcc GCC_PCIE4_AUX_CLK>,
					  <&gcc GCC_PCIE4_AHB_CLK>,
					  <&gcc GCC_ANOC_PCIE4_1LANE_M_CLK>,
					  <&gcc GCC_ANOC_PCIE4_1LANE_S_CLK>;
			assigned-clock-rates = <20000000>,
					       <100000000>,
					       <200000000>,
					       <200000000>;

			resets = <&gcc GCC_PCIE4_PHY_BCR>,
				 <&gcc GCC_PCIE4PHY_PHY_BCR>;
			reset-names = "phy", "common";

			status = "disabled";

			pcie4_lanes: phy@8c200 {
				reg = <0x0008c200 0x170>, /* Serdes Tx0 */
				      <0x0008c400 0x200>, /* Serdes Rx0 */
				      <0x0008c600 0x1f0>, /* PCS: Lane0, COM, PCIE */
				      <0x0008ca00 0x0f4>; /* pcs_misc */

				#phy-cells = <0>;

				clocks = <&gcc GCC_PCIE4_PIPE_CLK>;
				clock-names = "pipe0";
				clock-output-names = "gcc_pcie4_pipe_clk_src";
				#clock-cells = <0>;
			};
		};

		mdio: mdio@90000 {
			compatible = "qcom,qca-mdio", "qcom,ipq9650-mdio";
			pinctrl-0 = <&mdio_mst_state &mdio_slv_state>;
			pinctrl-names = "default";
			reg = <0x90000 0x64>;
			clocks = <&gcc GCC_MDIO_AHB_CLK>;
			clock-names = "gcc_mdio_ahb_clk";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		cmn_pll: clock-controller@9b000 {
			compatible = "qcom,ipq9650-cmn-pll";
			reg = <0x0009b000 0x800>;
			clocks = <&ref_48mhz_clk>,
				 <&gcc GCC_CMN_12GPLL_AHB_CLK>,
				 <&gcc GCC_CMN_12GPLL_SYS_CLK>;
			clock-names = "ref", "ahb", "sys";
			#clock-cells = <1>;
			assigned-clocks = <&cmn_pll IPQ9650_CMN_PLL_CLK>;
			assigned-clock-rates-u64 = /bits/ 64 <12000000000>;
			status = "okay";
		};

		pcie3_phy: phy@b4000 {
			compatible = "qcom,ipq9650-qmp-gen3x2-pcie-phy";
			reg = <0x000b4000 0x1c0>; /* Serdes PLL */
			#address-cells = <1>;
			#size-cells = <1>;
			ranges;

			clocks = <&gcc GCC_PCIE3_AUX_CLK>,
				 <&gcc GCC_PCIE3_AHB_CLK>,
				 <&gcc GCC_ANOC_PCIE3_2LANE_M_CLK>,
				 <&gcc GCC_ANOC_PCIE3_2LANE_S_CLK>;
			clock-names = "aux", "cfg_ahb", "anoc_lane", "snoc_lane";

			assigned-clocks = <&gcc GCC_PCIE3_AUX_CLK>,
					  <&gcc GCC_PCIE3_AHB_CLK>,
					  <&gcc GCC_ANOC_PCIE3_2LANE_M_CLK>,
					  <&gcc GCC_ANOC_PCIE3_2LANE_S_CLK>;
			assigned-clock-rates = <20000000>,
					       <100000000>,
					       <266666666>,
					       <200000000>;

			resets = <&gcc GCC_PCIE3_PHY_BCR>,
				 <&gcc GCC_PCIE3PHY_PHY_BCR>;
			reset-names = "phy", "common";

			status = "disabled";

			pcie3_lanes: phy@b4200 {
				reg = <0x000b4200 0x170>, /* Serdes Tx0 */
				      <0x000b4400 0x200>, /* Serdes Rx0 */
				      <0x000b4a00 0x1f0>, /* PCS: Lane0, COM, PCIE */
				      <0x000b4600 0x170>, /* Serdes Tx1 */
				      <0x000b4800 0x200>, /* Serdes Rx1 */
				      <0x000b4e00 0x0f4>; /* pcs_misc */

				#phy-cells = <0>;

				clocks = <&gcc GCC_PCIE3_PIPE_CLK>;
				clock-names = "pipe0";
				clock-output-names = "gcc_pcie3_pipe_clk_src";
				#clock-cells = <0>;
			};
		};

		pcie1_phy: phy@f4000 {
			compatible = "qcom,ipq9650-qmp-gen3x2-pcie-phy";
			reg = <0x000f4000 0x1c0>; /* Serdes PLL */
			#address-cells = <1>;
			#size-cells = <1>;
			ranges;

			clocks = <&gcc GCC_PCIE1_AUX_CLK>,
				 <&gcc GCC_PCIE1_AHB_CLK>,
				 <&gcc GCC_ANOC_PCIE1_2LANE_M_CLK>,
				 <&gcc GCC_ANOC_PCIE1_2LANE_S_CLK>;
			clock-names = "aux", "cfg_ahb", "anoc_lane", "snoc_lane";

			assigned-clocks = <&gcc GCC_PCIE1_AUX_CLK>,
					  <&gcc GCC_PCIE1_AHB_CLK>,
					  <&gcc GCC_ANOC_PCIE1_2LANE_M_CLK>,
					  <&gcc GCC_ANOC_PCIE1_2LANE_S_CLK>;
			assigned-clock-rates = <20000000>,
					       <100000000>,
					       <266666666>,
					       <200000000>;

			resets = <&gcc GCC_PCIE1_PHY_BCR>,
				 <&gcc GCC_PCIE1PHY_PHY_BCR>;
			reset-names = "phy", "common";

			status = "disabled";

			pcie1_lanes: phy@f4200 {
				reg = <0x000f4200 0x170>, /* Serdes Tx0 */
				      <0x000f4400 0x200>, /* Serdes Rx0 */
				      <0x000f4a00 0x1f0>, /* PCS: Lane0, COM, PCIE */
				      <0x000f4600 0x170>, /* Serdes Tx1 */
				      <0x000f4800 0x200>, /* Serdes Rx1 */
				      <0x000f4e00 0x0f4>; /* pcs_misc */

				#phy-cells = <0>;

				clocks = <&gcc GCC_PCIE1_PIPE_CLK>;
				clock-names = "pipe0";
				clock-output-names = "gcc_pcie1_pipe_clk_src";
				#clock-cells = <0>;
			};
		};

		pcie2_phy: phy@fc000 {
			compatible = "qcom,ipq9650-qmp-gen3x2-pcie-phy";
			reg = <0x000fc000 0x1c0>; /* Serdes PLL PCIE_2_CFG_QSERDES_PLL_QSERDES_PLL_G3X2_QMP_PLL */
			#address-cells = <1>;
			#size-cells = <1>;
			ranges;

			clocks = <&gcc GCC_PCIE2_AUX_CLK>,
				 <&gcc GCC_PCIE2_AHB_CLK>,
				 <&gcc GCC_ANOC_PCIE2_2LANE_M_CLK>,
				 <&gcc GCC_ANOC_PCIE2_2LANE_S_CLK>;
			clock-names = "aux", "cfg_ahb", "anoc_lane", "snoc_lane";

			assigned-clocks = <&gcc GCC_PCIE2_AUX_CLK>,
					  <&gcc GCC_PCIE2_AHB_CLK>,
					  <&gcc GCC_ANOC_PCIE2_2LANE_M_CLK>,
					  <&gcc GCC_ANOC_PCIE2_2LANE_S_CLK>;
			assigned-clock-rates = <20000000>,
					       <100000000>,
					       <266666666>,
					       <200000000>;

			resets = <&gcc GCC_PCIE2_PHY_BCR>,
				 <&gcc GCC_PCIE2PHY_PHY_BCR>;
			reset-names = "phy", "common";

			status = "disabled";

			pcie2_lanes: phy@fc200 {
				reg = <0x000fc200 0x170>, /* Serdes Tx0 */
				      <0x000fc400 0x200>, /* Serdes Rx0 */
				      <0x000fca00 0x1f0>, /* PCS: Lane0, COM, PCIE */
				      <0x000fc600 0x170>, /* Serdes Tx1 */
				      <0x000fc800 0x200>, /* Serdes Rx1 */
				      <0x000fce00 0x0f4>; /* pcs_misc */

				#phy-cells = <0>;

				clocks = <&gcc GCC_PCIE2_PIPE_CLK>;
				clock-names = "pipe0";
				clock-output-names = "gcc_pcie2_pipe_clk_src";
				#clock-cells = <0>;
			};
		};

		apss_clk: apss-clock@fa80000 {
			compatible = "qcom,apss-ipq9650-clk";
			reg = <0x0fa80000 0x30000>;
			clocks = <&xo>, <&gcc GPLL0>;
			clock-names = "xo", "gpll0";
			#clock-cells = <1>;
			#interconnect-cells = <1>;
			status = "okay";
		};

		tlmm: pinctrl@1000000 {
			compatible = "qcom,ipq9650-tlmm";
			reg = <0x01000000 0x300000>;
			interrupts = <GIC_SPI 84 IRQ_TYPE_LEVEL_HIGH>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&tlmm 0 0 54>;
			interrupt-controller;
			#interrupt-cells = <2>;

			mdio_slv_state: mdio-slv-state {
				mdc_slv {
					pins = "gpio20";
					function = "mdc_slv0";
					drive-strength = <8>;
					bias-disable;
				};

				mdio_slv {
					pins = "gpio21";
					function = "mdio_slv0";
					drive-strength = <8>;
					bias-pull-up;
				};
			};

			mdio_mst_state: mdio-mst-state {
				mdc_mst {
					pins = "gpio22";
					function = "mdc_mst";
					drive-strength = <8>;
					bias-pull-up;
				};

				mdio_mst {
					pins = "gpio23";
					function = "mdio_mst";
					drive-strength = <8>;
					bias-pull-up;
				};
			};

			qup_uart0_default: qup-uart0-default-state {
				qup_uart0_tx: tx-pins {
					pins = "gpio13";
					function = "qup_se1_l2";
					drive-strength = <8>;
					bias-pull-down;
				};

				qup_uart0_rx: rx-pins {
					pins = "gpio12";
					function = "qup_se1_l3";
					drive-strength = <8>;
					bias-pull-down;
				};

				qup_uart0_rfr: rfr-pins {
					pins = "gpio10";
					function = "qup_se1_l1";
					drive-strength = <8>;
					bias-pull-down;
				};

				qup_uart0_cts: cts-pins {
					pins = "gpio11";
					function = "qup_se1_l0";
					drive-strength = <8>;
					bias-pull-down;
				};
			};

			qspi_default_state: qspi-default-state {
				qspi_clk {
					pins = "gpio5";
					function = "qspi_clk";
					drive-strength = <8>;
					bias-disable;
				};

				qspi_cs {
					pins = "gpio4";
					function = "qspi_cs_n";
					drive-strength = <8>;
					bias-pull-up;
				};

				qspi_data {
					pins = "gpio0", "gpio1", "gpio2", "gpio3";
					function = "qspi_data";
					drive-strength = <8>;
					bias-pull-up;
				};
			};

			pps_state: pps-state {
				pps-pins {
					pins = "gpio50";
					function = "tsn";
					drive-strength = <8>;
					bias-pull-down;
				};
			};
		};

		gcc: clock-controller@1800000 {
			compatible = "qcom,ipq9650-gcc";
			reg = <0x01800000 0x40000>;

			clocks = <&xo>,
				 <&sleep_clk>,
				 <&pcie30_phy0_pipe_clk>,
				 <&pcie30_phy1_pipe_clk>,
				 <&pcie30_phy2_pipe_clk>,
				 <&pcie30_phy3_pipe_clk>,
				 <&pcie30_phy4_pipe_clk>,
				 <&usb_pcie_wrapper_pipe_clk>,
				 <&cmn_pll_nss_clk_462m>;
			#clock-cells = <1>;
			#reset-cells = <1>;
			#power-domain-cells = <1>;
		};

		tcsr_mutex: hwlock@1917000 {
			compatible = "qcom,tcsr-mutex";
			reg = <0x01917000 0x20000>;
			#hwlock-cells = <1>;
		};

		tcsr: syscon@1938004 {
			compatible = "qcom,tcsr-ipq9650", "syscon", "simple-mfd";
			reg = <0x01938004 0x35ffc>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0x0 0x01938004 0x35ffc>;

			 pwm: pwm@a010 {
				compatible = "qcom,ipq9574-pwm";
				reg = <0x900c 0x30>;
				clocks = <&gcc GCC_ADSS_PWM_CLK>;
				assigned-clocks = <&gcc GCC_ADSS_PWM_CLK>;
				assigned-clock-rates = <100000000>;
				pwm-npwm = <0x6>;
				#pwm-cells = <2>;
				status = "disabled";
			};
		};

		qupv3: geniqup@1ac0000 {
			compatible = "qcom,geni-se-qup";
			reg = <0x01ac0000 0x2000>;
			clocks = <&gcc GCC_QUPV3_AHB_MST_CLK>,
				 <&gcc GCC_QUPV3_AHB_SLV_CLK>;
			clock-names = "m-ahb", "s-ahb";
			ranges;
			#address-cells = <1>;
			#size-cells = <1>;

			status = "disabled";

			spi0: spi@1a80000 {
				compatible = "qcom,geni-spi";
				reg = <0x01a80000 0x4000>;
				clocks = <&gcc GCC_QUPV3_WRAP_SE0_CLK>;
				clock-names = "se";
				interrupts = <GIC_SPI 339 IRQ_TYPE_LEVEL_HIGH>;
				assigned-clocks = <&gcc GCC_QUPV3_WRAP_SE0_CLK>;
				assigned-clock-rates = <50000000>;
				/* Use common SE TX FIFO depth configuration */
				qup-tx-fifo-depth = <0x20>;
				status = "disabled";
			};

			uart0: serial@1a84000 {
				compatible = "qcom,geni-uart";
				reg = <0x01a84000 0x4000>;
				clocks = <&gcc GCC_QUPV3_WRAP_SE1_CLK>;
				clock-names = "se";
				interrupts = <GIC_SPI 340 IRQ_TYPE_LEVEL_HIGH>;
				status = "disabled";
			};

			i2c0: i2c@1a84000 {
				compatible = "qcom,geni-i2c";
				reg = <0x1a84000 0x4000>;
				clocks = <&gcc GCC_QUPV3_WRAP_SE1_CLK>;
				clock-names = "se";
				clock-frequency = <400000>;
				interrupts = <GIC_SPI 340 IRQ_TYPE_LEVEL_HIGH>;
				assigned-clocks = <&gcc GCC_QUPV3_WRAP_SE1_CLK>;
				assigned-clock-rates = <32000000>;
				status = "disabled";
			};

			i2c1: i2c@1a88000 {
				compatible = "qcom,geni-i2c";
				reg = <0x1a88000 0x4000>;
				clocks = <&gcc GCC_QUPV3_WRAP_SE2_CLK>;
				clock-names = "se";
				clock-frequency = <400000>;
				interrupts = <GIC_SPI 341 IRQ_TYPE_LEVEL_HIGH>;
				assigned-clocks = <&gcc GCC_QUPV3_WRAP_SE2_CLK>;
				assigned-clock-rates = <32000000>;
				status = "disabled";
			};

			i2c2: i2c@1a8c000 {
				compatible = "qcom,geni-i2c";
				reg = <0x1a8c000 0x4000>;
				clocks = <&gcc GCC_QUPV3_WRAP_SE3_CLK>;
				clock-names = "se";
				clock-frequency = <400000>;
				interrupts = <GIC_SPI 342 IRQ_TYPE_LEVEL_HIGH>;
				assigned-clocks = <&gcc GCC_QUPV3_WRAP_SE3_CLK>;
				assigned-clock-rates = <32000000>;
				status = "disabled";
			};

			i2c3: i2c@1a90000 {
				compatible = "qcom,geni-i2c";
				reg = <0x1a90000 0x4000>;
				clocks = <&gcc GCC_QUPV3_WRAP_SE4_CLK>;
				clock-names = "se";
				clock-frequency = <400000>;
				interrupts = <GIC_SPI 343 IRQ_TYPE_LEVEL_HIGH>;
				assigned-clocks = <&gcc GCC_QUPV3_WRAP_SE4_CLK>;
				assigned-clock-rates = <32000000>;
				status = "disabled";
			};

			uart1: serial@1a98000 {
				compatible = "qcom,geni-debug-uart";
				reg = <0x01a98000 0x4000>;
				clocks = <&gcc GCC_QUPV3_WRAP_SE6_CLK>;
				clock-names = "se";
				interrupts = <GIC_SPI 380 IRQ_TYPE_LEVEL_HIGH>;
				status = "disabled";
			};

			i2c4: i2c@1a9c000 {
				compatible = "qcom,geni-i2c";
				reg = <0x1a9c000 0x4000>;
				clocks = <&gcc GCC_QUPV3_WRAP_SE7_CLK>;
				clock-names = "se";
				clock-frequency = <400000>;
				interrupts = <GIC_SPI 381 IRQ_TYPE_LEVEL_HIGH>;
				assigned-clocks = <&gcc GCC_QUPV3_WRAP_SE7_CLK>;
				assigned-clock-rates = <32000000>;
				status = "disabled";
			};

		};

		ipcc: mailbox@1b03000 {
			compatible = "qcom,ipq9650-ipcc", "qcom,ipcc";
			reg = <0x01b03000 0x1000>;
			interrupts = <GIC_SPI 445 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-controller;
			#interrupt-cells = <3>;
			#mbox-cells = <2>;
		};

		system-cache-controller@4000000 {
			compatible = "qcom,ipq9650-llcc";
			reg = <0x04000000 0x200000>, <0x04000000 0x200000>;
			reg-names = "llcc_base", "llcc_broadcast_base";
			interrupts = <GIC_SPI 68 IRQ_TYPE_LEVEL_HIGH>;

			llcc-perfmon {
				compatible = "qcom,llcc-perfmon";
			};
		};

		stm: stm@6002000 {
			compatible = "arm,coresight-stm", "arm,primecell";
			reg = <0x06002000 0x1000>,
				<0x09000000 0x1000000>;
			reg-names = "stm-base", "stm-stimulus-base";
			coresight-name = "coresight-stm";
			clocks = <&gcc GCC_QDSS_DAP_CLK>,
				 <&gcc GCC_QDSS_AT_CLK>;
			clock-names = "apb_pclk", "atclk";

			out-ports {
				port {
					stm_out: endpoint {
						remote-endpoint = <&funnel0_in7>;
					};
				};
			};
		};

		funnel_in0: funnel@6041000 {
			compatible = "arm,coresight-dynamic-funnel", "arm,primecell";
			reg = <0x06041000 0x1000>;
			reg-names = "funnel-base";
			coresight-name = "coresight-funnel-in0";
			clocks = <&gcc GCC_QDSS_DAP_CLK>,
				 <&gcc GCC_QDSS_AT_CLK>;
			clock-names = "apb_pclk", "atclk";

			in-ports {
				#address-cells = <1>;
				#size-cells = <0>;

				/*
				 * Port 0 - TME
				 * Port 2 - SNOC
				 * Port 3 - NSS
				 * Port 4 - CNOC
				 * Port 6 - TPDA QDSS
				 * Port 7 - STM_SS
				 */

				port@7 {
					reg = <7>;
					funnel0_in7: endpoint {
						remote-endpoint = <&stm_out>;
					};
				};
			};

			out-ports {
				port {
					funnel0_out: endpoint {
						remote-endpoint = <&merge_funnel_in0>;
					};
				};
			};
		};

		funnel_in1: funnel@6042000 {
			compatible = "arm,coresight-dynamic-funnel", "arm,primecell";
			reg = <0x06042000 0x1000>;
			reg-names = "funnel-base";
			coresight-name = "coresight-funnel-in1";
			clocks = <&gcc GCC_QDSS_DAP_CLK>,
				 <&gcc GCC_QDSS_AT_CLK>;
			clock-names = "apb_pclk", "atclk";

			in-ports {
				#address-cells = <1>;
				#size-cells = <0>;

				/*
				 * Port 0 - AGGRENOC
				 * Port 1 & 2 - DDRSS
				 * Port 3 - TPDA QDSS
				 * Port 4 - APSS
				 * Port 5 - TURING
				 */

				port@4 {
					reg = <4>;
					funnel1_in2: endpoint {
						remote-endpoint = <&apss_funnel_out>;
					};
				};
			};

			out-ports {
				port {
					funnel1_out: endpoint {
						remote-endpoint = <&merge_funnel_in1>;
					};
				};
			};

		};

		funnel_merge: funnel@6045000 {
			compatible = "arm,coresight-dynamic-funnel", "arm,primecell";
			reg = <0x06045000 0x1000>;
			reg-names = "funnel-base";
			coresight-name = "coresight-funnel-merge";
			clocks = <&gcc GCC_QDSS_DAP_CLK>,
				 <&gcc GCC_QDSS_AT_CLK>;
			clock-names = "apb_pclk", "atclk";

			out-ports {
				port {
					merge_funnel_out: endpoint {
						remote-endpoint = <&etf_in>;
					};
				};
			};

			in-ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					merge_funnel_in0: endpoint {
						remote-endpoint = <&funnel0_out>;
					};
				};

				port@1 {
					reg = <1>;
					merge_funnel_in1: endpoint {
						remote-endpoint = <&funnel1_out>;
					};
				};
			};

		};

		etr_replicator: replicator@6046000 {
			compatible = "arm,coresight-dynamic-replicator", "arm,primecell";
			reg = <0x06046000 0x1000>;
			reg-names = "replicator-base";
			coresight-name = "coresight-replicator";
			clocks = <&gcc GCC_QDSS_DAP_CLK>,
				 <&gcc GCC_QDSS_AT_CLK>;
			clock-names = "apb_pclk", "atclk";

			out-ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					etr_replicator_out0: endpoint {
						remote-endpoint = <&etr_in>;
					};
				};
			};

			in-ports {
				port {
					etr_replicator_in0: endpoint {
						remote-endpoint = <&etf_out>;
					};
				};
			};
		};

		etf@6047000 {
			compatible = "arm,coresight-tmc", "arm,primecell";
			reg = <0x06047000 0x1000>;
			reg-names = "tmc-base";
			coresight-name = "coresight-tmc-etf";
			arm,default-sink;
			clocks = <&gcc GCC_QDSS_DAP_CLK>;
			clock-names = "apb_pclk";

			out-ports {
				port {
					etf_out: endpoint {
						remote-endpoint = <&etr_replicator_in0>;
					};
				};
			};

			in-ports {
				port {
					etf_in: endpoint {
						remote-endpoint = <&merge_funnel_out>;
					};
				};
			};
		};

		tmc_etr: tmc@6048000 {
			compatible = "arm,coresight-tmc", "arm,primecell";
			reg = <0x06048000 0x1000>;
			reg-names = "tmc-base";
			interrupts = <GIC_SPI 403 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "byte-cntr-irq";
			arm,buffer-size = <0x100000>;
			arm,scatter-gather;
			memory-region = <&tmc_etr_region>;
			coresight-name = "coresight-tmc-etr";
			clocks = <&gcc GCC_QDSS_DAP_CLK>;
			clock-names = "apb_pclk";

			in-ports {
				port {
					etr_in: endpoint {
						remote-endpoint = <&etr_replicator_out0>;
					};
				};
			};
		};

		dcc@60ff000 {
			compatible = "qcom,dcc-v2-ipq5332";
			reg = <0x060ff000 0x1000>,
			      <0x06088000 0x1000>;
			reg-names = "dcc-base", "dcc-ram-base";
			dcc-ram-offset = <0x8000>;
			status = "disabled";
		};

		etm0: etm@6880000 {
			compatible = "arm,coresight-etm4x", "arm,primecell";
			reg = <0x06880000 0x1000>;
			coresight-name = "coresight-etm0";
			cpu = <&CPU0>;
			clocks = <&gcc GCC_QDSS_DAP_CLK>;
			clock-names = "apb_pclk";

			out-ports {
				port {
					etm0_out: endpoint {
						remote-endpoint = <&apss_funnel_in0>;
					};
				};
			};
		};

		etm1: etm@6980000 {
			compatible = "arm,coresight-etm4x", "arm,primecell";
			reg = <0x06980000 0x1000>;
			coresight-name = "coresight-etm1";
			cpu = <&CPU1>;
			clocks = <&gcc GCC_QDSS_DAP_CLK>;
			clock-names = "apb_pclk";

			out-ports {
				port {
					etm1_out: endpoint {
						remote-endpoint = <&apss_funnel_in1>;
					};
				};
			};
		};

		etm2: etm@6a80000 {
			compatible = "arm,coresight-etm4x", "arm,primecell";
			reg = <0x06a80000 0x1000>;
			coresight-name = "coresight-etm2";
			cpu = <&CPU2>;
			clocks = <&gcc GCC_QDSS_DAP_CLK>;
			clock-names = "apb_pclk";

			out-ports {
				port {
					etm2_out: endpoint {
						remote-endpoint = <&apss_funnel_in2>;
					};
				};
			};
		};

		etm3: etm@6b80000 {
			compatible = "arm,coresight-etm4x", "arm,primecell";
			reg = <0x06b80000 0x1000>;
			coresight-name = "coresight-etm3";
			cpu = <&CPU3>;
			clocks = <&gcc GCC_QDSS_DAP_CLK>;
			clock-names = "apb_pclk";

			out-ports {
				port {
					etm3_out: endpoint {
						remote-endpoint = <&apss_funnel_in3>;
					};
				};
			};
		};

		etm4: etm@6c80000 {
			compatible = "arm,coresight-etm4x", "arm,primecell";
			reg = <0x6c80000 0x1000>;
			coresight-name = "coresight-etm4";
			cpu = <&CPU4>;
			clocks = <&gcc GCC_QDSS_DAP_CLK>;
			clock-names = "apb_pclk";

			out-ports {
				port {
					etm4_out: endpoint {
						remote-endpoint = <&apss_funnel_in4>;
					};
				};
			};
		};

		funnel_apss: funnel@6c81000 {
			compatible = "arm,coresight-dynamic-funnel", "arm,primecell";
			reg = <0x06c81000 0x1000>;
			reg-names = "funnel-base";
			coresight-name = "coresight-funnel-apss";
			clocks = <&gcc GCC_QDSS_DAP_CLK>,
				 <&gcc GCC_QDSS_AT_CLK>;
			clock-names = "apb_pclk", "atclk";

			out-ports {
				port {
					apss_funnel_out: endpoint {
						remote-endpoint = <&funnel1_in2>;
					};
				};
			};

			in-ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					apss_funnel_in0: endpoint {
						remote-endpoint = <&etm0_out>;
					};
				};

				port@1 {
					reg = <1>;
					apss_funnel_in1: endpoint {
						remote-endpoint = <&etm1_out>;
					};
				};

				port@2 {
					reg = <2>;
					apss_funnel_in2: endpoint {
						remote-endpoint = <&etm2_out>;
					};
				};

				port@3 {
					reg = <3>;
					apss_funnel_in3: endpoint {
						remote-endpoint = <&etm3_out>;
					};
				};

				port@4 {
					reg = <4>;
					apss_funnel_in4: endpoint {
						remote-endpoint = <&etm4_out>;
					};
				};
			};
		};

		sdhc: mmc@7804000 {
			compatible = "qcom,ipq9650-sdhci", "qcom,sdhci-msm-v5";
			reg = <0x07804000 0x1000>,
			      <0x07805000 0x1000>,
			      <0x07808000 0x2000>;
			reg-names = "hc", "cqhci", "ice";

			interrupts = <GIC_SPI 116 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 119 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "hc_irq", "pwr_irq";

			clocks = <&gcc GCC_SDCC1_AHB_CLK>,
				 <&gcc GCC_SDCC1_APPS_CLK>,
				 <&xo>,
				 <&gcc GCC_SDCC1_ICE_CORE_CLK>;
			clock-names = "iface", "core", "xo", "ice";
			assigned-clocks = <&gcc GCC_SDCC1_ICE_CORE_CLK>;
			assigned-clock-rates = <300000000>;
			supports-cqe;

			status = "disabled";
		};

		imem: sram@8600000 {
			compatible = "qcom,ipq9650-imem", "qcom,imem", "syscon";
			reg = <0x08600000 0x1000>;
			ranges = <0 0x08600000 0x1000>;

			#address-cells = <1>;
			#size-cells = <1>;

			/*
			 * First 4 bytes contains the Diag buffer address
			 * Second 4 bytes contains the Diag buffer size
			 */
			tfa_diag_buf: tfa-diag-buf@720 {
				reg = <0x720 8>;
			};

			/*
			 * First 4 bytes contains the Diag buffer address
			 * Second 4 bytes contains the Diag buffer size
			 */
			optee_diag_buf: optee-diag-buf@730 {
				reg = <0x730 8>;
			};

			tz-reason-buf@7a4 {
				compatible = "qcom,ipq9650-imem-tz-reason";
				reg = <0x7a4 4>;
			};

			tme-reason-buf@7a8 {
				compatible = "qcom,ipq9650-imem-tme-reason";
				reg = <0x7a8 4>;
			};

			kernel-reason-buf@7ac {
				compatible = "qcom,ipq9650-imem-kernel-reason";
				reg = <0x7ac 4>;
			};

		};

		qpic_bam: dma-controller@7984000 {
			compatible = "qcom,bam-v1.7.0";
			reg = <0x7984000 0x1c000>;
			interrupts = <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&gcc GCC_QPIC_AHB_CLK>;
			clock-names = "bam_clk";
			#dma-cells = <1>;
			qcom,ee = <0>;
			qcom,bam-lite;
			status = "disabled";
		};

		qpic_nand: nand@79b0000 {
			compatible = "qcom,ipq9650-nand";
			reg = <0x79b0000 0x10000>;
			#address-cells = <1>;
			#size-cells = <0>;
			clocks = <&gcc GCC_QPIC_CLK>,
				 <&gcc GCC_QPIC_AHB_CLK>,
				 <&gcc GCC_QPIC_IO_MACRO_CLK>;
			clock-names = "core", "aon", "io_macro";

			dmas = <&qpic_bam 0>,
			       <&qpic_bam 1>,
			       <&qpic_bam 2>,
			       <&qpic_bam 3>;
			dma-names = "tx", "rx", "cmd", "sts";

			qcom,io_macro_max_clk = <320000000>;
			qcom,io_macro_clk_rates = <24000000 100000000 200000000 \
						   320000000>;

			pinctrl-0 = <&qspi_default_state>;
			pinctrl-names = "default";

			status = "disabled";
			nandcs@0 {
				reg = <0>;
				#address-cells = <1>;
				#size-cells = <1>;

				nand-ecc-strength = <8>;
				nand-ecc-step-size = <512>;
				nand-bus-width = <8>;
			};
		};

		intc: interrupt-controller@f200000 {
			compatible = "arm,gic-v3";
			reg = <0x0f200000 0x10000>, /* GICD */
			      <0x0f240000 0xa0000>; /* GICR * 5 regions */
			#interrupt-cells = <0x3>;
			interrupt-controller;
			#redistributor-regions = <1>;
			redistributor-stride = <0x0 0x20000>;
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
			mbi-ranges = <800 160>;
			msi-controller;
		};

		apcs_glb: mailbox@f400004 {
			compatible = "qcom,ipq9650-apcs-global";
			reg = <0x0f400004 0x6000>;
			#clock-cells = <1>;
			#mbox-cells = <1>;
		};

		qmp_tmel: qmp-tmel@22090000 {
			compatible = "qti,tmel-qmp-mbox";
			reg = <0x22090000 0x20>,
				<0x22091000 0x20>;
			reg-names = "mcore", "ucore";
			interrupts = <GIC_SPI 126 IRQ_TYPE_EDGE_RISING>;
			max_pkt_size = <0x18>;
			mboxes = <&apcs_glb 20>;
			qti,early-boot;
			#mbox-cells = <1>;
			status = "disabled";
		};

		seccrypt: qcom,seccrypt {
			compatible = "qcom,seccrypt";
			status = "okay";
		};

		tmelcom: qcom,tmelcom-qmp-client {
			compatible = "qcom,tmelcom-qmp-client";
			mboxes = <&qmp_tmel 0>;
			status = "disabled";
		};

		watchdog: watchdog@f410000 {
			compatible = "qcom,apss-wdt-ipq9650", "qcom,kpss-wdt";
			reg = <0x0f410000 0x1000>;
			interrupts = <GIC_SPI 0 IRQ_TYPE_EDGE_RISING>;
			clocks = <&sleep_clk>;
			timeout-sec = <30>;
		};

		qusb_phy_1: phy@71000 {
			compatible = "qcom,ipq9650-usb-hs-phy";
			reg = <0x071000 0x114>;
			#phy-cells = <0>;

			clocks = <&gcc GCC_USB1_PHY_CFG_AHB_CLK>,
				<&xo>;
			clock-names = "cfg_ahb", "ref";

			resets = <&gcc GCC_QUSB2_1_PHY_BCR>;
			status = "disabled";
		};

		usb2: usb2@1e00000 {
			compatible = "qcom,ipq9650-dwc3", "qcom,dwc3";
			reg = <0x1ef8800 0x400>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges;

			clocks = <&gcc GCC_USB1_MASTER_CLK>,
				 <&gcc GCC_USB1_SLEEP_CLK>,
				 <&gcc GCC_USB1_MOCK_UTMI_CLK>,
				 <&gcc GCC_SNOC_USB_CLK>,
				 <&gcc GCC_USB1_PHY_CFG_AHB_CLK>;

			clock-names = "master",
				      "sleep",
				      "mock_utmi",
				      "snoc_usb_clk",
				      "cfg_ahb_clk";

			assigned-clocks = <&gcc GCC_USB1_MASTER_CLK>,
					  <&gcc GCC_USB1_MOCK_UTMI_CLK>;
			assigned-clock-rates = <200000000>,
					       <60000000>;

			resets = <&gcc GCC_USB1_BCR>;
			qcom,select-utmi-as-pipe-clk;
			status = "disabled";

			dwc_1: dwc3@1e00000 {
				compatible = "snps,dwc3";
				reg = <0x1e00000 0xe000>;
				clocks = <&gcc GCC_USB1_MOCK_UTMI_CLK>;
				clock-names = "ref";
				interrupts = <GIC_SPI 383 IRQ_TYPE_LEVEL_HIGH>;
				phys = <&qusb_phy_1>;
				phy-names = "usb2-phy";
				tx-fifo-resize;
				snps,is-utmi-l1-suspend;
				snps,hird-threshold = /bits/ 8 <0x0>;
				snps,dis_u2_susphy_quirk;
				snps,dis_u3_susphy_quirk;
				maximum-speed = "high-speed";
				dr_mode = "host";
			};
		};

		qusb_phy_0: phy@7b000 {
			compatible = "qcom,ipq9650-usb-hs-phy";
			reg = <0x07b000 0x114>;
			#phy-cells = <0>;

			clocks = <&gcc GCC_USB0_PHY_CFG_AHB_CLK>,
				<&xo>;
			clock-names = "cfg_ahb", "ref";

			resets = <&gcc GCC_QUSB2_0_PHY_BCR>;
			status = "disabled";
		};

		ssphy_0: phy@7d000 {
			compatible = "qcom,ipq9650-qmp-usb3-phy";
			reg = <0x0007d000 0x1000>;

			clocks = <&gcc GCC_USB0_AUX_CLK>,
				 <&xo>,
				 <&gcc GCC_USB0_PHY_CFG_AHB_CLK>,
				 <&gcc GCC_USB0_PIPE_CLK>;
			clock-names = "aux",
				      "ref",
				      "cfg_ahb",
				      "pipe";
			clock-output-names = "usb0_pipe_clk";
			#clock-cells = <0>;
			#phy-cells = <0>;

			resets = <&gcc GCC_USB0_PHY_BCR>,
				 <&gcc GCC_USB3PHY_0_PHY_BCR>;
			reset-names = "phy",
				      "phy_phy";

			status = "disabled";
		};

		usb3: usb3@8a00000 {
			compatible = "qcom,ipq9650-dwc3", "qcom,dwc3";
			reg = <0x8af8800 0x400>,
			      <0x8b80000 0x4000>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges;

			clocks = <&gcc GCC_USB0_MASTER_CLK>,
				<&gcc GCC_USB0_SLEEP_CLK>,
				<&gcc GCC_USB0_MOCK_UTMI_CLK>,
				<&gcc GCC_USB0_PHY_CFG_AHB_CLK>,
				<&gcc GCC_USB0_AUX_CLK>,
				<&gcc GCC_SNOC_USB_CLK>,
				<&gcc GCC_USB0_PIPE_CLK>;

			clock-names = "master",
				"sleep",
				"mock_utmi",
				"cfg_ahb_clk",
				"aux_clk",
				"snoc_usb_clk",
				"pipe_clk";

			assigned-clocks = <&gcc GCC_USB0_MASTER_CLK>,
					  <&gcc GCC_USB0_MOCK_UTMI_CLK>;
			assigned-clock-rates = <200000000>,
					       <60000000>;

			resets = <&gcc GCC_USB_BCR>;
			status = "disabled";

			dwc_0: dwc3@8a00000 {
				compatible = "snps,dwc3";
				reg = <0x8a00000 0xcd00>;
				clocks = <&gcc GCC_USB0_MOCK_UTMI_CLK>;
				clock-names = "ref";
				interrupts = <GIC_SPI 409 IRQ_TYPE_LEVEL_HIGH>;
				phys = <&qusb_phy_0>, <&ssphy_0>;
				phy-names = "usb2-phy", "usb3-phy";
				tx-fifo-resize;
				snps,is-utmi-l1-suspend;
				snps,hird-threshold = /bits/ 8 <0x0>;
				snps,dis_u2_susphy_quirk;
				snps,dis_u3_susphy_quirk;
				dr_mode = "host";
			};
		};

		timer@f420000 {
			compatible = "arm,armv7-timer-mem";
			reg = <0x0f420000 0x1000>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges;

			frame@f421000 {
				reg = <0x0f421000 0x1000>,
				      <0x0f422000 0x1000>;
				interrupts = <GIC_SPI 8 IRQ_TYPE_LEVEL_HIGH>,
					     <GIC_SPI 6 IRQ_TYPE_LEVEL_HIGH>;
				frame-number = <0>;
			};

			frame@f423000 {
				reg = <0x0f423000 0x1000>;
				interrupts = <GIC_SPI 9 IRQ_TYPE_LEVEL_HIGH>;
				frame-number = <1>;
				status = "disabled";
			};

			frame@f425000 {
				reg = <0x0f425000 0x1000>,
				      <0x0f426000 0x1000>;
				interrupts = <GIC_SPI 10 IRQ_TYPE_LEVEL_HIGH>;
				frame-number = <2>;
				status = "disabled";
			};

			frame@f427000 {
				reg = <0x0f427000 0x1000>;
				interrupts = <GIC_SPI 11 IRQ_TYPE_LEVEL_HIGH>;
				frame-number = <3>;
				status = "disabled";
			};

			frame@f429000 {
				reg = <0x0f429000 0x1000>;
				interrupts = <GIC_SPI 12 IRQ_TYPE_LEVEL_HIGH>;
				frame-number = <4>;
				status = "disabled";
			};

			frame@f42b000 {
				reg = <0x0f42b000 0x1000>;
				interrupts = <GIC_SPI 13 IRQ_TYPE_LEVEL_HIGH>;
				frame-number = <5>;
				status = "disabled";
			};

			frame@f42d000 {
				reg = <0x0f42d000 0x1000>;
				interrupts = <GIC_SPI 14 IRQ_TYPE_LEVEL_HIGH>;
				frame-number = <6>;
				status = "disabled";
			};
		};

		remoteproc_primess: remoteproc@14400000 {
			#size-cells = <0x02>;
			#address-cells = <0x02>;
			compatible = "qcom,ipq9650-primess-pas";

			reg = <0x14400000 0xfe410>,
			      <0x40000 0x10000>,
			      <0x7f400 0x150>,
			      <0x7f600 0x10c>,
			      <0x80000 0x40000>;
			reg-names = "primess",
				    "pdmem",
				    "iu0-csr",
				    "iuss-cmn",
				    "mlmem";

			interrupts-extended = <&intc GIC_SPI 687 IRQ_TYPE_EDGE_RISING>,
					      <&intc GIC_SPI 688 IRQ_TYPE_EDGE_RISING>,
					      <&intc GIC_SPI 689 IRQ_TYPE_EDGE_RISING>,
					      <&intc GIC_SPI 690 IRQ_TYPE_EDGE_RISING>,
					      <&intc GIC_SPI 691 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "task-done",
					  "error",
					  "misc",
					  "boot-done",
					  "wdog";

			clocks = <&gcc GCC_PRIMESS_CLK>;
			clock-names = "core-clk";

			memory-region = <&prime_mem>;
		};

		apps_iommu: iommu@15000000 {
			compatible = "arm,smmu-v2";
			reg = <0x15000000 0x40000>;

			interrupts = <GIC_SPI 527 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 530 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 531 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 532 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 533 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 534 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 535 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 536 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 537 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 538 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 539 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 540 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 541 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 542 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 543 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 544 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 545 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 546 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 547 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 548 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 549 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 550 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 551 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 552 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 553 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 554 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 555 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 556 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 557 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 558 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 559 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 560 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 561 IRQ_TYPE_LEVEL_HIGH>;

			#iommu-cells = <2>;
			#global-interrupts = <1>;

			status = "disabled";
		};

		remoteproc_cdsp: remoteproc@24000000 {
			compatible = "qcom,ipq9650-cdsp-pas";
			reg = <0x24000000 0x10000>;

			/* Inputs from turing */
			interrupts-extended = <&intc GIC_SPI 447 IRQ_TYPE_EDGE_RISING>,
					      <&cdsp_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
					      <&cdsp_smp2p_in 1 IRQ_TYPE_EDGE_RISING>,
					      <&cdsp_smp2p_in 2 IRQ_TYPE_EDGE_RISING>,
					      <&cdsp_smp2p_in 3 IRQ_TYPE_EDGE_RISING>,
					      <&cdsp_smp2p_in 7 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "wdog",
					  "fatal",
					  "ready",
					  "handover",
					  "stop-ack",
					  "shutdown-ack";

			memory-region = <&cdsp_mem &q6_cdsp_dtb_mem>;

			/* Outputs to turing */
			qcom,smem-states = <&cdsp_smp2p_out 0>;
			qcom,smem-state-names = "stop";

			remoteproc_cdsp_glink: glink-edge {
				qcom,remote-pid = <5>;
				transport = "smem";
				mboxes = <&ipcc IPCC_MPROC_NSP
					  IPCC_MPROC_SIGNAL_GLINK_QMP>;
				mbox-names = "cdsp_smem";
				interrupt-parent = <&ipcc>;
				interrupts = <IPCC_MPROC_NSP
					      IPCC_MPROC_SIGNAL_GLINK_QMP
					      IRQ_TYPE_EDGE_RISING>;

				label = "cdsp";
				qcom,glink-label = "cdsp";

				qcom,cdsp_qrtr {
					qcom,glink-channels = "IPCRTR";
					qcom,intents = <0x800  5
							0x2000 3
							0x4400 2>;
				};

				fastrpc {
					compatible = "qcom,fastrpc";
					qcom,glink-channels = "fastrpcglink-apps-dsp";
					label = "cdsp";
					#address-cells = <1>;
					#size-cells = <0>;

					compute-cb@1 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <1>;
						iommus = <&apps_iommu 0x0C01 0x0000>;
						dma-coherent;
					};

					compute-cb@2 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <2>;
						iommus = <&apps_iommu 0x0C02 0x0000>;
						dma-coherent;
					};

					compute-cb@3 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <3>;
						iommus = <&apps_iommu 0x0C03 0x0000>;
						dma-coherent;
					};

					compute-cb@4 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <4>;
						iommus = <&apps_iommu 0x0C04 0x0000>;
						dma-coherent;
					};

					compute-cb@5 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <5>;
						iommus = <&apps_iommu 0x0C05 0x0000>;
						dma-coherent;
					};

					compute-cb@6 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <6>;
						iommus = <&apps_iommu 0x0C06 0x0000>;
						dma-coherent;
					};

					compute-cb@7 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <7>;
						iommus = <&apps_iommu 0x0C07 0x0000>;
						dma-coherent;
					};

					compute-cb@8 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <8>;
						iommus = <&apps_iommu 0x0C08 0x0000>;
						dma-coherent;
					};

					compute-cb@9 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <9>;
						iommus = <&apps_iommu 0x0C09 0x0000>;
						dma-coherent;
					};

					compute-cb@10 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <12>;
						iommus = <&apps_iommu 0x0C0C 0x0000>;
						dma-coherent;
					};

					compute-cb@11 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <13>;
						iommus = <&apps_iommu 0x0C0D 0x0000>;
						dma-coherent;
					};

					compute-cb@12 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <14>;
						iommus = <&apps_iommu 0x0C0E 0x0000>;
						dma-coherent;
					};
				};
			};
		};

		nsscc: clock-controller@29b00000 {
			compatible = "qcom,ipq9650-nsscc";
			reg = <0x29b00000 0x100000>;
			clocks = <&xo>,
				 <&cmn_pll IPQ9650_NSS_CLK>,
				 <&cmn_pll IPQ9650_PPE_CLK>,
				 <&gcc_gpll0_out_aux>,
				 <&ess_uniphy 0>,
				 <&ess_uniphy 1>,
				 <&ess_uniphy 2>,
				 <&ess_uniphy 3>,
				 <&ess_uniphy 4>,
				 <&ess_uniphy 5>;
			clock-names = "xo",
				      "nss",
				      "ppe",
				      "gpll0_out",
				      "uniphy0_rx",
				      "uniphy0_tx",
				      "uniphy1_rx",
				      "uniphy1_tx",
				      "uniphy2_rx",
				      "uniphy2_tx";
			#clock-cells = <1>;
			#reset-cells = <1>;
		};

		pcie3: pcie@30000000 {
			compatible = "qcom,pcie-ipq9650";
			reg =  <0x30000000 0xf1d>,
			       <0x30000f20 0xa8>,
			       <0x30001000 0x1000>,
			       <0x000b0000 0x3000>,
			       <0x30100000 0x1000>;
			reg-names = "dbi", "elbi", "atu", "parf", "config";
			device_type = "pci";
			linux,pci-domain = <3>;
			bus-range = <0x00 0xff>;
			num-lanes = <2>;
			#address-cells = <3>;
			#size-cells = <2>;
			axi-halt-val = <0x1e>; /* increase halt window size to 1GB */

			ranges = <0x81000000 0 0x30200000 0x30200000 0 0x00100000>,   /* downstream I/O */
				 <0x82000000 0 0x30300000 0x30300000 0 0x0fd00000>; /* non-prefetchable memory */

			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 0x7>;
			interrupt-map = <0 0 0 1 &intc 0 505 IRQ_TYPE_LEVEL_HIGH>, /* int_a */
					<0 0 0 2 &intc 0 506 IRQ_TYPE_LEVEL_HIGH>, /* int_b */
					<0 0 0 3 &intc 0 507 IRQ_TYPE_LEVEL_HIGH>, /* int_c */
					<0 0 0 4 &intc 0 508 IRQ_TYPE_LEVEL_HIGH>; /* int_d */

			interrupts = <GIC_SPI 504 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "global_irq";

			clocks = <&gcc GCC_PCIE3_AXI_M_CLK>,
				 <&gcc GCC_PCIE3_AXI_S_CLK>,
				 <&gcc GCC_PCIE3_AHB_CLK>,
				 <&gcc GCC_PCIE3_AUX_CLK>,
				 <&gcc GCC_PCIE3_AXI_S_BRIDGE_CLK>,
				 <&gcc GCC_PCIE3_RCHNG_CLK>;

			clock-names = "axi_m",
				      "axi_s",
				      "ahb",
				      "aux",
				      "axi_bridge",
				      "rchng";

			assigned-clocks = <&gcc GCC_PCIE3_AUX_CLK>,
					  <&gcc GCC_PCIE3_AXI_M_CLK>,
					  <&gcc GCC_PCIE3_AXI_S_BRIDGE_CLK>,
					  <&gcc GCC_PCIE3_AXI_S_CLK>,
					  <&gcc GCC_PCIE3_RCHNG_CLK>;

			assigned-clock-rates = <20000000>,
					       <266666666>,
					       <200000000>,
					       <200000000>,
					       <100000000>;

			resets = <&gcc GCC_PCIE3_PIPE_CLK_ARES>,
				 <&gcc GCC_PCIE3_CORE_STICKY_RESET>,
				 <&gcc GCC_PCIE3_AXI_M_CLK_ARES>,
				 <&gcc GCC_PCIE3_AXI_S_CLK_ARES>,
				 <&gcc GCC_PCIE3_AXI_M_STICKY_RESET>,
				 <&gcc GCC_PCIE3_AXI_S_STICKY_RESET>,
				 <&gcc GCC_PCIE3_AHB_CLK_ARES>,
				 <&gcc GCC_PCIE3_AUX_CLK_ARES>;

			reset-names = "pipe",
				      "sticky",
				      "axi_m",
				      "axi_s",
				      "axi_m_sticky",
				      "axi_s_sticky",
				      "ahb",
				      "aux";

			msi-parent = <&intc>;

			pinctrl-0 = <&pcie3_default_state>;
			pinctrl-names = "default";

			phys = <&pcie3_lanes>;
			phy-names = "pciephy";

			status = "disabled";
		};

