/dts-v1/;

#include "ipq5210-rdp-common.dtsi"
#include "ipq5210-default-memory.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. IPQ5210 RDP501";
	compatible = "qcom,ipq5210-rdp501", "qcom,ipq5210";

	soc@0 {
		mdio@90000 {
			status = "okay";
			/* gpio reset for Malibu PHY */
			phy-reset-gpio = <&tlmm 24 GPIO_ACTIVE_LOW>;

			ethernet-phy-package@0 {
				compatible = "qcom,qca8075-package";
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0x0>;
				qcom,package-mode = "psgmii";
				phy0: ethernet-phy@0 {
					reg = <0>;
				};
				phy1: ethernet-phy@1 {
					reg = <1>;
				};
				phy2: ethernet-phy@2 {
					reg = <2>;
				};
			};
		};

		mdio_ahb: mdio-ahb@1400000 {
			status = "okay";
			compatible = "qcom,mdio-ahb-ipq52xx";
			reg = <0x1400000 0x200000>;  /* Base address: 0x1400000, Size: 2MB */
		};

		ess-instance {
			num_devices = <0x1>;

			ess_switch: ess-switch@3a000000 {
				switch_lan_bmp = <0xe>; /* lan port bitmap */
				switch_wan_bmp = <0x10>; /* wan port bitmap */
				switch_mac_mode = <0x0>; /* PSGMII for malibu PHY */
				switch_mac_mode1 = <0xff>; /* unused */
				switch_mac_mode2 = <0xff>; /* unused */

				qcom,port_phyinfo {
					port@0 {
						port_id = <1>;
						phy_address = <0>;
						phy-handle = <&phy0>;
						phy-mode = "psgmii";
					};
					port@1 {
						port_id = <2>;
						phy_address = <1>;
						phy-handle = <&phy1>;
						phy-mode = "psgmii";
					};
					port@2 {
						port_id = <3>;
						phy_address = <2>;
						phy-handle = <&phy2>;
						phy-mode = "psgmii";
					};
					port@3 {
						port_id = <4>;
						phy-mode = "internal";
					};
				};
			};
		};
	};
};

&nsscc {
	assigned-clocks = <&nsscc NSS_CC_EPHY_RX_CLK_SRC>,
			  <&nsscc NSS_CC_EPHY_TX_CLK_SRC>;
	assigned-clock-parents = <&nsscc NSS_CC_PORT4_RX_DIV_CLK_SRC>,
				 <&nsscc NSS_CC_PORT4_TX_DIV_CLK_SRC>;
};

&tlmm {
	pcie0_default_state: pcie0-default-state {
		pins = "gpio32";
		function = "gpio";
		drive-strength = <6>;
		bias-pull-down;
		output-low;
	};
};

&pcie0_phy {
	status = "disabled";
};

&pcie0 {
	pinctrl-0 = <&pcie0_default_state>;
	perst-gpio = <&tlmm 32 GPIO_ACTIVE_LOW>;
	status = "disabled";

	pcie0_rp {
		reg = <0 0 0 0 0>;
		qcom,mhi@0 {
			reg = <0 0 0 0 0>;
			memory-region = <&qcn9224_pcie0>, <&mlo_global_mem0>;
			memory-region-names = "host-ddr-mem", "mlo-global-mem";
			qcom,board_id = <0x1041>;
			status = "okay";
			qcom,wsi-controller;
			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					wifi0_wsi_tx: endpoint {
						remote-endpoint = <&wifi0_wsi_rx>;
					};
				};

				port@1 {
					reg = <1>;
					wifi0_wsi_rx: endpoint {
						remote-endpoint = <&wifi0_wsi_tx>;
					};
				};
			};
		};
	};
};

&pcie1_phy {
	status = "disabled";
};

&pcie1 {
	status = "disabled";
};

&qcn9224_pcie0 {
	status = "okay";
};

&mlo_global_mem0 {
	status = "okay";
};

&spi0 {
	status = "disabled";
};

&qpic_bam {
	status = "disabled";
};

&qpic_nand {
	status = "disabled";
};

&qusb_phy_0 {
	status = "disabled";
};

&ssphy_0 {
	status = "disabled";
};

&usb3 {
	status = "disabled";
};

&uart1 {
	status = "okay";
};
