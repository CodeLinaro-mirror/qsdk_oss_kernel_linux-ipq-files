					<&nsscc NSS_CC_UNIPHY_PORT4_RX_DIV4_CLK>,
					<&nsscc NSS_CC_UNIPHY_PORT4_TX_DIV4_CLK>;
				clock-names = "cmn_ahb_clk",
					"cmn_sys_clk",
					"uniphy0_ahb_clk",
					"uniphy0_sys_clk",
					"uniphy1_ahb_clk",
					"uniphy1_sys_clk",
					"uniphy2_ahb_clk",
