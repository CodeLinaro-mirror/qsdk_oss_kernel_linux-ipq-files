					"uniphy_port3_tx_div4_clk",
					"uniphy_port4_rx_div4_clk",
					"uniphy_port4_tx_div4_clk";
				resets = <&nsscc NSS_CC_PPE_BCR>,
					<&gcc GCC_UNIPHY0_BCR>,
