					reserved {
						ucast_queue = <255 255>;
						mcast_queue = <0 0>;
						l0sp = <57 63>;
						l0cdrr = <0 0>;
						l0edrr = <0 0>;
						l1cdrr = <57 63>;
						l1edrr = <57 63>;
					};
				};

				port_scheduler_config {
					port@0 {
						port_id = <0>;
						l1scheduler {
							group@0 {
								/* L0 SP */
								sp = <44>;
								sp_loop_pri = <13>;
								sp_max_pri = <1>;
								/* cpri cdrr epri edrr */
								cfg = <0 44 0 44>;
							};
						};
						l0scheduler {
							group@0 {
								/* 8 x (4 cores + 2 VP) */
								ucast_queue = <170>;
								ucast_loop_pri = <48>;
								ucast_max_pri = <8>;
								/* multicast queue */
								mcast_queue = <256>;
								mcast_loop_pri = <8>;
								/* sp cpri cdrr epri edrr */
								cfg = <44 0 170 0 170>;
							};
							group@1 {
								/* 4 GRO + 1x4 SMD */
								ucast_queue = <218>;
								ucast_loop_pri = <8>;
								ucast_max_pri = <4>;
								mcast_queue = <264>;
								mcast_loop_pri = <8>;
								cfg = <50 0 218 0 218>;
							};
							group@2 {
								/* DS */
								ucast_queue = <226>;
								ucast_loop_pri = <8>;
								cfg = <52 0 226 0 226>;
							};

							group@3 {
								/* SMD DS */
								ucast_queue = <234>;
								ucast_loop_pri = <4>;
								cfg = <53 0 234 0 234>;
							};

							group@4 {
								/* Ingress SRAM for DDRQ */
								ucast_queue = <238>;
								ucast_loop_pri = <17>;
								ucast_max_pri = <8>;
								cfg = <54 0 238 0 238>;
							};
						};
					};
					port@1 {
						port_id = <1>;
						l1scheduler {
							group@0 {
								sp = <0>;
								cfg = <0 0 0 0>;
							};
						};
						l0scheduler {
							group@0 {
								ucast_queue = <0>;
								ucast_loop_pri = <8>;
								mcast_queue = <272>;
								mcast_loop_pri = <4>;
								cfg = <0 0 0 0 0>;
							};
						};
					};
					port@2 {
						port_id = <2>;
						l1scheduler {
							group@0 {
								sp = <2>;
								cfg = <0 2 0 2>;
							};
						};
						l0scheduler {
							group@0 {
								ucast_queue = <8>;
								ucast_loop_pri = <8>;
								mcast_queue = <276>;
								mcast_loop_pri = <4>;
								cfg = <2 0 8 0 8>;
							};
						};
					};
					port@3 {
						port_id = <3>;
						l1scheduler {
							group@0 {
								sp = <4>;
								cfg = <0 4 0 4>;
							};
						};
						l0scheduler {
							group@0 {
								ucast_queue = <16>;
								ucast_loop_pri = <8>;
								mcast_queue = <280>;
								mcast_loop_pri = <4>;
								cfg = <4 0 16 0 16>;
							};
						};
					};
					port@4 {
						port_id = <4>;
						l1scheduler {
							group@0 {
								sp = <6>;
								cfg = <0 6 0 6>;
							};
						};
						l0scheduler {
							group@0 {
								ucast_queue = <24>;
								ucast_loop_pri = <8>;
								mcast_queue = <284>;
								mcast_loop_pri = <4>;
								cfg = <6 0 24 0 24>;
							};
						};
					};
					port@5 {
						port_id = <5>;
						l1scheduler {
							group@0 {
								sp = <8>;
								cfg = <0 8 0 8>;
							};
						};
						l0scheduler {
							group@0 {
								ucast_queue = <32>;
								ucast_loop_pri = <8>;
								mcast_queue = <288>;
								mcast_loop_pri = <4>;
								cfg = <8 0 32 0 32>;
							};
						};
					};

					port@6 {
						port_id = <6>;
						l1scheduler {
							group@0 {
								sp = <10>;
								sp_loop_pri = <15>;
								sp_max_pri = <1>;
								cfg = <6 0 10 0 10>;
							};
						};
						l0scheduler {
							group@0 {
								ucast_queue = <40>;
								ucast_loop_pri = <120>;
								ucast_max_pri = <8>;
								mcast_queue = <292>;
								mcast_loop_pri = <4>;
								cfg = <10 0 40 0 40>;
							};
						};
					};

					port@7 {
						port_id = <7>;
						l1scheduler {
							group@0 {
								sp = <42>;
								sp_loop_pri = <2>;
								sp_max_pri = <1>;
								cfg = <0 42 0 42>;
							};
						};
						l0scheduler {
							group@0 {
								ucast_queue = <160>;
								ucast_loop_pri = <10>;
								ucast_max_pri = <8>;
								mcast_queue = <296>;
								mcast_loop_pri = <4>;
								cfg = <42 0 160 0 160>;
							};
						};
					};
				};
			};
		};

		/* EDMA host driver configuration */
		edma@3ad00000 {
			compatible = "qcom,edma";
			reg = <0x3ad00000 0x1C5000>;
			reg-names = "edma-reg-base";
			resets = <&nsscc NSS_CC_PPE_EDMA_CLK_ARES>,
			       <&nsscc NSS_CC_PPE_EDMA_CFG_CLK_ARES>;
			reset-names = "edma_rst",
				"edma_cfg_rst";
			qcom,rxdesc-ring-max = <24>;
			qcom,rxfill-ring-max = <20>;
			qcom,txdesc-ring-max = <24>;
			qcom,txcomp-ring-max = <20>;
			qcom,rx-page-mode = <0>;
			qcom,tx-map-priority-level = <1>;
			qcom,rx-map-priority-level = <1>;
			qcom,txdesc-fc-grp-map = <1 2 3 4 5 6>;
			qcom,vp-id = <8>;
			interrupts = <0 332 4>, <0 333 4>, <0 334 4>, <0 335 4>,
				   <0 336 4>, <0 337 4>, <0 338 4>, <0 339 4>,
				   <0 340 4>, <0 341 4>, <0 342 4>, <0 343 4>,
				   <0 344 4>, <0 345 4>, <0 346 4>, <0 347 4>,
				   <0 348 4>, <0 349 4>, <0 350 4>, <0 351 4>, /* TX Complete ring IRQ info (0 - 19) */

				   <0 288 4>, <0 289 4>, <0 290 4>, <0 291 4>,
				   <0 292 4>, <0 293 4>, <0 294 4>, <0 295 4>,
				   <0 296 4>, <0 297 4>, <0 298 4>, <0 299 4>,
				   <0 300 4>, <0 301 4>, <0 302 4>, <0 303 4>,
				   <0 304 4>, <0 305 4>, <0 306 4>, <0 307 4>,
				   <0 308 4>, <0 309 4>, <0 310 4>, <0 311 4>, /* RX desc ring IRQ info (0 - 23) */

				   <0 312 4>, <0 313 4>, <0 314 4>, <0 315 4>,
				   <0 316 4>, <0 317 4>, <0 318 4>, <0 319 4>,
				   <0 320 4>, <0 321 4>, <0 322 4>, <0 323 4>,
				   <0 324 4>, <0 325 4>, <0 326 4>, <0 327 4>,
				   <0 328 4>, <0 329 4>, <0 330 4>, <0 331 4>, /* RX fill ring IRQ info (0 - 19) */

				   <0 352 4>;					/* Misc interrupt */
			interrupt-names = "txcmpl_0", "txcmpl_1", "txcmpl_2", "txcmpl_3",
				   "txcmpl_4", "txcmpl_5", "txcmpl_6", "txcmpl_7",
				   "txcmpl_8", "txcmpl_9", "txcmpl_10", "txcmpl_11",
				   "txcmpl_12", "txcmpl_13", "txcmpl_14", "txcmpl_15",
				   "txcmpl_16", "txcmpl_17", "txcmpl_18", "txcmpl_19",

				   "rxdesc_0", "rxdesc_1", "rxdesc_2", "rxdesc_3",
				   "rxdesc_4", "rxdesc_5", "rxdesc_6", "rxdesc_7",
				   "rxdesc_8", "rxdesc_9", "rxdesc_10", "rxdesc_11",
				   "rxdesc_12", "rxdesc_13", "rxdesc_14", "rxdesc_15",
				   "rxdesc_16", "rxdesc_17", "rxdesc_18", "rxdesc_19",
				   "rxdesc_20", "rxdesc_21", "rxdesc_22", "rxdesc_23",

				   "rxfill_0", "rxfill_1", "rxfill_2", "rxfill_3",
				   "rxfill_4", "rxfill_5", "rxfill_6", "rxfill_7",
				   "rxfill_8", "rxfill_9", "rxfill_10", "rxfill_11",
				   "rxfill_12", "rxfill_13", "rxfill_14", "rxfill_15",
				   "rxfill_16", "rxfill_17", "rxfill_18", "rxfill_19",

				   "misc_err";
			clocks = <&nsscc NSS_CC_NSS_CSR_CLK>,
				<&nsscc NSS_CC_NSSNOC_NSS_CSR_CLK>,
				<&nsscc NSS_CC_PPE_EDMA_CLK>,
				<&gcc GCC_NSSNOC_ATB_CLK>,
				<&gcc GCC_NSS_TS_CLK>,
				<&gcc GCC_NSSNOC_QOSGEN_REF_CLK>,
				<&gcc GCC_NSSNOC_TIMEOUT_REF_CLK>,
				<&gcc GCC_NSSNOC_SNOC_CLK>,
				<&gcc GCC_NSSCFG_CLK>,
				<&gcc GCC_NSSNOC_NSSCC_CLK>,
				<&gcc GCC_NSSCC_CLK>,
				<&gcc GCC_NSSNOC_XO_DCD_CLK>,
				<&gcc GCC_NSSNOC_SNOC_1_CLK>,
				<&gcc GCC_NSSNOC_PCNOC_1_CLK>,
				<&gcc GCC_NSSNOC_MEMNOC_CLK>,
				<&gcc GCC_NSSNOC_MEMNOC_1_CLK>;
			clock-names = "nss-csr-clk", "nss-nssnoc-csr-clk",
				"nss-edma-clk", "nss-nssnoc-atb-clk", "nss-ts-clk",
				"nss-nssnoc-qosgen-ref-clk", "nss-nssnoc-timeout-ref-clk",
				"nss-nssnoc-snoc-clk", "nss-nsscfg-clk", "nss-nssnoc-nsscc-clk",
				"nss-nsscc-clk", "nss-nssnoc-xo-dcd-clk", "nss-nssnoc-snoc-1-clk",
				"nss-nssnoc-pcnoc-1-clk", "nss-nssnoc-memnoc-clk",
				"nss-nssnoc-mem-noc-1-clk";
		};

		nss-ppe {
			compatible = "qcom,nss-ppe";
		};
	};

	firmware {
		scm {
			compatible = "qcom,scm-ipq5210", "qcom,scm";
			qcom,dload-mode = <&tcsr 0x25100>;
		};

		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
		};
	};

	tmel-log {
		compatible = "qcom,tmel-log-ipq5210";
	};

	qcom,test@0 {
		compatible = "qcom,testmhi";
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	qti,tfa-optee-log {
		compatible = "qti,tfa-optee-log";
		interrupts = <GIC_SPI 267 IRQ_TYPE_EDGE_RISING>;
		tfa-diag-info =<&tfa_diag_buf>;
		optee-diag-info =<&optee_diag_buf>;
	};

	ctx-save {
		compatible = "qti,ctxt-save-ipq5210";
		memory-region = <&minidump_mem>;
		qcom,imem = <&imem>;
		minidump-level = <2>;
	};

	pmu {
		compatible = "arm,cortex-a53-pmu";
		interrupts = <GIC_PPI 7 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_HIGH)>;
	};

	pmu-v7 {
		compatible = "arm,cortex-a7-pmu";
		interrupts = <GIC_PPI 7 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_HIGH)>;
	};

	thermal_zones: thermal-zones {
		ethphy-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&tsens 11>;

			trips {
				ethphy-critical {
					temperature = <120000>;
					hysteresis = <9000>;
					type = "critical";
				};
			};
		};

		pon-uniphy-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&tsens 12>;

			trips {
				pon-uniphy-critical {
					temperature = <120000>;
					hysteresis = <9000>;
					type = "critical";
				};
			};
		};

		nss-top-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&tsens 13>;

			trips {
				nss-top-critical {
					temperature = <120000>;
					hysteresis = <9000>;
					type = "critical";
				};
			};
		};

		a53ss-cm-dist-ts-0-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&tsens 14>;

			trips {
				a53ss-cm-dist-ts-0-critical {
					temperature = <120000>;
					hysteresis = <9000>;
					type = "critical";
				};
			};
		};

		a53ss-cm-dist-ts-1-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&tsens 15>;

			trips {
				a53ss-cm-dist-ts-1-critical {
					temperature = <120000>;
					hysteresis = <9000>;
					type = "critical";
				};
			};
		};
	};
};
