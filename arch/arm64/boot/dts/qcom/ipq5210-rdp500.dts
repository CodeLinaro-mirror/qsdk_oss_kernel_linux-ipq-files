/dts-v1/;

#include "ipq5210-rdp-common.dtsi"
#include "ipq5210-default-memory.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. IPQ5210 RDP500";
	compatible = "qcom,ipq5210-rdp500", "qcom,ipq5210";

	aliases {
		serial0 = &uart1;
		ethernet0 = "/soc/dp1";
		ethernet1 = "/soc/dp2";
		ethernet2 = "/soc/dp3";
		ethernet3 = "/soc/dp4";
		ethernet4 = "/soc/dp5";
	};

	soc@0 {
		mdio@90000 {
			status = "okay";
			/* gpio reset for Malibu PHY */
			phy-reset-gpio = <&tlmm 24 GPIO_ACTIVE_LOW>;

			ethernet-phy-package@0 {
				compatible = "qcom,qca8075-package";
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0x0>;
				qcom,package-mode = "psgmii";
				phy0: ethernet-phy@0 {
					reg = <0x0>;
				};
				phy1: ethernet-phy@1 {
					reg = <1>;
				};
				phy2: ethernet-phy@2 {
					reg = <2>;
				};
			};
		};

		mdio_ahb: mdio-ahb@1400000 {
			status = "okay";
			compatible = "qcom,mdio-ahb-ipq52xx";
			reg = <0x1400000 0x200000>;  /* Base address: 0x1400000, Size: 2MB */
		};

		ess-instance {
			num_devices = <0x1>;

			ess_switch: ess-switch@3a000000 {
				switch_lan_bmp = <0x1e>; /* lan port bitmap */
				switch_wan_bmp = <0x40>; /* wan port bitmap */
				switch_mac_mode = <0x0>; /* PSGMII for malibu PHY */
				switch_mac_mode1 = <0xff>; /* unused */
				switch_mac_mode2 = <0xff>;

				qcom,port_phyinfo {
					port@0 {
						port_id = <1>;
						phy_address = <0>;
						phy-handle = <&phy0>;
						phy-mode = "psgmii";
					};
					port@1 {
						port_id = <2>;
						phy_address = <1>;
						phy-handle = <&phy1>;
						phy-mode = "psgmii";
					};
					port@2 {
						port_id = <3>;
						phy_address = <2>;
						phy-handle = <&phy2>;
						phy-mode = "psgmii";
					};
					port@3 {
						port_id = <4>;
						phy-mode = "internal";
					};
					port@5 {
						port_id = <6>;
						forced-speed = <10000>;
						forced-duplex = <1>;
						fixed-link {
							speed = <10000>;
							full-duplex;
							pause;
						};
					};
				};
			};
		};

		dp1 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <1>;
			reg = <0x3a001000 0x200>;
			qcom,mactype = <0>;
			local-mac-address = [000000000000];
			qcom,ppe-offload-disabled = <0>;
		};

		dp2 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <2>;
			reg = <0x3a001200 0x200>;
			qcom,mactype = <0>;
			qcom,ppe-offload-disabled = <0>;
		};


		dp3 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <3>;
			reg = <0x3a001400 0x200>;
			qcom,mactype = <0>;
			local-mac-address = [000000000000];
			qcom,ppe-offload-disabled = <0>;
		};

		dp4 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <4>;
			reg = <0x3a001600 0x200>;
			qcom,mactype = <0>;
			local-mac-address = [000000000000];
			qcom,ppe-offload-disabled = <0>;
		};

		dp5 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <6>;
			reg = <0x3A508000 0x4000>;
			qcom,mactype = <1>;
			local-mac-address = [000000000000];
			qcom,ppe-offload-disabled = <0>;
			qcom,gem_port = <1>;
			pinctrl-0 = <&pps_state>;
			pinctrl-names = "default";
			pps-gpio = <&tlmm 18 GPIO_ACTIVE_LOW>;
			interrupts = <GIC_SPI 359 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "pps_in";
			clocks = <&nsscc NSS_CC_XGMAC2_PTP_REF_CLK>;
			clock-names = "ptp";
		};
	};
};

&nsscc {
	assigned-clocks = <&nsscc NSS_CC_EPHY_RX_CLK_SRC>,
			  <&nsscc NSS_CC_EPHY_TX_CLK_SRC>;
	assigned-clock-parents = <&nsscc NSS_CC_PORT4_RX_DIV_CLK_SRC>,
				 <&nsscc NSS_CC_PORT4_TX_DIV_CLK_SRC>;
};

&tlmm {
	pcie0_default_state: pcie0-default-state {
		pins = "gpio32";
		function = "gpio";
		drive-strength = <6>;
		bias-pull-down;
		output-low;
	};
};

&pcie0_phy {
	status = "okay";
};

&pcie0 {
	pinctrl-0 = <&pcie0_default_state>;
	perst-gpio = <&tlmm 32 GPIO_ACTIVE_LOW>;
	status = "okay";

	pcie0_rp {
		reg = <0 0 0 0 0>;
		qcom,mhi@0 {
			reg = <0 0 0 0 0>;
			memory-region = <&qcn9224_pcie0>, <&mlo_global_mem0>;
			memory-region-names = "host-ddr-mem", "mlo-global-mem";
			qcom,board_id = <0x1041>;
			status = "okay";
			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
				};

				port@1 {
					reg = <1>;
				};
			};
		};
	};
};

&qcn9224_pcie0 {
	status = "okay";
};

&mlo_global_mem0 {
	status = "okay";
};
