/dts-v1/;

#include <dt-bindings/input/input.h>
#include "ipq5210.dtsi"

/ {
	aliases {
		serial0 = &uart1;
		serial1 = &uart0;
	};

	chosen {
		stdout-path = "serial0";
		bootargs-append = " clk_ignore_unused pcie_pme=nomsi";
	};

	soc@0 {
		qupv3: geniqup@1ac0000 {
			status = "okay";

			uart0: serial@1a90000 {
				pinctrl-0 = <&qup_uart0_default>;
				pinctrl-names = "default";
			};

			uart1: serial@1a84000 {
				pinctrl-0 = <&qup_uart1_default>;
				pinctrl-names = "default";
				status = "okay";
			};

			spi0: spi@1a80000 {
				pinctrl-0 = <&qup_spi0_default>;
				pinctrl-names = "default";
				status = "okay";

				flash@0 {
					compatible = "spansion,s25fs128s1", "jedec,spi-nor";
					#address-cells = <1>;
					#size-cells = <1>;
					reg = <0>;
					spi-max-frequency = <50000000>;
				};
			};
		};

		gpio-keys {
			compatible = "gpio-keys";
			pinctrl-0 = <&gpio_keys_default>;
			pinctrl-names = "default";
			status = "okay";

			button-wps {
				label = "wps";
				linux,code = <KEY_WPS_BUTTON>;
				gpios = <&tlmm 25 GPIO_ACTIVE_LOW>;
				linux,input-type = <1>;
				debounce-interval = <60>;
			};
		};
	};
};

&pwm {
	pinctrl-0 = <&pwm_default_state>;
	pinctrl-names = "default";
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo {
	clock-frequency = <24000000>;
};

&ref_48mhz_clk {
	clock-div = <1>;
	clock-mult = <1>;
};

&xo_clk {
	clock-frequency = <48000000>;
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qspi_default_state>;
	pinctrl-names = "default";
	status = "okay";
};

&i2c0 {
	pinctrl-0 = <&qup_i2c0_default>;
	pinctrl-names = "default";

	status = "disabled";
};

&qusb_phy_0 {
	status = "okay";
};

&qmp_tmel {
	status = "okay";
};

&tmelcom {
	status = "okay";
};

&ssphy_0 {
	status = "okay";
};

&usb3 {
	status = "okay";
};

&sdhc {
	max-frequency = <192000000>;
	bus-width = <4>;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	non-removable;
	pinctrl-0 = <&sdc_default_state>;
	pinctrl-names = "default";
	status = "disabled";
};

&tlmm {
	gpio_keys_default: gpio-keys-default-state {
		pins = "gpio25";
		function = "gpio";
		drive-strength = <6>;
		bias-pull-up;
	};

	pwm_default_state: pwm-default-state {
		pins = "gpio11";
		function = "pwm_out20";
		drive-strength = <6>;
		bias-pull-down;
	};

	qspi_default_state: qspi-default-state {
		qspi_clock {
			pins = "gpio5";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-pull-down;
		};

		qspi_cs {
			pins = "gpio4";
			function = "qspi_cs_n";
			drive-strength = <8>;
			bias-pull-up;
		};

		qspi_data {
			pins = "gpio0", "gpio1", "gpio2", "gpio3";
			function = "qspi_data";
			drive-strength = <8>;
			bias-pull-down;
		};
	};

	sdc_default_state: sdc-default-state {
		clk-pins {
			pins = "gpio5";
			function = "sdc_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cmd-pins {
			pins = "gpio4";
			function = "sdc_cmd";
			drive-strength = <8>;
			bias-pull-up;
		};

		data-pins {
			pins = "gpio0", "gpio1", "gpio2", "gpio3";
			function = "sdc_data";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	qup_spi0_default: qup-spi0-default-state {
		qup_spi0_clk {
			pins = "gpio6";
			function = "qup_se0_l2";
			drive-strength = <8>;
			bias-pull-down;
		};

		qup_spi0_cs {
			pins = "gpio7";
			function = "qup_se0_l3";
			drive-strength = <8>;
			bias-pull-up;
		};

		qup_spi0_miso {
			pins = "gpio8";
			function = "qup_se0_l0";
			drive-strength = <8>;
			bias-pull-down;
		};

		qup_spi0_mosi {
			pins = "gpio9";
			function = "qup_se0_l1";
			drive-strength = <8>;
			bias-pull-down;
		};
	};

	qup_uart0_default: qup-uart0-default-state {
		qup_uart0_tx {
			pins = "gpio40";
			function = "qup_se4_l2";
			drive-strength = <6>;
			bias-pull-down;
		};

		qup_uart0_rx {
			pins = "gpio41";
			function = "qup_se4_l3";
			drive-strength = <6>;
			bias-pull-down;
		};

		qup_uart0_cts {
			pins = "gpio42";
			function = "qup_se4_l0";
			drive-strength = <6>;
			bias-pull-down;
		};

		qup_uart0_rfr {
			pins = "gpio43";
			function = "qup_se4_l1";
			drive-strength = <6>;
			bias-pull-down;
		};
	};

	qup_uart1_default: qup-uart1-default-state {
		qup_uart1_tx {
			pins = "gpio39";
			function = "qup_se1_l2";
			drive-strength = <6>;
			bias-pull-down;
		};

		qup_uart1_rx {
			pins = "gpio38";
			function = "qup_se1_l3";
			drive-strength = <6>;
			bias-pull-down;
		};
	};

	qup_i2c0_default: qup-i2c0-default-state {
		qup_i2c0_scl {
			pins = "gpio20";
			function = "qup_se2_l10";
			drive-strength = <6>;
			bias-pull-up;
		};

		qup_i2c0_sda {
			pins = "gpio21";
			function = "qup_se2_l00";
			drive-strength = <6>;
			bias-pull-up;
		};
	};
};
