/dts-v1/;

#include "ipq9650-rdp-common.dtsi"
#include <dt-bindings/clock/qcom,qce2204-pcs.h>

/ {
	model = "Qualcomm Technologies, Inc. IPQ9650 DB JU01-C2";
	compatible = "qcom,ipq9650-db-ju01-c2", "qcom,ipq9650";

	aliases {
		ethernet0 = "/soc/dp1";
		ethernet1 = "/soc/dp2";
		ethernet2 = "/soc/dp3";
	};

	clocks {
		qce2204_uniphy1_ppe_250m: qce2204-uniphy1-ppe-250m {
			compatible = "fixed-clock";
			clock-frequency = <250000000>;
			#clock-cells = <0>;
		};
	};
	soc@0 {
		qupv3: geniqup@1ac0000 {
			status = "okay";

			spi0: spi@1a80000 {
				pinctrl-0 = <&qup_spi0_default>;
				pinctrl-names = "default";
				status = "okay";

				flash@0 {
					compatible = "spansion,s25fs128s1", "jedec,spi-nor";
					#address-cells = <1>;
					#size-cells = <1>;
					reg = <0>;
					spi-max-frequency = <50000000>;
				};
			};

			i2c0: i2c@1a84000 {
				pinctrl-0 = <&qup_i2c0_default>;
				pinctrl-names = "default";
				status = "disabled";
			};

			i2c1: i2c@1a88000 {
				pinctrl-0 = <&qup_i2c1_default>;
				pinctrl-names = "default";
				status = "disabled";
			};

			i2c2: i2c@1a8c000 {
				pinctrl-0 = <&qup_i2c2_default>;
				pinctrl-names = "default";
				status = "okay";

				pmic@68 {
					compatible = "mps,mp8899";
					reg = <0x68>;

					regulators {
						/* APC_CX */
						ipq9650_s1: buck1 {
							regulator-name = "buck1";
							regulator-min-microvolt = <735000>;
							regulator-max-microvolt = <960000>;
							regulator-always-on;
							regulator-boot-on;
						};

						/* NSP_CX */
						ipq9650_s2: buck2 {
							regulator-name = "buck2";
							regulator-min-microvolt = <735000>;
							regulator-max-microvolt = <960000>;
						};

						/* NSP_MX */
						ipq9650_s4: buck4 {
							regulator-name = "buck4";
							regulator-min-microvolt = <750000>;
							regulator-max-microvolt = <815000>;
						};
					};
				};
			};

			i2c4: i2c@1a9c000 {
				pinctrl-0 = <&qup_i2c4_default>;
				pinctrl-names = "default";
				status = "disabled";
			};

		};

		mdio:mdio@90000 {
			status = "okay";
			/* gpio reset for PHYs */
			phy-reset-gpio = <&tlmm 18 GPIO_ACTIVE_LOW>, /* Reset for QCE2204. */
				<&tlmm 14 GPIO_ACTIVE_LOW>, /* Reset for UNIPHY1 QCA81XXs. */
				<&tlmm 15 GPIO_ACTIVE_LOW>; /* Reset for UNIPHY2 QCA81XXs. */
			ethernet-phy-package@0 {
				compatible = "qcom,qce1204-package";
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0>;
				qcom,package-mode = "internal";
				/delete-property/ clocks;
				/delete-property/ clock-names;
				/delete-property/ resets;
				/delete-property/ reset-names;
				phy0: ethernet-phy@0 {
					compatible = "ethernet-phy-ieee802.3-c45";
					reg = <0x0>;
					clocks = <&qce2204_cc QCE2204_NSSCC_MAC1_GEPHY0_TX_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_MAC1_GEPHY0_RX_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_GEPHY0_SYS_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_MAC1_TX_CLK_SRC>,
						 <&qce2204_cc QCE2204_NSSCC_MAC1_RX_CLK_SRC>;
					clock-names = "tx_clk",
						      "rx_clk",
						      "sys_clk",
						      "tx_src_clk",
						      "rx_src_clk";
					resets = <&qce2204_cc QCE2204_NSSCC_MAC1_GEPHY0_TX_ARES>,
						 <&qce2204_cc QCE2204_NSSCC_MAC1_GEPHY0_RX_ARES>,
						 <&qce2204_cc QCE2204_NSSCC_GEPHY0_SYS_ARES>;
					reset-names = "tx_reset",
						      "rx_reset",
						      "sys_reset";
				};

				phy1: ethernet-phy@1 {
					compatible = "ethernet-phy-ieee802.3-c45";
					reg = <0x1>;
					clocks = <&qce2204_cc QCE2204_NSSCC_MAC2_GEPHY1_TX_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_MAC2_GEPHY1_RX_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_GEPHY1_SYS_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_MAC2_TX_CLK_SRC>,
						 <&qce2204_cc QCE2204_NSSCC_MAC2_RX_CLK_SRC>;
					clock-names = "tx_clk",
						      "rx_clk",
						      "sys_clk",
						      "tx_src_clk",
						      "rx_src_clk";
					resets = <&qce2204_cc QCE2204_NSSCC_MAC2_GEPHY1_TX_ARES>,
						 <&qce2204_cc QCE2204_NSSCC_MAC2_GEPHY1_RX_ARES>,
						 <&qce2204_cc QCE2204_NSSCC_GEPHY1_SYS_ARES>;
					reset-names = "tx_reset",
						      "rx_reset",
						      "sys_reset";
				};

				phy2: ethernet-phy@2 {
					compatible = "ethernet-phy-ieee802.3-c45";
					reg = <0x2>;
					clocks = <&qce2204_cc QCE2204_NSSCC_MAC3_GEPHY2_TX_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_MAC3_GEPHY2_RX_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_GEPHY2_SYS_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_MAC3_TX_CLK_SRC>,
						 <&qce2204_cc QCE2204_NSSCC_MAC3_RX_CLK_SRC>;
					clock-names = "tx_clk",
						      "rx_clk",
						      "sys_clk",
						      "tx_src_clk",
						      "rx_src_clk";
					resets = <&qce2204_cc QCE2204_NSSCC_MAC3_GEPHY2_TX_ARES>,
						 <&qce2204_cc QCE2204_NSSCC_MAC3_GEPHY2_RX_ARES>,
						 <&qce2204_cc QCE2204_NSSCC_GEPHY2_SYS_ARES>;
					reset-names = "tx_reset",
						      "rx_reset",
						      "sys_reset";
				};

				phy3: ethernet-phy@3 {
					compatible = "ethernet-phy-ieee802.3-c45";
					reg = <0x3>;
					clocks = <&qce2204_cc QCE2204_NSSCC_MAC4_GEPHY3_TX_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_MAC4_GEPHY3_RX_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_GEPHY3_SYS_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_MAC4_TX_CLK_SRC>,
						 <&qce2204_cc QCE2204_NSSCC_MAC4_RX_CLK_SRC>;
					clock-names = "tx_clk",
						      "rx_clk",
						      "sys_clk",
						      "tx_src_clk",
						      "rx_src_clk";
					resets = <&qce2204_cc QCE2204_NSSCC_MAC4_GEPHY3_TX_ARES>,
						 <&qce2204_cc QCE2204_NSSCC_MAC4_GEPHY3_RX_ARES>,
						 <&qce2204_cc QCE2204_NSSCC_GEPHY3_SYS_ARES>;
					reset-names = "tx_reset",
						      "rx_reset",
						      "sys_reset";
				};
			};

			qce2204_pcs0: ethernet-phy@4 {
				compatible = "qcom,qce2204-pcs";
				reg = <4>;
				clocks = <&qce2204_cc QCE2204_NSSCC_SRDS0_SYS_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_MAC5_RX_SRDS0_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_MAC5_TX_SRDS0_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_MAC5_RX_SRDS0_CH0_XGMII_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_MAC5_TX_SRDS0_CH0_XGMII_CLK>;
				clock-names = "sys",
					      "rx",
					      "tx",
					      "xgmii_rx",
					      "xgmii_tx";
				resets = <&qce2204_cc QCE2204_NSSCC_SRDS0_SYS_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC5_RX_SRDS0_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC5_TX_SRDS0_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC5_RX_SRDS0_CH0_XGMII_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC5_TX_SRDS0_CH0_XGMII_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_SRDS0_XPCS_ARES>;
				reset-names = "sys",
					      "rx",
					      "tx",
					      "xgmii_rx",
					      "xgmii_tx",
					      "xpcs";
				initial_mode = "usxgmii";
				#clock-cells = <1>;
				assigned-clocks = <&qce2204_cc QCE2204_NSSCC_SRDS0_SYS_CLK>;
				assigned-clock-rates = <25000000>;
			};

			qce2204_pcs1: ethernet-phy@5 {
				compatible = "qcom,qce2204-pcs";
				reg = <5>;
				qcom,overspeed;
				clocks = <&qce2204_cc QCE2204_NSSCC_SRDS1_SYS_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_MAC1_SRDS1_CH0_RX_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_MAC1_SRDS1_CH0_TX_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_MAC0_1_SRDS1_CH0_XGMII_RX_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_MAC0_1_SRDS1_CH0_XGMII_TX_CLK>;
				clock-names = "sys",
					      "rx",
					      "tx",
					      "xgmii_rx",
					      "xgmii_tx";
				resets = <&qce2204_cc QCE2204_NSSCC_SRDS1_SYS_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC1_SRDS1_CH0_RX_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC1_SRDS1_CH0_TX_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC0_1_SRDS1_CH0_XGMII_RX_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC0_1_SRDS1_CH0_XGMII_TX_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_SRDS1_XPCS_ARES>;
				reset-names = "sys",
					      "rx",
					      "tx",
					      "xgmii_rx",
					      "xgmii_tx",
					      "xpcs";
				initial_mode = "10gbase-r";
				#clock-cells = <1>;
				assigned-clocks = <&qce2204_cc QCE2204_NSSCC_SRDS1_SYS_CLK>;
				assigned-clock-rates = <25000000>;
			};

			phy4: ethernet-phy@8 {
				compatible = "ethernet-phy-ieee802.3-c45";
				reg = <8>;
			};
			phy5: ethernet-phy@c {
				compatible = "ethernet-phy-ieee802.3-c45";
				reg = <12>;
			};
			/* Laguna pluggable module on QCE2204 port5 */
			phy6: ethernet-phy@11 {
				reg = <16>;
				compatible = "ethernet-phy-ieee802.3-c45";
			};

			/delete-node/ clock-controller@6;
			qce2204_cc: clock-controller@6 {
				compatible = "qcom,qce2204-nsscc";
				reg = <6>;
				#clock-cells = <1>;
				#reset-cells = <1>;
				clocks = <&qce2204_xo>,
					 <&qce2204_pcs0 QCE2204_PCS_RX_CLK>,
					 <&qce2204_pcs0 QCE2204_PCS_TX_CLK>,
					 <&qce2204_pcs1 QCE2204_PCS_RX_CLK>,
					 <&qce2204_pcs1 QCE2204_PCS_TX_CLK>,
					 <&qce2204_uniphy1_ppe_250m>,
					 <0>,
					 <0>,
					 <0>,
					 <&qce2204_uniphy1_tx_312p5m>;
				clock-names = "xo",
					      "uniphy0_rx",
					      "uniphy0_tx",
					      "uniphy1_rx",
					      "uniphy1_tx",
					      "uniphy1_ppe_250m",
					      "uniphy0_rx_312p5m",
					      "uniphy0_tx_312p5m",
					      "uniphy1_rx_312p5m",
					      "uniphy1_tx_312p5m";
				assigned-clocks = <&qce2204_cc QCE2204_NSSCC_SRDS0_RX_MUX_SEL>,
					      <&qce2204_cc QCE2204_NSSCC_SRDS0_TX_MUX_SEL>,
					      <&qce2204_cc QCE2204_NSSCC_SRDS0_XGMII_RX_MUX_SEL>,
					      <&qce2204_cc QCE2204_NSSCC_SRDS0_XGMII_TX_MUX_SEL>;
				assigned-clock-parents = <&qce2204_cc QCE2204_NSSCC_MAC5_RX_DIV_CLK_SRC>,
					      <&qce2204_cc QCE2204_NSSCC_MAC5_TX_DIV_CLK_SRC>,
					      <&qce2204_cc QCE2204_NSSCC_MAC5_RX_DIV_CLK_SRC>,
					      <&qce2204_cc QCE2204_NSSCC_MAC5_TX_DIV_CLK_SRC>;
			};

			switch0@7 {
				compatible = "qcom,qce2204";
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0x7>;
				status = "okay";

				clocks = <&qce2204_cc QCE2204_NSSCC_AHB_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_SWITCH_CORE_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_SWITCH_IPE_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_SWITCH_BTQ_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_SWITCH_CFG_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_APB_BRIDGE_CLK>;
				clock-names = "ahb",
					      "core",
					      "ipe",
					      "btq",
					      "cfg",
					      "apb";
				resets = <&qce2204_cc QCE2204_NSSCC_SWITCH_CORE_BCR>,
					<&qce2204_cc QCE2204_NSSCC_SWITCH_CORE_ARES>,
					<&qce2204_cc QCE2204_NSSCC_SWITCH_CFG_ARES>;
				reset-names = "core",
						"core_clk_reset",
						"cfg_clk_reset";

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;
						label = "cpu";
						ethernet = <&gmac2>;
						dsa-tag-protocol = "qca_8021q";
						phy-mode = "10gbase-r";
						pcsphy-handle = <&qce2204_pcs1>;
						clocks = <&qce2204_cc QCE2204_NSSCC_MAC0_TX_CLK>,
							 <&qce2204_cc QCE2204_NSSCC_MAC0_RX_CLK>;
						clock-names = "tx",
							      "rx";
						resets = <&qce2204_cc QCE2204_NSSCC_MAC0_TX_ARES>,
							 <&qce2204_cc QCE2204_NSSCC_MAC0_RX_ARES>;
						reset-names = "tx",
							      "rx";
						fixed-link {
							speed = <10000>;
							full-duplex;
							pause;
						};
					};

					port@1 {
						reg = <1>;
						label = "lan1";
						phy-handle = <&phy0>;
						phy-mode = "internal";
						clocks = <&qce2204_cc QCE2204_NSSCC_MAC1_TX_CLK>,
							 <&qce2204_cc QCE2204_NSSCC_MAC1_RX_CLK>;
						clock-names = "tx",
							      "rx";
						resets = <&qce2204_cc QCE2204_NSSCC_MAC1_TX_ARES>,
							 <&qce2204_cc QCE2204_NSSCC_MAC1_RX_ARES>;
						reset-names = "tx",
							      "rx";
					};

					port@2 {
						reg = <2>;
						label = "lan2";
						phy-handle = <&phy1>;
						phy-mode = "internal";
						clocks = <&qce2204_cc QCE2204_NSSCC_MAC2_TX_CLK>,
							 <&qce2204_cc QCE2204_NSSCC_MAC2_RX_CLK>;
						clock-names = "tx",
							      "rx";
						resets = <&qce2204_cc QCE2204_NSSCC_MAC2_TX_ARES>,
							 <&qce2204_cc QCE2204_NSSCC_MAC2_RX_ARES>;
						reset-names = "tx",
							      "rx";
					};

					port@3 {
						reg = <3>;
						label = "lan3";
						phy-handle = <&phy2>;
						phy-mode = "internal";
						clocks = <&qce2204_cc QCE2204_NSSCC_MAC3_TX_CLK>,
							 <&qce2204_cc QCE2204_NSSCC_MAC3_RX_CLK>;
						clock-names = "tx",
							      "rx";
						resets = <&qce2204_cc QCE2204_NSSCC_MAC3_TX_ARES>,
							 <&qce2204_cc QCE2204_NSSCC_MAC3_RX_ARES>;
						reset-names = "tx",
							      "rx";
					};

					port@4 {
						reg = <4>;
						label = "lan4";
						phy-handle = <&phy3>;
						phy-mode = "internal";
						clocks = <&qce2204_cc QCE2204_NSSCC_MAC4_TX_CLK>,
							 <&qce2204_cc QCE2204_NSSCC_MAC4_RX_CLK>;
						clock-names = "tx",
							      "rx";
						resets = <&qce2204_cc QCE2204_NSSCC_MAC4_TX_ARES>,
							 <&qce2204_cc QCE2204_NSSCC_MAC4_RX_ARES>;
						reset-names = "tx",
							      "rx";
					};
					port@5 {
						reg = <5>;
						label = "lan5";
						phy-handle = <&phy6>;
						pcsphy-handle = <&qce2204_pcs0>;
						phy-mode = "usxgmii";
						clocks = <&qce2204_cc QCE2204_NSSCC_MAC5_TX_CLK>,
							 <&qce2204_cc QCE2204_NSSCC_MAC5_RX_CLK>;
						clock-names = "tx",
							      "rx";
						resets = <&qce2204_cc QCE2204_NSSCC_MAC5_TX_ARES>,
							 <&qce2204_cc QCE2204_NSSCC_MAC5_RX_ARES>;
						reset-names = "tx",
							      "rx";
					};
				};
			};
		};

		ess-instance {
			num_devices = <0x2>;

			ess_switch: ess-switch@2a000000 {
				switch_lan_bmp = <0x22>; /* lan port bitmap */
				switch_wan_bmp = <0x40>; /* wan port bitmap */
				switch_mac_mode = <0xe>; /* 10GR for qce2204 */
				switch_mac_mode1 = <0xd>; /* USXGMII for Laguna PHY */
				switch_mac_mode2 = <0xd>; /* USXGMII for Laguna PHY */
				tm_tick_mode = <0>; /* 3x10G */

				qcom,port_phyinfo {
					/delete-node/ port@0;
					/delete-node/ port@1;
					/delete-node/ port@2;
					/delete-node/ port@3;
					port@0 {
						port_id = <1>;
						forced-speed = <10000>;
						forced-duplex = <1>;
						switch_external {
							switch_handle = <&switch1>;
							switch_cpu_port = <0>;
						};
						fixed-link {
							speed = <10000>;
							full-duplex;
							pause;
						};
					};
					port@4 {
						port_id = <5>;
						phy_address = <8>;
						phy-handle = <&phy4>;
						phy-mode = "usxgmii";
						ethernet-phy-ieee802.3-c45;
					};
					port@5 {
						port_id = <6>;
						phy_address = <12>;
						phy-handle = <&phy5>;
						phy-mode = "usxgmii";
						ethernet-phy-ieee802.3-c45;
					};
				};
			};
			switch1:ess-switch1@1 {
#ifdef __CONFIG_IO_COHERENCY__
				dma-coherent;
#endif
				compatible = "qcom,ess-switch-qce22xx";
				device_id = <1>;
				switch_access_mode = "mdio";
				mdio-bus = <&mdio>;
				reg = <0x7>;
				switch_lan_bmp = <0x3e>;
				switch_cpu_bmp = <0x1>;  /* cpu port bitmap */
				switch_mac_mode = <0xe>;
				switch_mac_mode1 = <0xd>; /* USXGMII for Laguna pluggable module */
				qcom,port_phyinfo {
					port@0 {
						port_id = <0>;
						forced-speed = <10000>;
						forced-duplex = <1>;
					};
					port@1 {
						port_id = <1>;
						phy_address = <0>;
						ethernet-phy-ieee802.3-c45;
					};
					port@2 {
						port_id = <2>;
						phy_address = <1>;
						ethernet-phy-ieee802.3-c45;
					};
					port@3 {
						port_id = <3>;
						phy_address = <2>;
						ethernet-phy-ieee802.3-c45;
					};
					port@4 {
						port_id = <4>;
						phy_address = <3>;
						ethernet-phy-ieee802.3-c45;
					};
					port@5 {
						port_id = <5>;
						phy_address = <16>;
						ethernet-phy-ieee802.3-c45;
					};
				};
			};
		};
		gmac2:dp1 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <1>;
			reg = <0x2a500000 0x4000>;
			qcom,mactype = <1>;
			local-mac-address = [000000000000];
			qcom,ppe-offload-disabled = <1>;
			pinctrl-0 = <&pps_state>;
			pinctrl-names = "default";
			interrupts = <GIC_SPI 362 IRQ_TYPE_EDGE_RISING 0>;
			interrupt-names = "pps_in";
			clocks = <&nsscc NSS_CC_XGMAC0_PTP_REF_CLK>;
			clock-names = "ptp";
			qcom,mht-dev = <1>;
			qcom,is_switch_connected = <1>;
		};

		dp2 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <5>;
			reg = <0x2a510000 0x4000>;
			qcom,mactype = <1>;
			local-mac-address = [000000000000];
			qcom,ppe-offload-disabled = <0>;
			clocks = <&nsscc NSS_CC_XGMAC4_PTP_REF_CLK>;
			clock-names = "ptp";
		};

		dp3 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <6>;
			reg = <0x2a514000 0x4000>;
			qcom,mactype = <1>;
			local-mac-address = [000000000000];
			qcom,ppe-offload-disabled = <0>;
			clocks = <&nsscc NSS_CC_XGMAC5_PTP_REF_CLK>;
			clock-names = "ptp";
		};
	};
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	status = "okay";
};

&sdhc {
	max-frequency = <192000000>;
	bus-width = <4>;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	non-removable;
	pinctrl-0 = <&sdc_default_state>;
	pinctrl-names = "default";
	status = "disabled";
};

&pcie1_phy {
	status = "okay";
};

&pcie1 {
	perst-gpio = <&tlmm 28 GPIO_ACTIVE_LOW>;
	status = "okay";

	pcie1_rp {
		reg = <0 0 0 0 0>;

		qcom,mhi@0 {
			reg = <0 0 0 0 0>;
		};
	};
};

&pcie2_phy {
	status = "okay";
};

&pcie2 {
	perst-gpio = <&tlmm 52 GPIO_ACTIVE_LOW>;
	status = "okay";

	pcie2_rp {
		reg = <0 0 0 0 0>;

		qcom,mhi@0 {
			reg = <0 0 0 0 0>;
		};
	};
};

&pcie3_phy {
	status = "okay";
};

&pcie3 {
	perst-gpio = <&tlmm 41 GPIO_ACTIVE_LOW>;
	status = "okay";

	pcie3_rp {
		reg = <0 0 0 0 0>;

		qcom,mhi@0 {
			reg = <0 0 0 0 0>;
		};
	};
};

&qusb_phy_1 {
	status = "okay";
};

&usb2 {
	status = "okay";
};

&qusb_phy_0 {
	status = "okay";
};

&ssphy_0 {
	status = "okay";
};

&usb3 {
	status = "okay";
};

&tlmm {
	qup_i2c0_default: qup-i2c0-default-state {
		qup_i2c0_scl {
			pins = "gpio10";
			function = "qup_se1_l1";
			drive-strength = <8>;
			bias-pull-down;
		};
		qup_i2c0_sda {
			pins = "gpio11";
			function = "qup_se1_l0";
			drive-strength = <8>;
			bias-pull-down;
		};
	};

	qup_i2c1_default: qup-i2c1-default-state {
		qup_i2c1_scl {
			pins = "gpio33";
			function = "qup_se2_l1";
			drive-strength = <8>;
			bias-pull-up;
		};
		qup_i2c1_sda {
			pins = "gpio34";
			function = "qup_se2_l0";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	qup_i2c4_default: qup-i2c4-default-state {
		qup_i2c4_scl {
			pins = "gpio39";
			function = "qup_se7_l1";
			drive-strength = <8>;
			bias-pull-down;
		};
		qup_i2c4_sda {
			pins = "gpio38";
			function = "qup_se7_l0";
			drive-strength = <8>;
			bias-pull-down;
		};
	};

	pcie0_default_state: pcie0-default-state {
		perst-n-pins {
			pins = "gpio25";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
			output-low;
		};
	};

	pcie1_default_state: pcie1-default-state {
		perst-n-pins {
			pins = "gpio28";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
			output-low;
		};
	};

	pcie2_default_state: pcie2-default-state {
		perst-n-pins {
			pins = "gpio52";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
			output-low;
		};
	};

	pcie3_default_state: pcie3-default-state {
		perst-n-pins {
			pins = "gpio41";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
			output-low;
		};
	};

	pcie4_default_state: pcie4-default-state {
		perst-n-pins {
			pins = "gpio31";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
			output-low;
		};
	};

	sdc_default_state: sdc-default-state {
		clk-pins {
			pins = "gpio5";
			function = "sdc_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cmd-pins {
			pins = "gpio4";
			function = "sdc_cmd";
			drive-strength = <8>;
			bias-pull-up;
		};

		data-pins {
			pins = "gpio0", "gpio1", "gpio2", "gpio3";
			function = "sdc_data";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};

&CPU0 {
	cpu-supply = <&ipq9650_s1>;
};

&CPU1 {
	cpu-supply = <&ipq9650_s1>;
};

&CPU2 {
	cpu-supply = <&ipq9650_s1>;
};

&CPU3 {
	cpu-supply = <&ipq9650_s1>;
};

&CPU4 {
	cpu-supply = <&ipq9650_s1>;
};

&cdsp_power {
	vdd-cx-supply = <&ipq9650_s2>;
	vdd-mx-supply = <&ipq9650_s4>;
};

&remoteproc_cdsp {
	cx-supply = <&cdsp_vdd_cx>;
	mx-supply = <&cdsp_vdd_mx>;
};
