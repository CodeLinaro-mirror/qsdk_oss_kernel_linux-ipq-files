/dts-v1/;

#include "ipq5210-rdp-common.dtsi"
#include <dt-bindings/clock/qcom,qce2204-nsscc.h>
#include <dt-bindings/reset/qcom,qce2204-nsscc.h>
#ifdef __IPQ_MEM_PROFILE_512_MB__
#include "ipq5210-512MB-default-memory.dtsi"
#else
#include "ipq5210-default-memory.dtsi"
#endif

/ {
	model = "Qualcomm Technologies, Inc. IPQ5210 RDP499";
	compatible = "qcom,ipq5210-rdp499", "qcom,ipq5210";

	aliases {
		serial0 = &uart1;
		ethernet0 = "/soc/dp1";
		ethernet1 = "/soc/dp2";
		ethernet2 = "/soc/dp3";
		ethernet3 = "/soc/dp4";
		ethernet4 = "/soc/dp5";
		ethernet5 = "/soc/dp6";
	};

	clocks {
		qce2204_xo: qce2204-xo {
			compatible = "fixed-clock";
			clock-frequency = <50000000>;
			#clock-cells = <0>;
		};

		qce2204_uniphy1_rx_312p5m: qce2204-uniphy1-rx-312p5m {
			compatible = "fixed-clock";
			clock-frequency = <312500000>;
			#clock-cells = <0>;
		};

		qce2204_uniphy1_tx_312p5m: qce2204-uniphy1-tx-312p5m {
			compatible = "fixed-clock";
			clock-frequency = <312500000>;
			#clock-cells = <0>;
		};
	};

	soc@0 {
		mdio@90000 {
			status = "okay";
			/* gpio reset for PHYs */
			phy-reset-gpio = <
				&tlmm 24 GPIO_ACTIVE_LOW
				&tlmm 45 GPIO_ACTIVE_LOW
			>;
			ethernet-phy-package@0 {
				compatible = "qcom,qce1204-package";
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0>;
				qcom,package-mode = "qusgmii";
				clocks =<&qce2204_cc QCE2204_NSSCC_SRDS1_SYS_CLK>,
					<&qce2204_cc QCE2204_NSSCC_MAC1_SRDS1_CH0_TX_CLK>,
					<&qce2204_cc QCE2204_NSSCC_MAC1_SRDS1_CH0_RX_CLK>,
					<&qce2204_cc QCE2204_NSSCC_MAC0_1_SRDS1_CH0_XGMII_TX_CLK>,
					<&qce2204_cc QCE2204_NSSCC_MAC0_1_SRDS1_CH0_XGMII_RX_CLK>,
					<&qce2204_cc QCE2204_NSSCC_MAC2_SRDS1_CH1_TX_CLK>,
					<&qce2204_cc QCE2204_NSSCC_MAC2_SRDS1_CH1_RX_CLK>,
					<&qce2204_cc QCE2204_NSSCC_MAC2_SRDS1_CH1_XGMII_TX_CLK>,
					<&qce2204_cc QCE2204_NSSCC_MAC2_SRDS1_CH1_XGMII_RX_CLK>,
					<&qce2204_cc QCE2204_NSSCC_MAC3_SRDS1_CH2_TX_CLK>,
					<&qce2204_cc QCE2204_NSSCC_MAC3_SRDS1_CH2_RX_CLK>,
					<&qce2204_cc QCE2204_NSSCC_MAC3_SRDS1_CH2_XGMII_TX_CLK>,
					<&qce2204_cc QCE2204_NSSCC_MAC3_SRDS1_CH2_XGMII_RX_CLK>,
					<&qce2204_cc QCE2204_NSSCC_MAC4_SRDS1_CH3_TX_CLK>,
					<&qce2204_cc QCE2204_NSSCC_MAC4_SRDS1_CH3_RX_CLK>,
					<&qce2204_cc QCE2204_NSSCC_MAC4_SRDS1_CH3_XGMII_TX_CLK>,
					<&qce2204_cc QCE2204_NSSCC_MAC4_SRDS1_CH3_XGMII_RX_CLK>,
					<&qce2204_cc QCE2204_NSSCC_AHB_CLK>,
					<&qce2204_uniphy1_rx_312p5m>,
					<&qce2204_uniphy1_tx_312p5m>;
				clock-names = "pcs_sys_clk",
					      "ch0_gmii_tx_clk",
					      "ch0_gmii_rx_clk",
					      "ch0_xgmii_tx_clk",
					      "ch0_xgmii_rx_clk",
					      "ch1_gmii_tx_clk",
					      "ch1_gmii_rx_clk",
					      "ch1_xgmii_tx_clk",
					      "ch1_xgmii_rx_clk",
					      "ch2_gmii_tx_clk",
					      "ch2_gmii_rx_clk",
					      "ch2_xgmii_tx_clk",
					      "ch2_xgmii_rx_clk",
					      "ch3_gmii_tx_clk",
					      "ch3_gmii_rx_clk",
					      "ch3_xgmii_tx_clk",
					      "ch3_xgmii_rx_clk",
					      "ahb_clk",
					      "tx_parent",
					      "rx_parent";
				resets = <&qce2204_cc QCE2204_NSSCC_SRDS1_SYS_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC1_SRDS1_CH0_TX_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC1_SRDS1_CH0_RX_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC0_1_SRDS1_CH0_XGMII_TX_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC0_1_SRDS1_CH0_XGMII_RX_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC2_SRDS1_CH1_TX_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC2_SRDS1_CH1_RX_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC2_SRDS1_CH1_XGMII_TX_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC2_SRDS1_CH1_XGMII_RX_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC3_SRDS1_CH2_TX_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC3_SRDS1_CH2_RX_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC3_SRDS1_CH2_XGMII_TX_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC3_SRDS1_CH2_XGMII_RX_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC4_SRDS1_CH3_TX_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC4_SRDS1_CH3_RX_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC4_SRDS1_CH3_XGMII_TX_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC4_SRDS1_CH3_XGMII_RX_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_SRDS1_XPCS_ARES>;
				reset-names = "pcs_sys_reset",
					      "ch0_gmii_tx_reset",
					      "ch0_gmii_rx_reset",
					      "ch0_xgmii_tx_reset",
					      "ch0_xgmii_rx_reset",
					      "ch1_gmii_tx_reset",
					      "ch1_gmii_rx_reset",
					      "ch1_xgmii_tx_reset",
					      "ch1_xgmii_rx_reset",
					      "ch2_gmii_tx_reset",
					      "ch2_gmii_rx_reset",
					      "ch2_xgmii_tx_reset",
					      "ch2_xgmii_rx_reset",
						  "ch3_gmii_tx_reset",
					      "ch3_gmii_rx_reset",
					      "ch3_xgmii_tx_reset",
					      "ch3_xgmii_rx_reset",
					      "xpcs";

				phy0: ethernet-phy@0 {
					compatible = "ethernet-phy-ieee802.3-c45";
					reg = <0x0>;
					clocks = <&qce2204_cc QCE2204_NSSCC_MAC1_GEPHY0_TX_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_MAC1_GEPHY0_RX_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_GEPHY0_SYS_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_MAC1_TX_CLK_SRC>,
						 <&qce2204_cc QCE2204_NSSCC_MAC1_RX_CLK_SRC>;
					clock-names = "tx_clk",
						      "rx_clk",
						      "sys_clk",
						      "tx_src_clk",
						      "rx_src_clk";
					resets = <&qce2204_cc QCE2204_NSSCC_MAC1_GEPHY0_TX_ARES>,
						 <&qce2204_cc QCE2204_NSSCC_MAC1_GEPHY0_RX_ARES>,
						 <&qce2204_cc QCE2204_NSSCC_GEPHY0_SYS_ARES>;
					reset-names = "tx_reset",
						      "rx_reset",
						      "sys_reset";
				};

				phy1: ethernet-phy@1 {
					compatible = "ethernet-phy-ieee802.3-c45";
					reg = <0x1>;
					clocks = <&qce2204_cc QCE2204_NSSCC_MAC2_GEPHY1_TX_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_MAC2_GEPHY1_RX_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_GEPHY1_SYS_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_MAC2_TX_CLK_SRC>,
						 <&qce2204_cc QCE2204_NSSCC_MAC2_RX_CLK_SRC>;
					clock-names = "tx_clk",
						      "rx_clk",
						      "sys_clk",
						      "tx_src_clk",
						      "rx_src_clk";
					resets = <&qce2204_cc QCE2204_NSSCC_MAC2_GEPHY1_TX_ARES>,
						 <&qce2204_cc QCE2204_NSSCC_MAC2_GEPHY1_RX_ARES>,
						 <&qce2204_cc QCE2204_NSSCC_GEPHY1_SYS_ARES>;
					reset-names = "tx_reset",
						      "rx_reset",
						      "sys_reset";
				};

				phy2: ethernet-phy@2 {
					compatible = "ethernet-phy-ieee802.3-c45";
					reg = <0x2>;
					clocks = <&qce2204_cc QCE2204_NSSCC_MAC3_GEPHY2_TX_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_MAC3_GEPHY2_RX_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_GEPHY2_SYS_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_MAC3_TX_CLK_SRC>,
						 <&qce2204_cc QCE2204_NSSCC_MAC3_RX_CLK_SRC>;
					clock-names = "tx_clk",
						      "rx_clk",
						      "sys_clk",
						      "tx_src_clk",
						      "rx_src_clk";
					resets = <&qce2204_cc QCE2204_NSSCC_MAC3_GEPHY2_TX_ARES>,
						 <&qce2204_cc QCE2204_NSSCC_MAC3_GEPHY2_RX_ARES>,
						 <&qce2204_cc QCE2204_NSSCC_GEPHY2_SYS_ARES>;
					reset-names = "tx_reset",
						      "rx_reset",
						      "sys_reset";
				};

				phy3: ethernet-phy@3 {
					compatible = "ethernet-phy-ieee802.3-c45";
					reg = <0x3>;
					clocks = <&qce2204_cc QCE2204_NSSCC_MAC4_GEPHY3_TX_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_MAC4_GEPHY3_RX_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_GEPHY3_SYS_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_MAC4_TX_CLK_SRC>,
						 <&qce2204_cc QCE2204_NSSCC_MAC4_RX_CLK_SRC>;
					clock-names = "tx_clk",
						      "rx_clk",
						      "sys_clk",
						      "tx_src_clk",
						      "rx_src_clk";
					resets = <&qce2204_cc QCE2204_NSSCC_MAC4_GEPHY3_TX_ARES>,
						 <&qce2204_cc QCE2204_NSSCC_MAC4_GEPHY3_RX_ARES>,
						 <&qce2204_cc QCE2204_NSSCC_GEPHY3_SYS_ARES>;
					reset-names = "tx_reset",
						      "rx_reset",
						      "sys_reset";
				};
			};

			phy4: ethernet-phy@8 {
				reg = <8>;
				compatible ="ethernet-phy-ieee802.3-c45";
			};

			/* Clock controller */
			qce2204_cc: clock-controller@6 {
				compatible = "qcom,qce2204-nsscc";
				reg = <6>;
				#clock-cells = <1>;
				#reset-cells = <1>;
				clocks = <&qce2204_xo>,
					 <0>,
					 <0>,
					 <0>,
					 <0>,
					 <0>,
					 <0>,
					 <0>,
					 <&qce2204_uniphy1_rx_312p5m>,
					 <&qce2204_uniphy1_tx_312p5m>;
				clock-names = "xo",
					      "uniphy0_rx",
					      "uniphy0_tx",
					      "uniphy1_rx",
					      "uniphy1_tx",
					      "uniphy1_ppe_250m",
					      "uniphy0_rx_312p5m",
					      "uniphy0_tx_312p5m",
					      "uniphy1_rx_312p5m",
					      "uniphy1_tx_312p5m";
				assigned-clocks = <&qce2204_cc QCE2204_NSSCC_SRDS1_RX_MUX_SEL>,
						  <&qce2204_cc QCE2204_NSSCC_SRDS1_TX_MUX_SEL>,
						  <&qce2204_cc QCE2204_NSSCC_SRDS1_XGMII_RX_MUX_SEL>,
						  <&qce2204_cc QCE2204_NSSCC_SRDS1_XGMII_TX_MUX_SEL>;
				assigned-clock-parents = <&qce2204_cc QCE2204_NSSCC_MAC1_TX_DIV_CLK_SRC>,
							 <&qce2204_cc QCE2204_NSSCC_MAC1_RX_DIV_CLK_SRC>,
							 <&qce2204_cc QCE2204_NSSCC_MAC1_SRDS1_CH0_XGMII_RX_DIV_CLK_SRC>,
							 <&qce2204_cc QCE2204_NSSCC_MAC1_SRDS1_CH0_XGMII_TX_DIV_CLK_SRC>;
			};
		};

		ess-instance {
			num_devices = <0x1>;

			ess_switch: ess-switch@3a000000 {
				switch_lan_bmp = <0x3e>; /* lan port bitmap */
				switch_wan_bmp = <0x40>; /* wan port bitmap */
				switch_mac_mode = <0x15>; /* UQXGMII for qce1204 PHY */
				switch_mac_mode1 = <0xd>; /* USXGMII for Laguna PHY */
				switch_mac_mode2 = <0xff>;

				qcom,port_phyinfo {
					port@0 {
						port_id = <1>;
						phy_address = <0>;
						phy-handle = <&phy0>;
						phy-mode = "qusgmii";
						port_mac_sel = "QGMAC_PORT";
						ethernet-phy-ieee802.3-c45;
					};
					port@1 {
						port_id = <2>;
						phy_address = <1>;
						phy-handle = <&phy1>;
						phy-mode = "qusgmii";
						port_mac_sel = "QGMAC_PORT";
						ethernet-phy-ieee802.3-c45;
					};
					port@2 {
						port_id = <3>;
						phy_address = <2>;
						phy-handle = <&phy2>;
						phy-mode = "qusgmii";
						port_mac_sel = "QGMAC_PORT";
						ethernet-phy-ieee802.3-c45;
					};
					port@3 {
						port_id = <4>;
						phy_address = <3>;
						phy-handle = <&phy3>;
						phy-mode = "qusgmii";
						port_mac_sel = "QGMAC_PORT";
						ethernet-phy-ieee802.3-c45;
					};
					port@4 {
						port_id = <5>;
						phy_address = <8>;
						phy-handle = <&phy4>;
						phy-mode = "usxgmii";
						ethernet-phy-ieee802.3-c45;
					};
					port@5 {
						port_id = <6>;
						forced-speed = <10000>;
						forced-duplex = <1>;
						fixed-link {
							speed = <10000>;
							full-duplex;
							pause;
						};
					};
				};
			};
		};

		dp1 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <1>;
			reg = <0x3a001000 0x200>;
			qcom,mactype = <0>;
			local-mac-address = [000000000000];
			qcom,ppe-offload-disabled = <0>;
		};

		dp2 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <2>;
			reg = <0x3a001200 0x200>;
			qcom,mactype = <0>;
			local-mac-address = [000000000000];
			qcom,ppe-offload-disabled = <0>;
		};


		dp3 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <3>;
			reg = <0x3a001400 0x200>;
			qcom,mactype = <0>;
			local-mac-address = [000000000000];
			qcom,ppe-offload-disabled = <0>;
		};

		dp4 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <4>;
			reg = <0x3a001600 0x200>;
			qcom,mactype = <0>;
			local-mac-address = [000000000000];
			qcom,ppe-offload-disabled = <0>;
		};

		dp5 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <5>;
			reg = <0x3a504000 0x4000>;
			qcom,mactype = <1>;
			local-mac-address = [000000000000];
			qcom,ppe-offload-disabled = <0>;
			pinctrl-0 = <&pps_state>;
			pinctrl-names = "default";
			interrupts = <GIC_SPI 359 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "pps_in";
			clocks = <&nsscc NSS_CC_XGMAC1_PTP_REF_CLK>;
			clock-names = "ptp";
		};

		dp6 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <6>;
			reg = <0x3a508000 0x4000>;
			qcom,mactype = <1>;
			local-mac-address = [000000000000];
			qcom,ppe-offload-disabled = <0>;
			qcom,gem_port = <1>;
			clocks = <&nsscc NSS_CC_XGMAC2_PTP_REF_CLK>;
			clock-names = "ptp";
		};
	};
};

&i2c0 {
	clock-frequency = <100000>;

	status = "okay";
};

&tlmm {
	audio_pins_pri: audio_pinmux_pri {
		mux_1 {
			pins = "gpio34";
			function = "audio_pri_d0";
			drive-strength = <16>;
			bias-pull-down;
		};

		mux_2 {
		    pins = "gpio35";
		    function = "audio_pri_d1";
		    drive-strength = <8>;
		    bias-pull-down;
		};

		mux_3 {
		    pins = "gpio36";
		    function = "audio_pri_fsync";
		    drive-strength = <8>;
		    bias-pull-down;
		};

		mux_4 {
		    pins = "gpio37";
		    function = "audio_pri_pclk";
		    drive-strength = <8>;
		    bias-pull-down;
		};
	};

	pcie0_default_state: pcie0-default-state {
		pins = "gpio32";
		function = "gpio";
		drive-strength = <6>;
		bias-pull-down;
		output-low;
	};

	se4_spi_pins: se4-spi-pins {
		spi_clk {
			pins = "gpio40";
			function = "qup_se4_l2";
			drive-strength = <4>;
			bias-pull-down;
		};
		spi_cs {
			pins = "gpio41";
			function = "qup_se4_l3";
			drive-strength = <4>;
			bias-pull-up;
		};
		spi_miso {
			pins = "gpio42";
			function = "qup_se4_l0";
			drive-strength = <16>;
			bias-pull-down;
		};
		spi_mosi {
			pins = "gpio43";
			function = "qup_se4_l1";
			drive-strength = <16>;
			bias-pull-down;
		};
	};
};

&spi1 {
	compatible = "qcom,geni-spi";
	pinctrl-0 = <&se4_spi_pins>;
	pinctrl-names = "default";
	status = "disabled";

	spidev1: spi@0 {
		compatible = "qti,spidev";
		reg = <0>;
		spi-max-frequency = <9600000>;
	};
};

&pcm {
	pinctrl-0 = <&audio_pins_pri>;
	pinctrl-names = "primary";
	status = "disabled";
};

&pcie0_phy {
	status = "okay";
};

&pcie0 {
	pinctrl-0 = <&pcie0_default_state>;
	perst-gpio = <&tlmm 32 GPIO_ACTIVE_LOW>;
	status = "okay";

	pcie0_rp {
		reg = <0 0 0 0 0>;
		qcom,mhi@0 {
			reg = <0 0 0 0 0>;
			memory-region = <&qcn9625_pcie0>, <&mlo_global_mem0>;
			memory-region-names = "host-ddr-mem", "mlo-global-mem";
			qcom,board_id = <0x5010>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
				};

				port@1 {
					reg = <1>;
				};
			};

		};
	};
};

&qcn9625_pcie0 {
	status = "okay";
};

&mlo_global_mem0 {
	status = "okay";
};

&ess_uniphy {
	assigned-clocks = <&nsscc NSS_CC_PORT4_RX_CLK_SRC>,
			  <&nsscc NSS_CC_PORT4_TX_CLK_SRC>;
	assigned-clock-parents = <&ess_uniphy 0>,
				 <&ess_uniphy 1>;
};
