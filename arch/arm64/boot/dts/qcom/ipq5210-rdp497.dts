/dts-v1/;

#include "ipq5210-rdp-common.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. IPQ5210 RDP497";
	compatible = "qcom,ipq5210-rdp497", "qcom,ipq5210";

	aliases {
		serial0 = &uart1;
		ethernet0 = "/soc/dp1";
		ethernet1 = "/soc/dp2";
		ethernet2 = "/soc/dp3";
	};

	soc@0 {
		mdio@90000 {
			status = "okay";
			/* gpio reset for Laguna PHY */
			phy-reset-gpio = <&tlmm 24 GPIO_ACTIVE_LOW>;

			phy0: ethernet-phy@8 {
				reg = <8>;
				compatible ="ethernet-phy-ieee802.3-c45";
			};
		};

		mdio_ahb: mdio-ahb@1400000 {
			status = "okay";
			compatible = "qcom,mdio-ahb-ipq52xx";
			reg = <0x1400000 0x200000>;  /* Base address: 0x1400000, Size: 2MB */
			clocks = <&gcc GCC_MDIO_GEPHY_AHB_CLK>,
				<&gcc GCC_GEPHY_SYS_CLK>,
				<&nsscc NSS_CC_EPHY_RX_CLK>,
				<&nsscc NSS_CC_EPHY_TX_CLK>,
				<&cmn_pll IPQ5210_EPHY_RAW_CLK>;
			clock-names = "mdio_gephy_ahb_clk",
				"gephy_sys_clk",
				"gephy_rx_clk",
				"gephy_tx_clk",
				"gephy_raw_clk";

			resets = <&gcc GCC_GEPHY_SYS_ARES>,
				 <&nsscc NSS_CC_EPHY_RX_CLK_ARES>,
				 <&nsscc NSS_CC_EPHY_TX_CLK_ARES>;
			reset-names = "gephy_sys_reset",
				 "gephy_rx_reset",
				 "gephy_tx_reset";

			pinctrl-0 = <&phy_led0>;
			pinctrl-names = "default";
		};

		ess-instance {
			num_devices = <0x1>;

			ess_switch: ess-switch@3a000000 {
				switch_lan_bmp = <0x12>; /* lan port bitmap */
				switch_wan_bmp = <0x40>; /* wan port bitmap */
				switch_mac_mode = <0xd>; /* USXGMII for Laguna PHY */
				switch_mac_mode1 = <0xff>; /* unused */
				switch_mac_mode2 = <0xff>;
				tm_tick_mode = <1>; /* 3 X 10G TM mode */

				qcom,port_phyinfo {
					port@0 {
						port_id = <1>;
						phy_address = <8>;
						phy-handle = <&phy0>;
						phy-mode = "usxgmii";
						ethernet-phy-ieee802.3-c45;
					};
					port@3 {
						port_id = <4>;
						phy-mode = "internal";
					};
					port@5 {
						port_id = <6>;
						forced-speed = <10000>;
						forced-duplex = <1>;
						fixed-link {
							speed = <10000>;
							full-duplex;
							pause;
						};
					};
				};
			};
		};

		dp1 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <1>;
			reg = <0x3a500000 0x4000>;
			qcom,mactype = <1>;
			local-mac-address = [000000000000];
			qcom,ppe-offload-disabled = <0>;
			pinctrl-0 = <&pps_state>;
			pinctrl-names = "default";
			interrupts = <GIC_SPI 359 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "pps_in";
			clocks = <&nsscc NSS_CC_XGMAC0_PTP_REF_CLK>;
			clock-names = "ptp";
		};

		dp2 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <4>;
			reg = <0x3a001600 0x200>;
			qcom,mactype = <0>;
			local-mac-address = [000000000000];
			qcom,ppe-offload-disabled = <0>;
		};

		dp3 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <6>;
			reg = <0x3a508000 0x4000>;
			qcom,mactype = <1>;
			local-mac-address = [000000000000];
			qcom,ppe-offload-disabled = <0>;
			qcom,gem_port = <1>;
			clocks = <&nsscc NSS_CC_XGMAC2_PTP_REF_CLK>;
			clock-names = "ptp";
		};
	};
};

&i2c0 {
	clock-frequency = <100000>;

	status = "okay";
};

&i2c2 {
	pinctrl-0 = <&qup_i2c2_default>;
	pinctrl-names = "default";
	clock-frequency = <100000>;

	status = "okay";
};

&nsscc {
	assigned-clocks = <&nsscc NSS_CC_EPHY_RX_CLK_SRC>,
			  <&nsscc NSS_CC_EPHY_TX_CLK_SRC>;
	assigned-clock-parents = <&nsscc NSS_CC_PORT4_RX_DIV_CLK_SRC>,
				 <&nsscc NSS_CC_PORT4_TX_DIV_CLK_SRC>;
};

&spi1 {
	compatible = "qcom,geni-spi";
	pinctrl-0 = <&se4_spi_pins>;
	pinctrl-names = "default";
	status = "disabled";

	spidev1: spi@0 {
		compatible = "qti,spidev";
		reg = <0>;
		spi-max-frequency = <9600000>;
	};
};

&pcm {
	pinctrl-0 = <&audio_pins_pri>;
	pinctrl-1 = <&audio_pins_sec>;
	pinctrl-names = "primary",
			"secondary";
	status = "disabled";
};

&tlmm {
	audio_pins_pri: audio_pinmux_pri {
		mux_1 {
			pins = "gpio34";
			function = "audio_pri_d0";
			drive-strength = <16>;
			bias-pull-down;
		};

		mux_2 {
			pins = "gpio35";
			function = "audio_pri_d1";
			drive-strength = <8>;
			bias-pull-down;
		};

		mux_3 {
			pins = "gpio36";
			function = "audio_pri_fsync";
			drive-strength = <8>;
			bias-pull-down;
		};

		mux_4 {
			pins = "gpio37";
			function = "audio_pri_pclk";
			drive-strength = <8>;
			bias-pull-down;
		};
	};

	audio_pins_sec: audio_pinmux_sec {
		mux_1 {
			pins = "gpio43";
			function = "audio_sec_d0";
			drive-strength = <16>;
			bias-pull-down;
		};

		mux_2 {
			pins = "gpio42";
			function = "audio_sec_d1";
			drive-strength = <8>;
			bias-pull-down;
		};

		mux_3 {
			pins = "gpio40";
			function = "audio_sec_fsync";
			drive-strength = <8>;
			bias-pull-down;
		};

		mux_4 {
			pins = "gpio41";
			function = "audio_sec_pclk";
			drive-strength = <8>;
			bias-pull-down;
		};
	};

	qup_i2c2_default: qup-i2c2-default-state {
		qup_i2c2_scl {
			pins = "gpio52";
			function = "qup_se5_l01";
			drive-strength = <6>;
			bias-pull-up;
		};

		qup_i2c2_sda {
			pins = "gpio53";
			function = "qup_se5_l11";
			drive-strength = <6>;
			bias-pull-up;
		};
	};

	phy_led0: phy-led0-state {
		pins = "gpio23";
		function = "Led00";
		drive-strength = <2>;
		bias-pull-down;
	};

	mdio-state {
		mux_0 {
			drive-strength = <4>;
		};

		mux_1 {
			drive-strength = <4>;
		};
	};

	se4_spi_pins: se4-spi-pins {
		spi_clk {
			pins = "gpio40";
			function = "qup_se4_l2";
			drive-strength = <4>;
			bias-pull-down;
		};
		spi_cs {
			pins = "gpio41";
			function = "qup_se4_l3";
			drive-strength = <4>;
			bias-pull-up;
		};
		spi_miso {
			pins = "gpio42";
			function = "qup_se4_l0";
			drive-strength = <16>;
			bias-pull-down;
		};
		spi_mosi {
			pins = "gpio43";
			function = "qup_se4_l1";
			drive-strength = <16>;
			bias-pull-down;
		};
	};
};
