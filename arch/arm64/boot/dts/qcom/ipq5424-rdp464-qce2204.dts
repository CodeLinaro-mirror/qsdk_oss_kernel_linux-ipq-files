&mhi_region1 {
	status = "okay";
};

&mhi_region2 {
	status = "okay";
};

&mhi_region3 {
	status = "okay";
};
#endif

&mlo_global_mem0 {
#if defined(__IPQ_MEM_PROFILE_512_MB__)
	reg = <0x0 0x96e00000 0x0 0x1800000>;
	status = "okay";
#else
	reg = <0x0 0x9b500000 0x0 0x1800000>;
	status = "okay";
#endif
};

/* 2G radio */
&wifi0 {
	qcom,rproc = <&q6v5_wcss>;
	qcom,tgt-mem-mode = <0>;
	memory-region = <&q6_region>, <&q6_ipq5424_data>, <&mlo_global_mem0>;
	memory-region-names = "q6-region", "host-ddr-mem", "mlo-global-mem";
	qcom,wsi = <&wsi>;
	qcom,wsi_index = <0>;
	qcom,board_id = <0x10>;
	hw_link_id = <0 0>;
	led-gpio = <&tlmm 41 GPIO_ACTIVE_HIGH>;
	probe-order = <1>;
	status = "okay";
	qcom,wsi-controller;

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			wifi0_wsi_tx: endpoint {
				remote-endpoint = <&wifi3_wsi_rx>;
			};
		};

		port@1 {
			reg = <1>;

			wifi0_wsi_rx: endpoint {
				remote-endpoint = <&wifi2_wsi_tx>;
			};
		};
	};
};

/* 5GL radio */
&wifi2 {
	hremote_node = <&qcn9224_pcie1>;
	board_id = <0x21>;
	hw_link_id = <2 0>;
