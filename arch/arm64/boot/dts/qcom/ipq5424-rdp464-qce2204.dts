/dts-v1/;

#include "ipq5424-rdp-common.dtsi"
#ifdef __IPQ_MEM_PROFILE_512_MB__
#include "ipq5424-512MB-default-memory.dtsi"
#else
#include "ipq5424-default-memory.dtsi"
#endif
#include <dt-bindings/clock/qcom,qce2204-nsscc.h>
#include <dt-bindings/clock/qcom,qce2204-pcs.h>
#include <dt-bindings/reset/qcom,qce2204-nsscc.h>

/ {
	model = "Qualcomm Technologies, Inc. IPQ5424 RDP464-QCE2204";
	compatible = "qcom,ipq5424-rdp464-qce2204", "qcom,ipq5424";

	clocks {
		qce2204_xo: qce2204-xo {
			compatible = "fixed-clock";
			clock-frequency = <50000000>;
			#clock-cells = <0>;
		};

		qce2204_uniphy1_rx_312p5m: qce2204-uniphy1-rx-312p5m {
			compatible = "fixed-clock";
			clock-frequency = <312500000>;
			#clock-cells = <0>;
		};

		qce2204_uniphy1_tx_312p5m: qce2204-uniphy1-tx-312p5m {
			compatible = "fixed-clock";
			clock-frequency = <312500000>;
			#clock-cells = <0>;
		};

		qce2204_uniphy1_ppe_250m: qce2204-uniphy1-ppe-250m {
			compatible = "fixed-clock";
			clock-frequency = <250000000>;
			#clock-cells = <0>;
		};
	};

	soc@0 {
		/delete-node/ apc-gpio-regulator;

		qupv3: geniqup@1ac0000 {

			i2c0: i2c@1a88000 {
				pinctrl-0 = <&qup_i2c0_default>;
				pinctrl-names = "default";
				status = "okay";

				exp1: gpio@74 {
					compatible = "ti,tca9539";
					reg = <0x74>;

					#gpio-cells = <2>;
					gpio-controller;

					io-exp-hog0 {
						gpio-hog;
						gpios = <0 GPIO_ACTIVE_HIGH>;
						output-low;
						line-name = "io_exp_gpio0";
					};

					io-exp-hog1 {
						gpio-hog;
						gpios = <1 GPIO_ACTIVE_HIGH>;
						output-high;
						line-name = "io_exp_gpio1";
					};

					io-exp-hog2 {
						gpio-hog;
						gpios = <2 GPIO_ACTIVE_HIGH>;
						output-low;
						line-name = "io_exp_gpio2";
					};

					io-exp-hog3 {
						gpio-hog;
						gpios = <3 GPIO_ACTIVE_HIGH>;
						output-high;
						line-name = "io_exp_gpio3";
					};

					io-exp-hog4 {
						gpio-hog;
						gpios = <4 GPIO_ACTIVE_HIGH>;
						output-high;
						line-name = "io_exp_gpio4";
					};

					io-exp-hog5 {
						gpio-hog;
						gpios = <5 GPIO_ACTIVE_HIGH>;
						output-high;
						line-name = "io_exp_gpio5";
					};

					io-exp-hog6 {
						gpio-hog;
						gpios = <6 GPIO_ACTIVE_HIGH>;
						output-high;
						line-name = "io_exp_gpio6";
					};

					io-exp-hog7 {
						gpio-hog;
						gpios = <7 GPIO_ACTIVE_HIGH>;
						output-high;
						line-name = "io_exp_gpio7";
					};

					io-exp-hog8 {
						gpio-hog;
						gpios = <8 GPIO_ACTIVE_HIGH>;
						output-high;
						line-name = "io_exp_gpio8";
					};

					io-exp-hog9 {
						gpio-hog;
						gpios = <9 GPIO_ACTIVE_HIGH>;
						output-high;
						line-name = "io_exp_gpio9";
					};

				};
			};

			i2c1: i2c@1a8c000 {
				pinctrl-0 = <&qup_i2c1_default>;
				pinctrl-names = "default";
				status = "okay";
			};

			spi0: spi@1a90000 {
				pinctrl-0 = <&qup_spi0_default>;
				pinctrl-names = "default";
				status = "okay";

				flash@0 {
					compatible = "spansion,s25fs128s1", "jedec,spi-nor";
					#address-cells = <1>;
					#size-cells = <1>;
					reg = <0>;
					spi-max-frequency = <50000000>;
				};
			};

			/delete-node/ spi@1a94000;

			i2c2: i2c@1a94000 {
				compatible = "qcom,geni-i2c";
				reg = <0x1a94000 0x4000>;
				/* i2c2 shares spi1 clock, so use spi1_clk as per gcc driver */
				clocks = <&gcc GCC_QUPV3_SPI1_CLK>;
				clock-names = "se";
				clock-frequency = <100000>;
				assigned-clocks = <&gcc GCC_QUPV3_SPI1_CLK>;
				assigned-clock-rates = <32000000>;
				interrupts = <GIC_SPI 344 IRQ_TYPE_LEVEL_HIGH>;
				pinctrl-0 = <&qup_i2c2_default>;
				pinctrl-names = "default";
				status = "okay";
			};
		};

		leds {
			compatible = "gpio-leds";
			pinctrl-0 = <&gpio_leds_default>;
			pinctrl-names = "default";

			led-0 {
				color = <LED_COLOR_ID_GREEN>;
				function = LED_FUNCTION_WLAN;
				gpios = <&tlmm 41 GPIO_ACTIVE_HIGH>;
				linux,default-trigger = "phy0tx";
				default-state = "off";
			};
		};

		mdio@90000 {
			/* Hold GPIO18 reset for Manhattan */
			/* GPIO36 is for port 1 QCA81xx PHY */
			/* GPIO37 is for huntington switch */
			phy-reset-gpio = <
				&tlmm 18 GPIO_ACTIVE_HIGH
				&tlmm 36 GPIO_ACTIVE_LOW
				&tlmm 37 GPIO_ACTIVE_LOW
			>;

			/* Delete properties from ipq5424-rdp-common.dtsi */
			/delete-property/ phyaddr_fixup;
			/delete-property/ uniphyaddr_fixup;
			/delete-property/ mdio_clk_fixup;

			/* Delete PHY nodes from ipq5424-rdp-common.dtsi */
			/delete-node/ ethernet-phy@0;
			/delete-node/ ethernet-phy@1;
			/delete-node/ ethernet-phy@2;
			/delete-node/ ethernet-phy@3;

			/* Delete switch node from ipq5424-rdp-common.dtsi */
			/delete-node/ switch0@10;

			ethernet-phy-package@0 {
				compatible = "qcom,qce1204-package";
				reg = <0x0>;
				qcom,package-mode = "internal";
				#address-cells = <1>;
				#size-cells = <0>;

				phy0: ethernet-phy@0 {
					compatible ="ethernet-phy-ieee802.3-c45";
					reg = <0x0>;
					clocks = <&qce2204_cc QCE2204_NSSCC_MAC1_GEPHY0_TX_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_MAC1_GEPHY0_RX_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_GEPHY0_SYS_CLK>;
					clock-names = "tx_clk",
						      "rx_clk",
						      "sys_clk";
					resets = <&qce2204_cc QCE2204_NSSCC_MAC1_GEPHY0_TX_ARES>,
						 <&qce2204_cc QCE2204_NSSCC_MAC1_GEPHY0_RX_ARES>,
						 <&qce2204_cc QCE2204_NSSCC_GEPHY0_SYS_ARES>;
					reset-names = "tx_reset",
						      "rx_reset",
						      "sys_reset";
				};
				phy1: ethernet-phy@1 {
					compatible ="ethernet-phy-ieee802.3-c45";
					reg = <0x1>;
					clocks = <&qce2204_cc QCE2204_NSSCC_MAC2_GEPHY1_TX_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_MAC2_GEPHY1_RX_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_GEPHY1_SYS_CLK>;
					clock-names = "tx_clk",
						      "rx_clk",
						      "sys_clk";
					resets = <&qce2204_cc QCE2204_NSSCC_MAC2_GEPHY1_TX_ARES>,
						 <&qce2204_cc QCE2204_NSSCC_MAC2_GEPHY1_RX_ARES>,
						 <&qce2204_cc QCE2204_NSSCC_GEPHY1_SYS_ARES>;
					reset-names = "tx_reset",
						      "rx_reset",
						      "sys_reset";
				};
				phy2: ethernet-phy@2 {
					compatible ="ethernet-phy-ieee802.3-c45";
					reg = <0x2>;
					clocks = <&qce2204_cc QCE2204_NSSCC_MAC3_GEPHY2_TX_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_MAC3_GEPHY2_RX_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_GEPHY2_SYS_CLK>;
					clock-names = "tx_clk",
						      "rx_clk",
						      "sys_clk";
					resets = <&qce2204_cc QCE2204_NSSCC_MAC3_GEPHY2_TX_ARES>,
						 <&qce2204_cc QCE2204_NSSCC_MAC3_GEPHY2_RX_ARES>,
						 <&qce2204_cc QCE2204_NSSCC_GEPHY2_SYS_ARES>;
					reset-names = "tx_reset",
						      "rx_reset",
						      "sys_reset";
				};
				phy3: ethernet-phy@3 {
					compatible ="ethernet-phy-ieee802.3-c45";
					reg = <0x3>;
					clocks = <&qce2204_cc QCE2204_NSSCC_MAC4_GEPHY3_TX_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_MAC4_GEPHY3_RX_CLK>,
						 <&qce2204_cc QCE2204_NSSCC_GEPHY3_SYS_CLK>;
					clock-names = "tx_clk",
						      "rx_clk",
						      "sys_clk";
					resets = <&qce2204_cc QCE2204_NSSCC_MAC4_GEPHY3_TX_ARES>,
						 <&qce2204_cc QCE2204_NSSCC_MAC4_GEPHY3_RX_ARES>,
						 <&qce2204_cc QCE2204_NSSCC_GEPHY3_SYS_ARES>;
					reset-names = "tx_reset",
						      "rx_reset",
						      "sys_reset";
				};
			};

			qce2204_pcs0: ethernet-phy@4 {
				compatible = "qcom,qce2204-pcs";
				reg = <4>;
				clocks = <&qce2204_cc QCE2204_NSSCC_SRDS0_SYS_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_MAC5_RX_SRDS0_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_MAC5_TX_SRDS0_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_MAC5_RX_SRDS0_CH0_XGMII_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_MAC5_TX_SRDS0_CH0_XGMII_CLK>;
				clock-names = "sys",
					      "rx",
					      "tx",
					      "xgmii_rx",
					      "xgmii_tx";
				resets = <&qce2204_cc QCE2204_NSSCC_SRDS0_SYS_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC5_RX_SRDS0_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC5_TX_SRDS0_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC5_RX_SRDS0_CH0_XGMII_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC5_TX_SRDS0_CH0_XGMII_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_SRDS0_XPCS_ARES>;
				reset-names = "sys",
					      "rx",
					      "tx",
					      "xgmii_rx",
					      "xgmii_tx",
					      "xpcs";
				initial_mode = "usxgmii";
				#clock-cells = <1>;
				assigned-clocks = <&qce2204_cc QCE2204_NSSCC_SRDS0_SYS_CLK>;
				assigned-clock-rates = <25000000>;
			};

			qce2204_pcs1: ethernet-phy@5 {
				compatible = "qcom,qce2204-pcs";
				reg = <5>;
				clocks = <&qce2204_cc QCE2204_NSSCC_SRDS1_SYS_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_MAC1_SRDS1_CH0_RX_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_MAC1_SRDS1_CH0_TX_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_MAC0_1_SRDS1_CH0_XGMII_RX_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_MAC0_1_SRDS1_CH0_XGMII_TX_CLK>;
				clock-names = "sys",
					      "rx",
					      "tx",
					      "xgmii_rx",
					      "xgmii_tx";
				resets = <&qce2204_cc QCE2204_NSSCC_SRDS1_SYS_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC1_SRDS1_CH0_RX_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC1_SRDS1_CH0_TX_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC0_1_SRDS1_CH0_XGMII_RX_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_MAC0_1_SRDS1_CH0_XGMII_TX_ARES>,
					 <&qce2204_cc QCE2204_NSSCC_SRDS1_XPCS_ARES>;
				reset-names = "sys",
					      "rx",
					      "tx",
					      "xgmii_rx",
					      "xgmii_tx",
					      "xpcs";
				initial_mode = "10gbase-r";
				#clock-cells = <1>;
				assigned-clocks = <&qce2204_cc QCE2204_NSSCC_SRDS1_SYS_CLK>;
				assigned-clock-rates = <25000000>;
			};

			/* Clock controller */
			qce2204_cc: clock-controller@6 {
				compatible = "qcom,qce2204-nsscc";
				reg = <6>;
				#clock-cells = <1>;
				#reset-cells = <1>;
				clocks = <&qce2204_xo>,
					 <&qce2204_pcs0 QCE2204_PCS_RX_CLK>,
					 <&qce2204_pcs0 QCE2204_PCS_TX_CLK>,
					 <&qce2204_pcs1 QCE2204_PCS_RX_CLK>,
					 <&qce2204_pcs1 QCE2204_PCS_TX_CLK>,
					 <&qce2204_uniphy1_ppe_250m>,
					 <0>,
					 <0>,
					 <0>,
					 <&qce2204_uniphy1_tx_312p5m>;
				clock-names = "xo",
					      "uniphy0_rx",
					      "uniphy0_tx",
					      "uniphy1_rx",
					      "uniphy1_tx",
					      "uniphy1_ppe_250m",
					      "uniphy0_rx_312p5m",
					      "uniphy0_tx_312p5m",
					      "uniphy1_rx_312p5m",
					      "uniphy1_tx_312p5m";
				assigned-clocks = <&qce2204_cc QCE2204_NSSCC_SRDS0_RX_MUX_SEL>,
					      <&qce2204_cc QCE2204_NSSCC_SRDS0_TX_MUX_SEL>,
					      <&qce2204_cc QCE2204_NSSCC_SRDS0_XGMII_RX_MUX_SEL>,
					      <&qce2204_cc QCE2204_NSSCC_SRDS0_XGMII_TX_MUX_SEL>;
				assigned-clock-parents = <&qce2204_cc QCE2204_NSSCC_MAC5_RX_DIV_CLK_SRC>,
					      <&qce2204_cc QCE2204_NSSCC_MAC5_TX_DIV_CLK_SRC>,
					      <&qce2204_cc QCE2204_NSSCC_MAC5_RX_DIV_CLK_SRC>,
					      <&qce2204_cc QCE2204_NSSCC_MAC5_TX_DIV_CLK_SRC>;
			};

			switch0@7 {
				compatible = "qcom,qce2204";
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0x7>;
				status = "okay";

				clocks = <&qce2204_cc QCE2204_NSSCC_AHB_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_SWITCH_CORE_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_SWITCH_IPE_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_SWITCH_BTQ_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_SWITCH_CFG_CLK>,
					 <&qce2204_cc QCE2204_NSSCC_APB_BRIDGE_CLK>;
				clock-names = "ahb",
					      "core",
					      "ipe",
					      "btq",
					      "cfg",
					      "apb";
				resets = <&qce2204_cc QCE2204_NSSCC_SWITCH_CORE_BCR>,
					<&qce2204_cc QCE2204_NSSCC_SWITCH_CORE_ARES>,
					<&qce2204_cc QCE2204_NSSCC_SWITCH_CFG_ARES>;
				reset-names = "core",
						"core_clk_reset",
						"cfg_clk_reset";

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;
						label = "cpu";
						ethernet = <&gmac2>;
						dsa-tag-protocol = "qca_8021q";
						phy-mode = "10gbase-r";
						pcsphy-handle = <&qce2204_pcs1>;
						clocks = <&qce2204_cc QCE2204_NSSCC_MAC0_TX_CLK>,
							 <&qce2204_cc QCE2204_NSSCC_MAC0_RX_CLK>;
						clock-names = "tx",
							      "rx";
						resets = <&qce2204_cc QCE2204_NSSCC_MAC0_TX_ARES>,
							 <&qce2204_cc QCE2204_NSSCC_MAC0_RX_ARES>;
						reset-names = "tx",
							      "rx";
						fixed-link {
							speed = <10000>;
							full-duplex;
							pause;
						};
					};

					port@1 {
						reg = <1>;
						label = "lan1";
						phy-handle = <&phy0>;
						phy-mode = "internal";
						clocks = <&qce2204_cc QCE2204_NSSCC_MAC1_TX_CLK>,
							 <&qce2204_cc QCE2204_NSSCC_MAC1_RX_CLK>;
						clock-names = "tx",
							      "rx";
						resets = <&qce2204_cc QCE2204_NSSCC_MAC1_TX_ARES>,
							 <&qce2204_cc QCE2204_NSSCC_MAC1_RX_ARES>;
						reset-names = "tx",
							      "rx";
					};

					port@2 {
						reg = <2>;
						label = "lan2";
						phy-handle = <&phy1>;
						phy-mode = "internal";
						clocks = <&qce2204_cc QCE2204_NSSCC_MAC2_TX_CLK>,
							 <&qce2204_cc QCE2204_NSSCC_MAC2_RX_CLK>;
						clock-names = "tx",
							      "rx";
						resets = <&qce2204_cc QCE2204_NSSCC_MAC2_TX_ARES>,
							 <&qce2204_cc QCE2204_NSSCC_MAC2_RX_ARES>;
						reset-names = "tx",
							      "rx";
					};

					port@3 {
						reg = <3>;
						label = "lan3";
						phy-handle = <&phy2>;
						phy-mode = "internal";
						clocks = <&qce2204_cc QCE2204_NSSCC_MAC3_TX_CLK>,
							 <&qce2204_cc QCE2204_NSSCC_MAC3_RX_CLK>;
						clock-names = "tx",
							      "rx";
						resets = <&qce2204_cc QCE2204_NSSCC_MAC3_TX_ARES>,
							 <&qce2204_cc QCE2204_NSSCC_MAC3_RX_ARES>;
						reset-names = "tx",
							      "rx";
					};

					port@4 {
						reg = <4>;
						label = "lan4";
						phy-handle = <&phy3>;
						phy-mode = "internal";
						clocks = <&qce2204_cc QCE2204_NSSCC_MAC4_TX_CLK>,
							 <&qce2204_cc QCE2204_NSSCC_MAC4_RX_CLK>;
						clock-names = "tx",
							      "rx";
						resets = <&qce2204_cc QCE2204_NSSCC_MAC4_TX_ARES>,
							 <&qce2204_cc QCE2204_NSSCC_MAC4_RX_ARES>;
						reset-names = "tx",
							      "rx";
					};

					port@5 {
						reg = <5>;
						label = "lan5";
						phy-handle = <&phy4>;
						pcsphy-handle = <&qce2204_pcs0>;
						phy-mode = "usxgmii";
						clocks = <&qce2204_cc QCE2204_NSSCC_MAC5_TX_CLK>,
							 <&qce2204_cc QCE2204_NSSCC_MAC5_RX_CLK>;
						clock-names = "tx",
							      "rx";
						resets = <&qce2204_cc QCE2204_NSSCC_MAC5_TX_ARES>,
							 <&qce2204_cc QCE2204_NSSCC_MAC5_RX_ARES>;
						reset-names = "tx",
							      "rx";
					};
				};
			};

			ethernet-phy@8 {
				reg = <8>;
				compatible ="ethernet-phy-ieee802.3-c45";
			};

			phy4: ethernet-phy@12 {
				reg = <12>;
				compatible ="ethernet-phy-ieee802.3-c45";
			};
		};

		ess-instance {
			num_devices = <0x2>;
#ifdef __CONFIG_IO_COHERENCY__
			dma-coherent;
#endif
			ess-switch@3a000000 {
#ifdef __CONFIG_IO_COHERENCY__
				dma-coherent;
#endif
				switch_cpu_bmp = <0x1>;  /* cpu port bitmap */
				switch_lan_bmp = <0x4>; /* lan port bitmap */
				switch_wan_bmp = <0x2>; /* wan port bitmap */
				switch_mac_mode = <0xd>; /* mac mode for uniphy instance0*/
				switch_mac_mode1 = <0xe>; /* mac mode for uniphy instance1*/
				switch_mac_mode2 = <0xff>; /* mac mode for uniphy instance2*/
				tm_tick_mode = <1>; /* marina 3X10G mode */

				qcom,port_phyinfo {
					port@0 {
						port_id = <1>;
						phy_address = <8>;
						ethernet-phy-ieee802.3-c45;
					};
					port@1 {
						port_id = <2>;
						forced-speed = <10000>;
						forced-duplex = <1>;
						switch_external {
							switch_handle = <&switch1>;
							switch_cpu_port = <0>;
						};
						fixed-link {
							speed = <10000>;
							full-duplex;
							pause;
						};
					};
					/delete-node/ port@2;
				};
			};

			ess-switch1@1 {
#ifdef __CONFIG_IO_COHERENCY__
				dma-coherent;
#endif
				compatible = "qcom,ess-switch-qce22xx";
				reg = <0x7>;
				switch_lan_bmp = <0x3e>;
				switch_mac_mode = <0xe>;
				/delete-node/ qcom,port_ledinfo;

				qcom,port_phyinfo {
					port@0 {
						forced-speed = <10000>;
					};
					port@1 {
						phy_address = <0>;
						ethernet-phy-ieee802.3-c45;
					};
					port@2 {
						phy_address = <1>;
						ethernet-phy-ieee802.3-c45;
					};
					port@3 {
						phy_address = <2>;
						ethernet-phy-ieee802.3-c45;
					};
					port@4 {
						phy_address = <3>;
						ethernet-phy-ieee802.3-c45;
					};
					port@5 {
						port_id = <5>;
						phy_address = <12>;
						ethernet-phy-ieee802.3-c45;
					};
				};
			};
		};

		dp1 {
			device_type = "network";
			compatible = "qcom,nss-dp";
#ifdef __CONFIG_IO_COHERENCY__
			dma-coherent;
#endif
			qcom,id = <1>;
			reg = <0x3A500000 0x4000>;
			qcom,mactype = <1>;
			local-mac-address = [000000000000];
			qcom,phy-mdio-addr = <8>;
			qcom,link-poll = <1>;
			phy-mode = "usxgmii";
		};

		gmac2:dp2 {
			device_type = "network";
			compatible = "qcom,nss-dp";
#ifdef __CONFIG_IO_COHERENCY__
			dma-coherent;
#endif
			qcom,id = <2>;
			reg = <0x3A504000 0x4000>;
			qcom,mactype = <1>;
			local-mac-address = [000000000000];
			qcom,mht-dev = <1>;
			qcom,is_switch_connected = <1>;
			phy-mode = "sgmii";
			qcom,ppe-offload-disabled = <1>;
		};

		/* EDMA host driver configuration for the board */
		edma@3ab00000 {
#ifdef __CONFIG_IO_COHERENCY__
			dma-coherent;
#endif
			qcom,txdesc-ring-start = <4>;		/* Tx desc ring start ID */
			qcom,txdesc-rings = <16>;		/* Total number of Tx desc rings to be provisioned */
			qcom,mht-txdesc-rings = <12>;		/* Extra Tx desc rings to be provisioned for MHT SW ports */
			qcom,txcmpl-ring-start = <4>;		/* Tx complete ring start ID */
			qcom,txcmpl-rings = <16>;		/* Total number of Tx complete rings to be provisioned */
			qcom,mht-txcmpl-rings = <12>;		/* Extra Tx complete rings to be provisioned for mht sw ports. */
			qcom,rxfill-ring-start = <4>;		/* Rx fill ring start ID */
			qcom,rxfill-rings = <4>;		/* Total number of Rx fill rings to be provisioned */
			qcom,rxdesc-ring-start = <20>;		/* Rx desc ring start ID */
			qcom,rxdesc-rings = <4>;		/* Total number of Rx desc rings to be provisioned */
			qcom,rx-page-mode = <0>;		/* Rx fill ring page mode */
			qcom,tx-map-priority-level = <1>;	/* Tx priority level per port */
			qcom,rx-map-priority-level = <1>;	/* Rx priority level per core */
			qcom,ppeds-num = <4>;			/* Number of PPEDS nodes */
			/* PPE-DS node format: <Rx-fill Tx-cmpl Rx Tx Queue-base Queue-count> */
			qcom,ppeds-map = <1 1 1 1 32 8>,	/* PPEDS Node #0 ring and queue map */
					<2 2 2 2 40 8>,		/* PPEDS Node #1 ring and queue map */
					<3 3 3 3 48 8>,		/* PPEDS Node #2 ring and queue map */
					<0 0 0 0 56 8>;		/* PPEDS Node #3 ring and queue map */
			qcom,txdesc-map = <4 5 6 7>,		/* Port1 per-core Tx ring map */
					<8 9 10 11>,		/* Port2 per-core Tx ring map */
					<12 13 14 15>,		/* MHT-Port1 per-core Tx ring map */
					<16 17 18 19>,		/* MHT-Port2 per-core Tx ring map */
					<20 21 22 23>,		/* MHT-Port3 per-core Tx ring map */
					<24 25 26 27>,		/* MHT-Port4 per-core Tx ring map */
					<28 29 30 31>;		/* Used only for packets from VP */
			qcom,txdesc-fc-grp-map = <1 2 3 4 5 6>;	/* Per GMAC flow control group map */
			qcom,rxfill-map = <4 5 6 7>;		/* Per-core Rx fill ring map */
			qcom,rxdesc-map = <20 21 22 23>;	/* Per-core Rx desc ring map */
			qcom,rx-queue-start = <0>;		/* Rx queue start */
			qcom,rx-ring-queue-map = <0 8 16 24>,	/* Priority 0 queues per-core Rx ring map */
						<1 9 17 25>,	/* Priority 1 queues per-core Rx ring map */
						<2 10 18 26>,	/* Priority 2 queues per-core Rx ring map */
						<3 11 19 27>,	/* Priority 3 queues per-core Rx ring map */
						<4 12 20 28>,	/* Priority 4 queues per-core Rx ring map */
						<5 13 21 29>,	/* Priority 5 queues per-core Rx ring map */
						<6 14 22 30>,	/* Priority 6 queues per-core Rx ring map */
						<7 15 23 31>;	/* Priority 7 queues per-core Rx ring map */
			interrupts = <0 286 4>,			/* Tx complete ring id #4 IRQ info */
					<0 287 4>,		/* Tx complete ring id #5 IRQ info */
					<0 288 4>,		/* Tx complete ring id #6 IRQ info */
					<0 289 4>,		/* Tx complete ring id #7 IRQ info */
					<0 290 4>,		/* Tx complete ring id #8 IRQ info */
					<0 291 4>,		/* Tx complete ring id #9 IRQ info */
					<0 292 4>,		/* Tx complete ring id #10 IRQ info */
					<0 293 4>,		/* Tx complete ring id #11 IRQ info */
					<0 294 4>,		/* Tx complete ring id #12 IRQ info */
					<0 295 4>,		/* Tx complete ring id #13 IRQ info */
					<0 296 4>,		/* Tx complete ring id #14 IRQ info */
					<0 297 4>,		/* Tx complete ring id #15 IRQ info */
					<0 298 4>,		/* Tx complete ring id #16 IRQ info */
					<0 299 4>,		/* Tx complete ring id #17 IRQ info */
					<0 300 4>,		/* Tx complete ring id #18 IRQ info */
					<0 301 4>,		/* Tx complete ring id #19 IRQ info */
					<0 270 4>,		/* Rx desc ring id #20 IRQ info */
					<0 271 4>,		/* Rx desc ring id #21 IRQ info */
					<0 272 4>,		/* Rx desc ring id #22 IRQ info */
					<0 273 4>,		/* Rx desc ring id #23 IRQ info */
					<0 314 4>,		/* Misc error IRQ info */
					<0 278 4>,		/* RxFill ring id #4 IRQ info */
					<0 279 4>,		/* RxFill ring id #5 IRQ info */
					<0 280 4>,		/* RxFill ring id #6 IRQ info */
					<0 281 4>,		/* RxFill ring id #7 IRQ info */
					<0 283 4>,		/* PPEDS Node #0(TxComp ring id #1) TxComplete IRQ info */
					<0 251 4>,		/* PPEDS Node #0(Rx Desc ring id #1) Rx Desc IRQ info */
					<0 275 4>,		/* PPEDS Node #0(RxFill Desc ring id #1) Rx Fill IRQ info */
					<0 284 4>,		/* PPEDS Node #1(TxComp ring id #2) TxComplete IRQ info */
					<0 252 4>,		/* PPEDS Node #1(Rx Desc ring id #2) Rx Desc IRQ info */
					<0 276 4>,		/* PPEDS Node #1(RxFill Desc ring id #2) Rx Fill IRQ info */
					<0 285 4>,		/* PPEDS Node #2(TxComp ring id #3) TxComplete IRQ info */
					<0 253 4>,		/* PPEDS Node #2(Rx Desc ring id #3) Rx Desc IRQ info */
					<0 277 4>,		/* PPEDS Node #2(RxFill Desc ring id #3) Rx Fill IRQ info */
					<0 282 4>,		/* PPEDS Node #3(TxComp ring id #0) TxComplete IRQ info */
					<0 250 4>,		/* PPEDS Node #3(Rx Desc ring id #0) Rx Desc IRQ info */
					<0 274 4>,		/* PPEDS Node #3(RxFill Desc ring id #0) Rx Fill IRQ info */
					<0 302 4>,		/* MHT port Tx complete ring id #20 IRQ info */
					<0 303 4>,		/* MHT port Tx complete ring id #21 IRQ info */
					<0 304 4>,		/* MHT port Tx complete ring id #22 IRQ info */
					<0 305 4>,		/* MHT port Tx complete ring id #23 IRQ info */
					<0 306 4>,		/* MHT port Tx complete ring id #24 IRQ info */
					<0 307 4>,		/* MHT port Tx complete ring id #25 IRQ info */
					<0 308 4>,		/* MHT port Tx complete ring id #26 IRQ info */
					<0 309 4>,		/* MHT port Tx complete ring id #27 IRQ info */
					<0 310 4>,		/* MHT port Tx complete ring id #28 IRQ info */
					<0 311 4>,		/* MHT port Tx complete ring id #29 IRQ info */
					<0 312 4>,		/* MHT port Tx complete ring id #30 IRQ info */
					<0 313 4>;		/* MHT port Tx complete ring id #31 IRQ info */
		};

		wsi: wsi {
			id = <0>;
			num_chip = <4>;
			chip_info = <0 2 1 3>,
				    <1 2 0 2>,
				    <2 2 3 1>,
				    <3 2 2 0>;
			status = "okay";
		};
	};
};

&CPU0 {
	/delete-property/ cpu-supply;
};

&CPU1 {
	/delete-property/ cpu-supply;
};

&CPU2 {
	/delete-property/ cpu-supply;
};

&CPU3 {
	/delete-property/ cpu-supply;
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	status = "okay";
};

&sdhc {
	max-frequency = <192000000>;
	bus-width = <4>;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	non-removable;
	pinctrl-0 = <&sdc_default_state>;
	pinctrl-names = "default";
	status = "disabled";
};

&pcie0 {
	perst-gpio = <&tlmm 25 GPIO_ACTIVE_LOW>;

	pcie0_rp {
		reg = <0 0 0 0 0>;
	};
};

&pcie1_phy {
	status = "okay";
};

&pcie1 {
	status = "okay";
	perst-gpio = <&tlmm 28 GPIO_ACTIVE_LOW>;

	pcie1_rp {
		reg = <0 0 0 0 0>;

		qcom,mhi@1 {
			reg = <0 0 0 0 0>;
			boot-args = <0x2 0x4 0x34 0x3 0x0 0x0     /* MX Rail, GPIO52, Drive strength 0x3 */
					0x4 0x4 0x18 0x3 0x0 0x0  /* RFA1p2 Rail, GPIO24, Drive strength 0x3 */
					0x6 0x4 0x30 0x7 0x0 0x0  /* WSI0, GPIO48, Drive strength 16mA */
					0x7 0x4 0x31 0x7 0x0 0x0  /* WSI1, GPIO49, Drive strength 16mA */
					0x0 0x4 0x0 0x0 0x0 0x0>; /* End of arguments */
			memory-region = <&qcn9224_pcie1>, <&mhi_region1>, <&mlo_global_mem0>;
			memory-region-names = "host-ddr-mem", "mhi-region", "mlo-global-mem";
			qcom,board_id = <0x21>;
			qcom,wsi = <&wsi>;
			qcom,wsi_index = <2>;
			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					wifi1_wsi_tx: endpoint {
						remote-endpoint = <&wifi2_wsi_rx>;
					};
				};

				port@1 {
					reg = <1>;

					wifi1_wsi_rx: endpoint {
						remote-endpoint = <&wifi3_wsi_tx>;
					};
				};
			};
		};
	};
};

&pcie2_phy {
	status = "okay";
};

&pcie2 {
	status = "okay";
	perst-gpio = <&tlmm 31 GPIO_ACTIVE_LOW>;

	pcie2_rp {
		reg = <0 0 0 0 0>;

		qcom,mhi@2 {
			reg = <0 0 0 0 0>;
			boot-args = <0x2 0x4 0x34 0x3 0x0 0x0     /* MX Rail, GPIO52, Drive strength 0x3 */
					0x4 0x4 0x18 0x3 0x0 0x0  /* RFA1p2 Rail, GPIO24, Drive strength 0x3 */
					0x6 0x4 0x30 0x7 0x0 0x0  /* WSI0, GPIO48, Drive strength 16mA */
					0x7 0x4 0x31 0x7 0x0 0x0  /* WSI1, GPIO49, Drive strength 16mA */
					0x0 0x4 0x0 0x0 0x0 0x0>; /* End of arguments */
			memory-region = <&qcn9224_pcie2>, <&mhi_region2>, <&mlo_global_mem0>;
			memory-region-names = "host-ddr-mem", "mhi-region", "mlo-global-mem";
			qcom,board_id = <0x26>;
			qcom,wsi = <&wsi>;
			qcom,wsi_index = <3>;
			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					wifi2_wsi_tx: endpoint {
						remote-endpoint = <&wifi0_wsi_rx>;
					};
				};

				port@1 {
					reg = <1>;

					wifi2_wsi_rx: endpoint {
						remote-endpoint = <&wifi1_wsi_tx>;
					};
				};
			};
		};
	};
};

&pcie3_phy {
	status = "okay";
};

&pcie3 {
	status = "okay";
	perst-gpio = <&tlmm 34 GPIO_ACTIVE_LOW>;

	pcie3_rp {
		reg = <0 0 0 0 0>;

		qcom,mhi@3 {
			reg = <0 0 0 0 0>;
			boot-args = <0x2 0x4 0x34 0x3 0x0 0x0     /* MX Rail, GPIO52, Drive strength 0x3 */
					0x4 0x4 0x18 0x3 0x0 0x0  /* RFA1p2 Rail, GPIO24, Drive strength 0x3 */
					0x6 0x4 0x30 0x7 0x0 0x0  /* WSI0, GPIO48, Drive strength 16mA */
					0x7 0x4 0x31 0x7 0x0 0x0  /* WSI1, GPIO49, Drive strength 16mA */
					0x0 0x4 0x0 0x0 0x0 0x0>; /* End of arguments */
			memory-region = <&qcn9224_pcie3>, <&mhi_region3>, <&mlo_global_mem0>;
			memory-region-names = "host-ddr-mem", "mhi-region", "mlo-global-mem";
			qcom,board_id = <0x22>;
			qcom,wsi = <&wsi>;
			qcom,wsi_index = <1>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					wifi3_wsi_tx: endpoint {
						remote-endpoint = <&wifi1_wsi_rx>;
					};
				};

				port@1 {
					reg = <1>;

					wifi3_wsi_rx: endpoint {
						remote-endpoint = <&wifi0_wsi_tx>;
					};
				};
			};
		};
	};
};

