	aggr-noc-config = <0x00610908 0x80>, /* aggr_noc_pcie1 */
			  <0x00610a08 0x80>, /* aggr_noc_pcie2 */
			  <0x00610b08 0x80>; /* aggr_noc_pcie3 */
};

