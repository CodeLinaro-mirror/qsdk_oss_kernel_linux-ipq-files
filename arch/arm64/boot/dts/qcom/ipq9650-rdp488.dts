/dts-v1/;

#include "ipq9650-rdp-common.dtsi"
#ifdef __IPQ_MEM_PROFILE_512_MB__
#include "ipq9650-512MB-default-memory.dtsi"
#else
#include "ipq9650-default-memory.dtsi"
#endif

/ {
	model = "Qualcomm Technologies, Inc. IPQ9650 RDP488";
	compatible = "qcom,ipq9650-rdp488", "qcom,ipq9650";

	aliases {
		ethernet0 = "/soc/dp1";
		ethernet1 = "/soc/dp2";
		ethernet2 = "/soc/dp3";
		ethernet3 = "/soc/dp4";
		ethernet4 = "/soc/dp5";
		ethernet5 = "/soc/dp6";
	};

	soc@0 {
		qupv3: geniqup@1ac0000 {
			status = "okay";

			spi0: spi@1a80000 {
				pinctrl-0 = <&qup_spi0_default>;
				pinctrl-names = "default";
				status = "okay";

				flash@0 {
					compatible = "spansion,s25fs128s1", "jedec,spi-nor";
					#address-cells = <1>;
					#size-cells = <1>;
					reg = <0>;
					spi-max-frequency = <50000000>;
				};
			};

			i2c0: i2c@1a84000 {
				pinctrl-0 = <&qup_i2c0_default>;
				pinctrl-names = "default";
				status = "disabled";
			};

			i2c2: i2c@1a8c000 {
				pinctrl-0 = <&qup_i2c2_default>;
				pinctrl-names = "default";
				status = "okay";

				pmic@68 {
					compatible = "mps,mp8899";
					reg = <0x68>;

					regulators {
						/* APC_CX */
						ipq9650_s1: buck1 {
							regulator-name = "buck1";
							regulator-min-microvolt = <735000>;
							regulator-max-microvolt = <960000>;
							regulator-always-on;
							regulator-boot-on;
						};

						/* NSP_CX */
						ipq9650_s2: buck2 {
							regulator-name = "buck2";
							regulator-min-microvolt = <735000>;
							regulator-max-microvolt = <960000>;
						};

						/* NSP_MX */
						ipq9650_s4: buck4 {
							regulator-name = "buck4";
							regulator-min-microvolt = <735000>;
							regulator-max-microvolt = <960000>;
						};
					};
				};
			};
		};

		dp1 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <1>;
			reg = <0x2a500000 0x4000>;
			qcom,mactype = <1>;
			local-mac-address = [000000000000];
			qcom,ppe-offload-disabled = <0>;
			pinctrl-0 = <&pps_state>;
			pinctrl-names = "default";
			interrupts = <GIC_SPI 362 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "pps_in";
			clocks = <&nsscc NSS_CC_XGMAC0_PTP_REF_CLK>;
			clock-names = "ptp";
		};

		dp2 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <2>;
			reg = <0x2a504000 0x4000>;
			qcom,mactype = <1>;
			local-mac-address = [000000000000];
			qcom,ppe-offload-disabled = <0>;
			clocks = <&nsscc NSS_CC_XGMAC1_PTP_REF_CLK>;
			clock-names = "ptp";
		};

		dp3 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <3>;
			reg = <0x2a508000 0x4000>;
			qcom,mactype = <1>;
			local-mac-address = [000000000000];
			qcom,ppe-offload-disabled = <0>;
			clocks = <&nsscc NSS_CC_XGMAC2_PTP_REF_CLK>;
			clock-names = "ptp";
		};

		dp4 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <4>;
			reg = <0x2a50c000 0x4000>;
			qcom,mactype = <1>;
			local-mac-address = [000000000000];
			qcom,ppe-offload-disabled = <0>;
			clocks = <&nsscc NSS_CC_XGMAC3_PTP_REF_CLK>;
			clock-names = "ptp";
		};

		dp5 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <5>;
			reg = <0x2a510000 0x4000>;
			qcom,mactype = <1>;
			local-mac-address = [000000000000];
			qcom,ppe-offload-disabled = <0>;
			clocks = <&nsscc NSS_CC_XGMAC4_PTP_REF_CLK>;
			clock-names = "ptp";
		};

		dp6 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <6>;
			reg = <0x2a514000 0x4000>;
			qcom,mactype = <1>;
			local-mac-address = [000000000000];
			qcom,ppe-offload-disabled = <0>;
			clocks = <&nsscc NSS_CC_XGMAC5_PTP_REF_CLK>;
			clock-names = "ptp";
		};
	};
};

&mdio {
	phy-reset-gpio = <&tlmm 18 GPIO_ACTIVE_LOW>, /* Reset for QCE1204. */
			 <&tlmm 14 GPIO_ACTIVE_LOW>; /* Reset for two QCA81XXs. */

	phy4: ethernet-phy@8 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <8>;
	};

	phy5: ethernet-phy@c {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <12>;
	};
};

&ess_switch {
	switch_mac_mode1 = <0xd>; /* mac mode for uniphy instance1 */
	switch_mac_mode2 = <0xd>; /* mac mode for uniphy instance2 */

	qcom,port_phyinfo {
		port@4 {
			port_id = <5>;
			phy_address = <8>;
			phy-handle = <&phy4>;
			phy-mode = "usxgmii";
			ethernet-phy-ieee802.3-c45;
		};

		port@5 {
			port_id = <6>;
			phy_address = <12>;
			phy-handle = <&phy5>;
			phy-mode = "usxgmii";
			ethernet-phy-ieee802.3-c45;
		};
	};
};

&spi1 {
	compatible = "qcom,geni-spi";
	pinctrl-0 = <&se5_spi_pins>;
	pinctrl-names = "default";
	status = "disabled";

	spidev1: spi@0 {
		compatible = "qti,spidev";
		reg = <0>;
		spi-max-frequency = <9600000>;
	};
};

&pcm {
	pinctrl-0 = <&audio_pins_pri>;
	pinctrl-names = "primary";
	status = "disabled";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	status = "okay";
};

&sdhc {
	max-frequency = <192000000>;
	bus-width = <4>;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	non-removable;
	pinctrl-0 = <&sdc_default_state>;
	pinctrl-names = "default";
	status = "disabled";
};

&pcie1_phy {
	status = "okay";
};

&pcie1 {
	perst-gpio = <&tlmm 28 GPIO_ACTIVE_LOW>;
	status = "okay";

	pcie1_rp {
		reg = <0 0 0 0 0>;

		qcom,mhi@0 {
			reg = <0 0 0 0 0>;
			memory-region = <&qcn9625_pcie1>, <&mlo_global_mem0>;
			memory-region-names = "host-ddr-mem", "mlo-global-mem";
			qcom,board_id = <0x2002>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					wifi1_wsi_tx: endpoint {
						remote-endpoint = <&wifi3_wsi_rx>;
					};
				};

				port@1 {
					reg = <1>;

					wifi1_wsi_rx: endpoint {
						remote-endpoint = <&wifi2_wsi_tx>;
					};
				};
			};
		};
	};
};

&pcie2_phy {
	status = "okay";
};

&pcie2 {
	perst-gpio = <&tlmm 52 GPIO_ACTIVE_LOW>;
	status = "okay";

	pcie2_rp {
		reg = <0 0 0 0 0>;

		qcom,mhi@0 {
			reg = <0 0 0 0 0>;
			memory-region = <&qcn9625_pcie2>, <&mlo_global_mem0>;
			memory-region-names = "host-ddr-mem", "mlo-global-mem";
			qcom,board_id = <0x2001>;
			qcom,wsi-controller;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					wifi2_wsi_tx: endpoint {
						remote-endpoint = <&wifi1_wsi_rx>;
					};
				};

				port@1 {
					reg = <1>;

					wifi2_wsi_rx: endpoint {
						remote-endpoint = <&wifi3_wsi_tx>;
					};
				};
			};
		};
	};
};

&pcie3_phy {
	status = "okay";
};

&pcie3 {
	perst-gpio = <&tlmm 41 GPIO_ACTIVE_LOW>;
	status = "okay";

	pcie3_rp {
		reg = <0 0 0 0 0>;

		qcom,mhi@0 {
			reg = <0 0 0 0 0>;
			memory-region = <&qcn9625_pcie3>, <&mlo_global_mem0>;
			memory-region-names = "host-ddr-mem", "mlo-global-mem";
			qcom,board_id = <0x2004>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					wifi3_wsi_tx: endpoint {
						remote-endpoint = <&wifi2_wsi_rx>;
					};
				};

				port@1 {
					reg = <1>;

					wifi3_wsi_rx: endpoint {
						remote-endpoint = <&wifi1_wsi_tx>;
					};
				};
			};
		};
	};
};

&qcn9625_pcie1 {
	status = "okay";
};

&qcn9625_pcie2 {
	status = "okay";
};

&qcn9625_pcie3 {
	status = "okay";
};

&mlo_global_mem0 {
	status = "okay";
};

&qusb_phy_1 {
	status = "okay";
};

&usb2 {
	status = "okay";
};

&qusb_phy_0 {
	status = "okay";
};

&ssphy_0 {
	status = "okay";
};

&usb3 {
	status = "okay";
};

&tlmm {
	audio_pins_pri: audio_pinmux_pri {
		mux_1 {
			pins = "gpio36";
			function = "audio_pri_d0";
			drive-strength = <16>;
			bias-pull-down;
		};

		mux_2 {
		    pins = "gpio37";
		    function = "audio_pri_d1";
		    drive-strength = <8>;
		    bias-pull-down;
		};

		mux_3 {
		    pins = "gpio38";
		    function = "audio_pri_fsync";
		    drive-strength = <8>;
		    bias-pull-down;
		};

		mux_4 {
		    pins = "gpio39";
		    function = "audio_pri_pclk";
		    drive-strength = <8>;
		    bias-pull-down;
		};
	};

	qup_i2c0_default: qup-i2c0-default-state {
		qup_i2c0_scl {
			pins = "gpio10";
			function = "qup_se1_l1";
			drive-strength = <8>;
			bias-pull-down;
		};
		qup_i2c0_sda {
			pins = "gpio11";
			function = "qup_se1_l0";
			drive-strength = <8>;
			bias-pull-down;
		};
	};

	pcie0_default_state: pcie0-default-state {
		perst-n-pins {
			pins = "gpio25";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
			output-low;
		};
	};

	pcie1_default_state: pcie1-default-state {
		perst-n-pins {
			pins = "gpio28";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
			output-low;
		};
	};

	pcie2_default_state: pcie2-default-state {
		perst-n-pins {
			pins = "gpio52";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
			output-low;
		};
	};

	pcie3_default_state: pcie3-default-state {
		perst-n-pins {
			pins = "gpio41";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
			output-low;
		};
	};

	pcie4_default_state: pcie4-default-state {
		perst-n-pins {
			pins = "gpio31";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
			output-low;
		};
	};

	sdc_default_state: sdc-default-state {
		clk-pins {
			pins = "gpio5";
			function = "sdc_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cmd-pins {
			pins = "gpio4";
			function = "sdc_cmd";
			drive-strength = <8>;
			bias-pull-up;
		};

		data-pins {
			pins = "gpio0", "gpio1", "gpio2", "gpio3";
			function = "sdc_data";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	se5_spi_pins: se5-spi-pins {
		spi_clk {
			pins = "gpio45";
			function = "qup_se5_l2";
			drive-strength = <4>;
			bias-pull-down;
		};
		spi_cs {
			pins = "gpio46";
			function = "qup_se5_l3";
			drive-strength = <4>;
			bias-pull-up;
		};
		spi_miso {
			pins = "gpio47";
			function = "qup_se5_l0";
			drive-strength = <16>;
			bias-pull-down;
		};
		spi_mosi {
			pins = "gpio48";
			function = "qup_se5_l1";
			drive-strength = <16>;
			bias-pull-down;
		};
	};
};

&CPU0 {
	cpu-supply = <&ipq9650_s1>;
};

&CPU1 {
	cpu-supply = <&ipq9650_s1>;
};

&CPU2 {
	cpu-supply = <&ipq9650_s1>;
};

&CPU3 {
	cpu-supply = <&ipq9650_s1>;
};

&CPU4 {
	cpu-supply = <&ipq9650_s1>;
};

&cdsp_power {
	vdd-cx-supply = <&ipq9650_s2>;
	vdd-mx-supply = <&ipq9650_s4>;
};

&remoteproc_cdsp {
	cx-supply = <&cdsp_vdd_cx>;
	mx-supply = <&cdsp_vdd_mx>;
};
