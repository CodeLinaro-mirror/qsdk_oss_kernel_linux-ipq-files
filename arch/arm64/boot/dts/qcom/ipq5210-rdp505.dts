/dts-v1/;

#include "ipq5210-rdp-common.dtsi"
#ifdef __IPQ_MEM_PROFILE_512_MB__
#include "ipq5210-512MB-default-memory.dtsi"
#else
#include "ipq5210-default-memory.dtsi"
#endif

/ {
	model = "Qualcomm Technologies, Inc. IPQ5210 RDP505";
	compatible = "qcom,ipq5210-rdp505", "qcom,ipq5210";

	aliases {
		serial0 = &uart1;
		ethernet0 = "/soc/dp1";
		ethernet1 = "/soc/dp2";
	};

	soc@0 {
		mdio@90000 {
			status = "okay";
			/* gpio reset for QCA8033 PHY */
			phy-reset-gpio = <&tlmm 24 GPIO_ACTIVE_LOW>;

			phy0: ethernet-phy@4 {
				reg = <4>;
			};
		};

		mdio_ahb: mdio-ahb@1400000 {
			status = "okay";
			compatible = "qcom,mdio-ahb-ipq52xx";
			reg = <0x1400000 0x200000>;  /* Base address: 0x1400000, Size: 2MB */
			clocks = <&gcc GCC_MDIO_GEPHY_AHB_CLK>,
				<&gcc GCC_GEPHY_SYS_CLK>,
				<&nsscc NSS_CC_EPHY_RX_CLK>,
				<&nsscc NSS_CC_EPHY_TX_CLK>,
				<&cmn_pll IPQ5210_EPHY_RAW_CLK>;
			clock-names = "mdio_gephy_ahb_clk",
				"gephy_sys_clk",
				"gephy_rx_clk",
				"gephy_tx_clk",
				"gephy_raw_clk";

			resets = <&gcc GCC_GEPHY_SYS_ARES>,
				 <&nsscc NSS_CC_EPHY_RX_CLK_ARES>,
				 <&nsscc NSS_CC_EPHY_TX_CLK_ARES>;
			reset-names = "gephy_sys_reset",
				 "gephy_rx_reset",
				 "gephy_tx_reset";
		};

		ess-instance {
			num_devices = <0x1>;

			ess_switch: ess-switch@3a000000 {
				switch_lan_bmp = <0x10>; /* lan port bitmap */
				switch_wan_bmp = <0x20>; /* wan port bitmap */
				switch_mac_mode = <0xff>; /* unused */
				switch_mac_mode1 = <0xf>; /* SGMII for QCA8033 */
				switch_mac_mode2 = <0xff>; /* unused */

				qcom,port_phyinfo {
					port@3 {
						port_id = <4>;
						phy-mode = "internal";
					};
					port@4 {
						port_id = <5>;
						phy_address = <4>;
						phy-handle = <&phy0>;
						phy-mode = "sgmii";
					};
				};
			};
		};

		dp1 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <4>;
			reg = <0x3a001600 0x200>;
			qcom,mactype = <0>;
			local-mac-address = [000000000000];
			qcom,ppe-offload-disabled = <0>;
		};

		dp2 {
			device_type = "network";
			compatible = "qcom,nss-dp";
			qcom,id = <5>;
			reg = <0x3A001800 0x200>;
			qcom,mactype = <0>;
			local-mac-address = [000000000000];
			qcom,ppe-offload-disabled = <0>;
		};
	};
};

&tlmm {
	pcie1_default_state: pcie1-default-state {
		pins = "gpio29";
		function = "gpio";
		drive-strength = <6>;
		bias-pull-down;
		output-low;
	};

	qup_uart1_default: qup-uart1-default-state {
		qup_uart1_tx {
			pins = "gpio39";
			function = "qup_se1_l2";
			drive-strength = <6>;
			bias-pull-down;
		};

		qup_uart1_rx {
			pins = "gpio38";
			function = "qup_se1_l3";
			drive-strength = <6>;
			bias-pull-down;
		};
	};
};

&pcie1_phy {
	status = "okay";
};

&pcie1 {
	pinctrl-0 = <&pcie1_default_state>;
	perst-gpio = <&tlmm 29 GPIO_ACTIVE_LOW>;
	status = "okay";

	pcie1_rp {
		reg = <0 0 0 0 0>;
	};
};

&qusb_phy_0 {
	status = "disabled";
};

&ssphy_0 {
	status = "disabled";
};

&usb3 {
	status = "disabled";
};

&i2c0 {
	status = "disabled";
};


&ess_switch {
	port_scheduler_resource {
		/delete-node/ port@6;
		/delete-node/ port@5;
		port@5 {
			port_id = <5>;
			ucast_queue = <32 63>;
			mcast_queue = <288 291>;
			l0sp = <8 15>;
			l0cdrr = <32 63>;
			l0edrr = <32 63>;
			l1cdrr = <8 15>;
			l1edrr = <8 15>;
		};
	};

	port_scheduler_config {
		/delete-node/ port@6;
		/delete-node/ port@5;
		port@5 {
			port_id = <5>;
			l1scheduler {
				group@0 {
					sp = <8>;
					sp_loop_pri = <8>;
					sp_max_pri = <1>;
					/* cpri cdrr epri edrr */
					cfg = <0 8 0 8>;
				};
			};
			l0scheduler {
				group@0 {
					ucast_queue = <32>;
					ucast_loop_pri = <8>;
					mcast_queue = <288>;
					mcast_loop_pri = <4>;
					cfg = <8 0 32 0 32>;
				};
				group@1 {
					ucast_queue = <40>;
					ucast_loop_pri = <8>;
					cfg = <10 0 40 0 40>;
				};
				group@2 {
					ucast_queue = <48>;
					ucast_loop_pri = <8>;
					cfg = <12 0 48 0 48>;
				};
				group@3 {
					ucast_queue = <56>;
					ucast_loop_pri = <8>;
					cfg = <14 0 56 0 56>;
				};
			};
		};
	};
};
